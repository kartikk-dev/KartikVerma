
---
const socials = [
  {
    name: "Instagram",
    detail: "@kartikcloud",
    href: "https://www.instagram.com/kartikcloud/",
    kind: "instagram",
    status: "Connect",
  },
  {
    name: "GitHub",
    detail: "kartikk-dev",
    href: "https://github.com/kartikk-dev",
    kind: "github",
    status: "Explore",
  },
  {
    name: "WhatsApp",
    detail: "Message me directly",
    href: "https://wa.me/917500018011",
    kind: "whatsapp",
    status: "Message",
  },
  {
    name: "Twitter / X",
    detail: "Vlogging and creator content in progress",
    href: null,
    kind: "twitter",
    status: "Coming soon",
  },
];
---

<section
  id="contact"
  class="contact-section"
  aria-labelledby="contact-heading"
>
  <div class="contact-atmosphere" aria-hidden="true"></div>

  <div class="contact-container">
    <header class="contact-header">
      <h2 id="contact-heading" class="contact-title">
        <span data-contact-heading-white></span><span
          class="contact-title-accent"
          data-contact-heading-accent
        ></span><span
          class="contact-type-cursor"
          data-contact-cursor
          aria-hidden="true"
        ></span>
      </h2>

      <h3 class="contact-subheading">
        Have a project to discuss?
      </h3>

      <p class="contact-intro">
        Have a project to discuss, an idea to explore, or an interesting
        opportunity? Reach out and tell me what you're working on.
      </p>
    </header>

    <div class="contact-layout">
      <div class="contact-information">
        <div class="contact-actions">
          <a
            class="contact-button contact-button-primary"
            href="mailto:hello.kartikv@gmail.com"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="3.5"
                y="5.5"
                width="17"
                height="13"
                rx="2"
                stroke="currentColor"
                stroke-width="1.7"
              />
              <path
                d="m4.5 7 7.5 5.5L19.5 7"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>Connect with me via mail</span>
          </a>

          <a
            class="contact-button contact-button-secondary"
            href="https://wa.me/917500018011"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M20 11.7a8.1 8.1 0 0 1-11.8 7.2L4 20l1.2-4A8.1 8.1 0 1 1 20 11.7Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <path
                d="M8.5 8.4c.3-.6.6-.6.9-.6h.3c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.4 0 .6.6 1 1.3 1.7 2.3 2.2.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5 0 .7-.4 1.3-.9 1.6-.5.3-1.1.4-1.8.2-1-.3-2.3-.9-3.6-2.1-1.1-1-1.9-2.3-2.1-3.2-.2-.7 0-1.4.5-2.1Z"
                fill="currentColor"
              />
            </svg>
            <span>Chat on WhatsApp</span>
          </a>
        </div>

        <div class="contact-divider"></div>

        <div class="socials-header">
          <h3>Find me on socials.</h3>
          <p>Follow my work, explore ideas, and see what I'm learning.</p>
        </div>

        <div class="socials-grid">
          {socials.map((social) => (
            <div
              class:list={[
                "social-card",
                social.href ? "social-card-link" : "social-card-upcoming",
                `social-card--${social.kind}`,
              ]}
            >
              {social.href && (
                <a
                  class="social-card-link-overlay"
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${social.name}: ${social.detail}`}
                >
                  <span class="sr-only">Open {social.name}</span>
                </a>
              )}

              <span class="social-icon" aria-hidden="true">
                {social.kind === "instagram" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect
                      x="3.5"
                      y="3.5"
                      width="17"
                      height="17"
                      rx="5"
                      stroke="currentColor"
                      stroke-width="1.7"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="4"
                      stroke="currentColor"
                      stroke-width="1.7"
                    />
                    <circle cx="17.4" cy="6.8" r="1" fill="currentColor" />
                  </svg>
                )}

                {social.kind === "github" && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.8a9.4 9.4 0 0 0-3 18.3c.5.1.6-.2.6-.4v-1.5c-2.5.5-3-.9-3-.9-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.8.9 2.3.7.1-.5.3-.9.5-1.1-2-.2-4-.9-4-4.2 0-.9.3-1.6.9-2.2-.1-.2-.4-1.1.1-2.2 0 0 .7-.2 2.3.9a7.7 7.7 0 0 1 4.2 0c1.6-1.1 2.3-.9 2.3-.9.5 1.1.2 2 .1 2.2.6.6.9 1.3.9 2.2 0 3.3-2 4-4 4.2.3.3.5.7.5 1.4v2.1c0 .2.2.5.6.4A9.4 9.4 0 0 0 12 2.8Z" />
                  </svg>
                )}

                {social.kind === "whatsapp" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M19.8 11.7a7.8 7.8 0 0 1-11.4 7L4 20l1.2-4.1a7.8 7.8 0 1 1 14.6-4.2Z"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M8.6 8.4c.3-.5.5-.5.8-.5h.3c.2 0 .3.1.4.4l.7 1.5c.1.2.1.4-.1.6l-.5.5c-.2.2-.2.4 0 .6.6.9 1.3 1.6 2.2 2.1.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.4.7c.3.1.4.3.4.5 0 .6-.4 1.2-.8 1.4-.4.3-1 .4-1.7.2-1-.3-2.2-.9-3.4-2-1-1-1.8-2.2-2-3.1-.2-.7 0-1.4.5-2Z"
                      fill="currentColor"
                    />
                  </svg>
                )}

                {social.kind === "twitter" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M19.8 7.1c-.6.3-1.3.5-2 .5a3.4 3.4 0 0 0-5.8 3.1 9.7 9.7 0 0 1-7-3.5 3.4 3.4 0 0 0 1.1 4.5c-.5 0-1-.2-1.5-.4v.1c0 1.6 1.1 3 2.7 3.3-.5.2-1 .2-1.5.1.4 1.4 1.7 2.4 3.2 2.4A6.8 6.8 0 0 1 4 18.6a9.6 9.6 0 0 0 5.2 1.5c6.2 0 9.7-5.2 9.7-9.7v-.4c.7-.5 1.2-1.1 1.7-1.8-.7.3-1.3.5-2 .5.7-.4 1.2-1 1.4-1.8-.6.4-1.3.7-2 .9"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </span>

              <span class="social-copy">
                <strong>{social.name}</strong>
                <span class="social-detail">{social.detail}</span>
              </span>

              <span class="social-status">{social.status}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="contact-portrait-column">
        <div class="contact-portrait-card">
          <div class="contact-portrait-glow" aria-hidden="true"></div>
          <div class="contact-portrait-orbit" aria-hidden="true"></div>

          <button
            class="contact-portrait-trigger"
            type="button"
            data-contact-photo-trigger
            aria-label="Enlarge Kartik's portrait"
            aria-expanded="false"
          >
            <img
              src="/memoji/kartik-call-me.png"
              alt="Kartik Verma smiling and gesturing hello"
              class="contact-portrait"
              width="520"
              height="520"
              loading="lazy"
              decoding="async"
            />
          </button>

          <span class="contact-portrait-bottom-light" aria-hidden="true"></span>
        </div>

        <div class="contact-portrait-caption">
          

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>(".contact-section")
    .forEach((section) => {
      if (section.dataset.contactInitialized === "true") return;
      section.dataset.contactInitialized = "true";

      const whiteText = section.querySelector<HTMLElement>(
        "[data-contact-heading-white]",
      );
      const accentText = section.querySelector<HTMLElement>(
        "[data-contact-heading-accent]",
      );
      const cursor = section.querySelector<HTMLElement>(
        "[data-contact-cursor]",
      );
      const photoTrigger = section.querySelector<HTMLButtonElement>(
        "[data-contact-photo-trigger]",
      );

      if (!whiteText || !accentText || !cursor || !photoTrigger) return;

      const whitePhrase = "Has something ";
      const accentPhrase = "great in mind?";
      const headingText = whitePhrase + accentPhrase;

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const hasHover = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
      );

      let typingTimer: number | null = null;
      let lightbox: HTMLDivElement | null = null;
      let dismissTimer: number | null = null;

      const startTyping = (): void => {
        if (typingTimer !== null) {
          window.clearTimeout(typingTimer);
          typingTimer = null;
        }

        whiteText.textContent = "";
        accentText.textContent = "";

        if (reducedMotion.matches) {
          whiteText.textContent = whitePhrase;
          accentText.textContent = accentPhrase;
          cursor.hidden = true;
          return;
        }

        cursor.hidden = false;
        cursor.classList.remove("is-complete");

        let index = 0;

        const typeNext = (): void => {
          if (index >= headingText.length) {
            cursor.classList.add("is-complete");
            typingTimer = null;
            return;
          }

          if (index < whitePhrase.length) {
            whiteText.textContent += headingText[index];
          } else {
            accentText.textContent += headingText[index];
          }

          index += 1;
          typingTimer = window.setTimeout(typeNext, 48);
        };

        typeNext();
      };

      const closeLightbox = (): void => {
        if (dismissTimer !== null) {
          window.clearTimeout(dismissTimer);
          dismissTimer = null;
        }

        if (lightbox) {
          lightbox.classList.remove("is-visible");
          lightbox.remove();
          lightbox = null;
        }

        photoTrigger.setAttribute("aria-expanded", "false");
      };

      const openLightbox = (): void => {
        if (lightbox) return;

        const sourceImage =
          photoTrigger.querySelector<HTMLImageElement>("img");

        if (!sourceImage || !(sourceImage.currentSrc || sourceImage.src)) {
          return;
        }

        const overlay = document.createElement("div");
        overlay.className = "contact-photo-lightbox";
        overlay.setAttribute("role", "presentation");
        overlay.setAttribute("aria-hidden", "true");

        const enlargedImage = document.createElement("img");
        enlargedImage.className = "contact-photo-lightbox-image";
        enlargedImage.src = sourceImage.currentSrc || sourceImage.src;
        enlargedImage.alt = "";

        overlay.append(enlargedImage);
        document.body.append(overlay);
        lightbox = overlay;

        window.requestAnimationFrame(() => {
          overlay.classList.add("is-visible");
        });

        photoTrigger.setAttribute("aria-expanded", "true");
      };

      photoTrigger.addEventListener("pointerenter", (event: PointerEvent) => {
        if (!hasHover.matches || event.pointerType === "touch") return;
        openLightbox();
      });

      photoTrigger.addEventListener("pointerleave", (event: PointerEvent) => {
        if (!hasHover.matches || event.pointerType === "touch") return;
        closeLightbox();
      });

      photoTrigger.addEventListener("focus", () => {
        openLightbox();
      });

      photoTrigger.addEventListener("blur", () => {
        if (hasHover.matches) closeLightbox();
      });

      photoTrigger.addEventListener("click", () => {
        if (hasHover.matches) return;

        if (lightbox) {
          closeLightbox();
          return;
        }

        openLightbox();

        dismissTimer = window.setTimeout(() => {
          closeLightbox();
        }, 3000);
      });

      document.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape" && lightbox) {
          closeLightbox();
        }
      });

      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
          if (typingTimer !== null) {
            window.clearTimeout(typingTimer);
            typingTimer = null;
          }

          whiteText.textContent = whitePhrase;
          accentText.textContent = accentPhrase;
          cursor.hidden = true;
        } else {
          startTyping();
        }
      });

      startTyping();
    });
</script>

<style>
  .contact-section {
    --contact-bg: #0b0809;
    --contact-surface: #130d10;
    --contact-text: #f5e7e8;
    --contact-muted: #b7a7aa;
    --contact-accent: #e44752;
    --contact-pink: #f06b83;

    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(44px, 5.4vw, 72px) clamp(18px, 6vw, 88px);
    overflow: clip;
    color: var(--contact-text);
    background: var(--contact-bg);
    scroll-margin-top: 95px;
  }

  .contact-section *,
  .contact-section *::before,
  .contact-section *::after {
    box-sizing: border-box;
  }

  .contact-atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 14% 30%, rgba(228, 71, 82, 0.065), transparent 36%),
      radial-gradient(ellipse at 86% 65%, rgba(240, 107, 131, 0.05), transparent 37%);
  }

  .contact-container {
    width: 100%;
    max-width: 1190px;
    margin-inline: auto;
  }

  /* Tight header: one continuous headline, without an extra eyebrow label. */

  .contact-header {
    width: 100%;
    max-width: 100%;
    margin: 0 auto 25px;
    text-align: center;
  }

  .contact-title {
    display: block;
    width: 100%;
    margin: 0;
    color: #f5e7e8;
    font-size: clamp(1.25rem, 4.8vw, 4.15rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .contact-title > span {
    display: inline;
  }

  .contact-title-accent {
    color: var(--contact-pink);
  }

  .contact-type-cursor {
    display: inline-block !important;
    width: 3px;
    height: 0.86em;
    margin-left: 2px;
    transform: translateY(2px);
    background: var(--contact-pink);
    animation: contact-cursor-blink 780ms steps(2, start) infinite;
  }

  .contact-type-cursor.is-complete {
    opacity: 0;
    animation: none;
  }

  .contact-type-cursor[hidden] {
    display: none !important;
  }

  .contact-subheading {
    margin: 13px 0 0;
    color: #f5e7e8;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .contact-intro {
    max-width: 660px;
    margin: 7px auto 0;
    color: var(--contact-muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.7fr);
    align-items: start;
    gap: clamp(24px, 4vw, 48px);
  }

  .contact-information {
    min-width: 0;
    padding: clamp(18px, 2.8vw, 27px);
    border: 1px solid #3b2228;
    border-radius: 12px;
    background:
      linear-gradient(145deg, rgba(228, 71, 82, 0.03), transparent 58%),
      #100b0d;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 45px;
    padding: 10px 14px;
    overflow: hidden;
    border: 1px solid #4c2c34;
    border-radius: 5px;
    color: #f5e7e8;
    background: linear-gradient(180deg, #1b1114, #120c0e);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.45;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .contact-button svg {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
  }

  .contact-button-primary {
    border-color: var(--contact-accent);
    color: #fff;
    background: linear-gradient(180deg, #f05a68, #d83a49);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 4px 15px rgba(228, 71, 82, 0.12);
  }

  .contact-button-primary:hover {
    border-color: #ff8a94;
    background: linear-gradient(180deg, #fa7180, #e44752);
    box-shadow: 0 5px 22px rgba(228, 71, 82, 0.2);
    transform: translateY(-2px);
  }

  .contact-button-secondary:hover {
    border-color: #b95a69;
    background: #201115;
    box-shadow: 0 0 18px rgba(228, 71, 82, 0.075);
    transform: translateY(-2px);
  }

  .contact-divider {
    height: 1px;
    margin: 23px 0 20px;
    background: linear-gradient(90deg, #3f282e, #2b1b20, transparent);
  }

  .socials-header h3 {
    margin: 0;
    color: #f5e7e8;
    font-size: 1.04rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.45;
  }

  .socials-header p {
    margin: 6px 0 0;
    color: #ab999e;
    font-size: 0.79rem;
    line-height: 1.7;
  }

  .socials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    margin-top: 15px;
  }

  .social-card {
    --social-accent: #e44752;

    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    min-height: 70px;
    padding: 10px;
    border: 1px solid #332127;
    border-radius: 7px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--social-accent) 4%, transparent), transparent),
      #0d0a0b;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .social-card--instagram { --social-accent: #f06b83; }
  .social-card--github { --social-accent: #dfcbd0; }
  .social-card--whatsapp { --social-accent: #e44752; }
  .social-card--twitter { --social-accent: #d6b45e; }

  .social-card-link:hover {
    border-color: color-mix(in srgb, var(--social-accent) 55%, #332127);
    background: color-mix(in srgb, var(--social-accent) 5%, #0d0a0b);
    box-shadow: 0 8px 23px rgba(0, 0, 0, 0.16);
    transform: translateY(-2px);
  }

  .social-card-link-overlay {
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
  }

  .social-card-link-overlay:focus-visible {
    outline: 2px solid var(--social-accent);
    outline-offset: 3px;
  }

  .social-icon {
    display: grid;
    width: 35px;
    height: 35px;
    flex: 0 0 35px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--social-accent) 28%, #332127);
    border-radius: 6px;
    color: var(--social-accent);
    background: color-mix(in srgb, var(--social-accent) 5%, #100b0d);
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
  }

  .social-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: 4px;
  }

  .social-copy strong {
    color: #f4e6e8;
    font-size: 0.77rem;
    font-weight: 680;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .social-detail {
    color: #a9969b;
    font-size: 0.66rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .social-status {
    flex: 0 0 auto;
    max-width: 65px;
    color: var(--social-accent);
    font-size: 0.57rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .social-card-upcoming {
    border-style: dashed;
    border-color: #49352c;
    background: linear-gradient(145deg, rgba(214, 180, 94, 0.035), #0d0a0b);
  }

  .social-card-upcoming .social-detail {
    color: #b4a49a;
  }

  .contact-portrait-column {
    min-width: 0;
  }

  .contact-portrait-card {
    position: relative;
    isolation: isolate;
    display: grid;
    min-width: 0;
    min-height: 440px;
    place-items: center;
    overflow: hidden;
    border: 1px solid #43252c;
    border-radius: 15px;
    background:
      radial-gradient(ellipse at 50% 41%, rgba(228, 71, 82, 0.15), transparent 44%),
      linear-gradient(155deg, #181013, #0e0a0c 78%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 20px 42px rgba(0, 0, 0, 0.18);
  }

  .contact-portrait-glow {
    position: absolute;
    z-index: -1;
    top: 23%;
    left: 50%;
    width: min(85%, 355px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(228, 71, 82, 0.15);
    filter: blur(49px);
    transform: translateX(-50%);
    pointer-events: none;
    animation: contact-portrait-breathe 5s ease-in-out infinite alternate;
  }

  .contact-portrait-orbit {
    position: absolute;
    z-index: -1;
    top: 46%;
    left: 50%;
    width: min(87%, 370px);
    aspect-ratio: 1;
    border: 1px solid rgba(228, 71, 82, 0.18);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .contact-portrait-trigger {
    position: relative;
