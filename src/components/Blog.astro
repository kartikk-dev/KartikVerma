
---
const articles = [
  {
    title: "What Actually Happens When You Type a URL Into Your Browser?",
    excerpt:
      "The real story behind how URLs travel through the browser, connect to servers, and turn an address into a working page.",
    category: "Internet & World",
    accent: "#39D6A0",
    theme: "green",
    href: "https://hashnode.com/edit/cmuthdsim000206p4fir0a4cj",
  },
  {
    title: "When Correctness Is Not Enough: Understanding Why Technically Functional Web Applications Still Fail in Practice",
    excerpt:
      "Modern software development often begins with a deceptively simple objective: build a system that works. Real success depends on much more.",
    category: "Technical Article",
    accent: "#F05B82",
    theme: "pink",
    href: "https://hashnode.com/edit/cmuthypx3000106o25b7caay1",
  },
  {
    title: "How to Read People Without Them Saying a Word",
    excerpt:
      "Explore the psychology of observation, behaviour, attention, and the techniques that can make reading people seem like mind reading.",
    category: "Mentalism Article",
    accent: "#D6B45E",
    theme: "gold",
    href: "https://kartikvermaa.blogspot.com/2026/08/how-to-read-people-without-them-saying.html",
  },
];
---

<section
  id="blog"
  class="portfolio-blog"
  aria-labelledby="portfolio-blog-title"
>
  <div class="blog-atmosphere" aria-hidden="true"></div>

  <div class="blog-container">
    <header class="blog-header">
      <p class="blog-eyebrow">
        <span class="blog-eyebrow-line" aria-hidden="true"></span>
        BLOGS & JOURNAL
        <span class="blog-eyebrow-line" aria-hidden="true"></span>
      </p>

      <h2 id="portfolio-blog-title">
        Articles to read,
        <span>ideas to explore.</span>
      </h2>

      <p class="blog-description">
        Articles, engineering lessons, technical discoveries, and ideas from
        my journey building digital products.
      </p>
    </header>

    <div class="blog-grid">
      {articles.map((article) => (
        <article
          class={`blog-card blog-card--${article.theme}`}
          data-blog-card
          style={`--article-accent: ${article.accent};`}
        >
          <div class="blog-card-glass" aria-hidden="true"></div>
          <div class="blog-card-shine" aria-hidden="true"></div>

          <div class="blog-card-inner">
            <div class="blog-card-top">
              <span class="blog-category">{article.category}</span>
              <span class="blog-category-dot" aria-hidden="true"></span>
            </div>

            <div class="blog-card-content">
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
            </div>

            <footer class="blog-card-footer">
              <a
                class="blog-read-button"
                href={article.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Read article: ${article.title}`}
              >
                <span>Read Article</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </footer>
          </div>

          <span class="blog-card-bottom-light" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <div class="blog-footer">
      <span class="blog-footer-line" aria-hidden="true"></span>
      <p>Thoughts, lessons, and discoveries from building on the web.</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".portfolio-blog").forEach((section) => {
    if (section.dataset.blogInitialized === "true") return;
    section.dataset.blogInitialized = "true";

    const cards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-blog-card]"),
    );

    const finePointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    );
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!finePointer.matches || reducedMotion.matches) return;

    cards.forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        if (!(event instanceof PointerEvent)) return;

        const bounds = card.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;

        const x = (event.clientX - bounds.left) / bounds.width;
        const y = (event.clientY - bounds.top) / bounds.height;

        const tiltX = (0.5 - y) * 5;
        const tiltY = (x - 0.5) * 6;

        card.style.setProperty("--blog-tilt-x", `${tiltX.toFixed(2)}deg`);
        card.style.setProperty("--blog-tilt-y", `${tiltY.toFixed(2)}deg`);

        card.style.setProperty("--shine-x", `${x * 100}%`);
        card.style.setProperty("--shine-y", `${y * 100}%`);
      });

      const resetTilt = () => {
        card.style.setProperty("--blog-tilt-x", "0deg");
        card.style.setProperty("--blog-tilt-y", "0deg");
        card.style.setProperty("--shine-x", "50%");
        card.style.setProperty("--shine-y", "0%");
      };

      card.addEventListener("pointerleave", resetTilt);

      card.addEventListener("focusout", (event) => {
        if (
          event.relatedTarget instanceof Node &&
          card.contains(event.relatedTarget)
        ) {
          return;
        }

        resetTilt();
      });
    });
  });
</script>

<style>
  .portfolio-blog {
    --blog-bg: #0b0809;
    --blog-text: #f5e7e8;
    --blog-muted: #b7a7aa;
    --blog-pink: #f05b82;

    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(78px, 8.5vw, 116px) clamp(20px, 6vw, 88px);
    overflow: clip;
    color: var(--blog-text);
    background: var(--blog-bg);
    scroll-margin-top: 95px;
  }

  .portfolio-blog *,
  .portfolio-blog *::before,
  .portfolio-blog *::after {
    box-sizing: border-box;
  }

  .blog-atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 50% 8%,
        rgba(240, 91, 130, 0.085),
        transparent 39%
      ),
      radial-gradient(
        ellipse at 5% 65%,
        rgba(57, 214, 160, 0.045),
        transparent 31%
      ),
      radial-gradient(
        ellipse at 95% 75%,
        rgba(214, 180, 94, 0.045),
        transparent 31%
      );
  }

  .blog-container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Centered editorial heading */

  .blog-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 830px;
    margin: 0 auto clamp(35px, 4.5vw, 54px);
    text-align: center;
  }

  .blog-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 0 20px;
    color: #e7b7c3;
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.6;
  }

  .blog-eyebrow-line {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--blog-pink);
    opacity: 0.82;
  }

  .blog-header h2 {
    max-width: 820px;
    margin: 0;
    color: var(--blog-text);
    font-size: clamp(2.45rem, 5.1vw, 4.15rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.1;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .blog-header h2 span {
    display: block;
    color: var(--blog-pink);
  }

  .blog-description {
    max-width: 670px;
    margin: 19px 0 0;
    color: var(--blog-muted);
    font-size: 0.93rem;
    line-height: 1.85;
  }

  /* Three glass-style 3D cards */

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
    perspective: 1400px;
  }

  .blog-card {
    --article-accent: #f05b82;
    --blog-tilt-x: 0deg;
    --blog-tilt-y: 0deg;
    --shine-x: 50%;
    --shine-y: 0%;

    position: relative;
    isolation: isolate;
    display: flex;
    min-width: 0;
    min-height: 365px;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--article-accent) 37%, #292126);
    border-radius: 15px;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--article-accent) 7%, #121012),
        #0c0a0b 70%
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.065),
      inset 0 -1px 0 rgba(255, 255, 255, 0.015),
      0 16px 38px rgba(0, 0, 0, 0.17);
    transform:
      perspective(1200px)
      rotateX(var(--blog-tilt-x))
      rotateY(var(--blog-tilt-y))
      translateY(0)
      scale(1);
    transform-style: preserve-3d;
    transition:
      transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 280ms ease,
      box-shadow 280ms ease;
    will-change: transform;
  }

  /* Emerald glass on the left, highlighted neon pink in the centre,
     and a metallic gold finish on the right. */

  .blog-card--green {
    --article-accent: #39d6a0;
    background:
      radial-gradient(
        ellipse at 6% 0%,
        rgba(57, 214, 160, 0.09),
        transparent 47%
      ),
      linear-gradient(145deg, #101916, #0c0d0c 76%);
  }

  .blog-card--pink {
    --article-accent: #f05b82;
    border-color: rgba(240, 91, 130, 0.63);
    background:
      radial-gradient(
        ellipse at 90% 0%,
        rgba(240, 91, 130, 0.16),
        transparent 46%
      ),
      linear-gradient(150deg, #1b1015, #100b0e 75%);
    box-shadow:
      inset 0 1px 0 rgba(255, 236, 242, 0.09),
      0 18px 44px rgba(0, 0, 0, 0.22),
      0 0 24px rgba(240, 91, 130, 0.07);
    transform:
      perspective(1200px)
      rotateX(var(--blog-tilt-x))
      rotateY(var(--blog-tilt-y))
      translateY(-10px)
      scale(1.015);
  }

  .blog-card--gold {
    --article-accent: #d6b45e;
    background:
      radial-gradient(
        ellipse at 95% 0%,
        rgba(214, 180, 94, 0.09),
        transparent 46%
      ),
      linear-gradient(145deg, #19160f, #100e0b 76%);
  }

  .blog-card-glass {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    opacity: 0.8;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.045),
      transparent 32%,
      transparent 72%,
      rgba(255, 255, 255, 0.018)
    );
  }

  .blog-card-shine {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--shine-x) var(--shine-y),
      color-mix(in srgb, var(--article-accent) 15%, transparent),
      transparent 56%
    );
    transition: opacity 250ms ease;
  }

  .blog-card-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 25px;
    transform: translateZ(12px);
  }

  .blog-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 30px;
  }

  .blog-category {
    display: inline-flex;
    max-width: calc(100% - 18px);
    align-items: center;
    padding: 6px 9px;
    border: 1px solid color-mix(in srgb, var(--article-accent) 43%, #292126);
    border-radius: 5px;
    color: var(--article-accent);
    background: color-mix(in srgb, var(--article-accent) 5%, #0e0c0d);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .blog-category-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--article-accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--article-accent) 40%, transparent);
  }

  .blog-card-content {
    flex: 1;
    min-width: 0;
  }

  .blog-card-content h3 {
    margin: 0 0 14px;
    color: #f5e7e8;
    font-size: clamp(1.12rem, 1.5vw, 1.36rem);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.42;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .blog-card-content p {
    margin: 0;
    color: #b8aaad;
    font-size: 0.83rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    margin-top: 28px;
  }

  /* Glossy, rectangular call-to-action buttons */

  .blog-read-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 17px;
    width: 100%;
    min-height: 46px;
    padding: 11px 14px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--article-accent) 68%, #302126);
    border-radius: 5px;
    color: #fff4f5;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--article-accent) 21%, #242024),
        color-mix(in srgb, var(--article-accent) 8%, #100d0e)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 4px 15px rgba(0, 0, 0, 0.18);
    font-family: inherit;
    font-size: 0.77rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 220ms ease,
      background 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .blog-read-button::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -90%;
    width: 65%;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 255, 255, 0.17),
      transparent
    );
    content: "";
    transform: skewX(-20deg);
    transition: left 480ms ease;
  }

  .blog-read-button span,
  .blog-read-button svg {
    position: relative;
    z-index: 1;
  }

  .blog-read-button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 220ms ease;
  }

  .blog-read-button:hover {
    border-color: var(--article-accent);
    color: #0b0a0b;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--article-accent) 96%, white),
      var(--article-accent)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      0 5px 22px color-mix(in srgb, var(--article-accent) 17%, transparent);
    transform: translateY(-1px);
  }

  .blog-read-button:hover::before {
    left: 135%;
  }

  .blog-read-button:hover svg {
    transform: translateX(3px);
  }

  .blog-read-button:focus-visible {
    outline: 2px solid var(--article-accent);
    outline-offset: 4px;
  }

  .blog-card-bottom-light {
    position: absolute;
    right: 18%;
    bottom: 0;
    left: 18%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      var(--article-accent),
      transparent
    );
    opacity: 0.45;
  }

  /* Matching glow and lift on hover */

  .blog-card:hover,
  .blog-card:focus-within {
    border-color: color-mix(in srgb, var(--article-accent) 88%, white 0%);
    transform:
      perspective(1200px)
      rotateX(var(--blog-tilt-x))
      rotateY(var(--blog-tilt-y))
      translateY(-7px)
      scale(1.025);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 25px 55px rgba(0, 0, 0, 0.28),
      0 0 30px color-mix(in srgb, var(--article-accent) 13%, transparent);
  }

  .blog-card:hover .blog-card-shine,
  .blog-card:focus-within .blog-card-shine {
    opacity: 1;
  }

  .blog-card--pink:hover,
  .blog-card--pink:focus-within {
    box-shadow:
      inset 0 1px 0 rgba(255, 236, 242, 0.12),
      0 27px 57px rgba(0, 0, 0, 0.32),
      0 0 36px rgba(240, 91, 130, 0.2);
  }

  .blog-footer {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 27px;
  }

  .blog-footer-line {
    display: block;
    width: 22px;
    height: 1px;
    flex: 0 0 22px;
    margin-top: 9px;
    background: var(--blog-pink);
  }

  .blog-footer p {
    margin: 0;
    color: #97868b;
    font-size: 0.76rem;
    line-height: 1.8;
  }

  @media (max-width: 960px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .blog-card {
      min-height: 340px;
    }

    .blog-card--pink {
      transform: none;
    }

    .blog-card--pink:hover,
    .blog-card--pink:focus-within {
      transform:
        perspective(1200px)
        rotateX(var(--blog-tilt-x))
        rotateY(var(--blog-tilt-y))
        translateY(-7px)
        scale(1.02);
    }

    .blog-card-content h3 {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 620px) {
    .portfolio-blog {
      padding: 68px 16px;
      scroll-margin-top: 82px;
    }

    .blog-header {
      margin-bottom: 29px;
    }

    .blog-eyebrow {
      gap: 9px;
      margin-bottom: 16px;
      font-size: 0.63rem;
    }

    .blog-eyebrow-line {
      width: 16px;
    }

    .blog-header h2 {
      font-size: clamp(2.2rem, 9vw, 3.15rem);
      line-height: 1.12;
    }

    .blog-description {
      margin-top: 14px;
      font-size: 0.85rem;
      line-height: 1.8;
    }

    .blog-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 17px;
      perspective: none;
    }

    .blog-card,
    .blog-card--pink {
      min-height: 0;
      transform: none;
      border-radius: 12px;
    }

    .blog-card:hover,
    .blog-card:focus-within,
    .blog-card--pink:hover,
    .blog-card--pink:focus-within {
      transform: translateY(-3px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.07),
        0 15px 32px rgba(0, 0, 0, 0.24),
        0 0 20px color-mix(in srgb, var(--article-accent) 10%, transparent);
    }

    .blog-card-inner {
      padding: 21px;
      transform: none;
    }

    .blog-card-top {
      margin-bottom: 23px;
    }

    .blog-card-content h3 {
      font-size: 1.2rem;
      line-height: 1.4;
    }

    .blog-card-content p {
      font-size: 0.83rem;
    }

    .blog-card-footer {
      margin-top: 24px;
    }

    .blog-read-button {
      min-height: 45px;
    }

    .blog-footer {
      margin-top: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-blog *,
    .portfolio-blog *::before,
    .portfolio-blog *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }

    .blog-card,
    .blog-card:hover,
    .blog-card:focus-within,
    .blog-card--pink,
    .blog-card--pink:hover {
      transform: none;
    }
  }
</style>
