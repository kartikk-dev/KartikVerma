---
---

<section class="view serviq-inventory" data-panel="inventory">
  <div class="page-heading">
    <div>
      <span class="eyebrow">RESOURCES / INVENTORY</span>
      <h1>
        Know what is <em>in stock.</em>
      </h1>
      <p>
        Track parts, manage quantities and identify stock that needs attention.
      </p>
    </div>

    <button class="primary-action" id="serviq-add-inventory" type="button">
      <span>+</span>
      Add Stock Item
    </button>
  </div>

  <div
    class="serviq-inventory-feedback"
    id="serviq-inventory-feedback"
    role="status"
    aria-live="polite"
    hidden
  ></div>

  <section
    class="serviq-inventory-summary"
    id="serviq-inventory-summary"
    aria-label="Inventory summary"
  ></section>

  <section class="serviq-inventory-toolbar" aria-label="Inventory filters">
    <label class="serviq-inventory-search">
      <span aria-hidden="true">⌕</span>
      <input
        id="serviq-inventory-search"
        type="search"
        placeholder="Search item name, SKU or unit..."
        autocomplete="off"
        aria-label="Search inventory"
      />
    </label>

    <label class="serviq-inventory-filter">
      <span>Stock health</span>
      <select id="serviq-inventory-health">
        <option value="all">All stock levels</option>
        <option value="Healthy">Healthy</option>
        <option value="Low">Low stock</option>
        <option value="Critical">Critical</option>
      </select>
    </label>

    <label class="serviq-inventory-filter">
      <span>Sort by</span>
      <select id="serviq-inventory-sort">
        <option value="name">Item name</option>
        <option value="stock-asc">Lowest quantity</option>
        <option value="stock-desc">Highest quantity</option>
        <option value="health">Stock health</option>
      </select>
    </label>
  </section>

  <div class="serviq-inventory-results-heading">
    <div>
      <span class="panel-label">STOCK REGISTER</span>
      <h2>Inventory items</h2>
    </div>

    <span
      id="serviq-inventory-result-count"
      class="serviq-inventory-result-count"
    >
      Loading inventory...
    </span>
  </div>

  <section
    class="serviq-inventory-list"
    id="serviq-inventory-list"
    aria-label="Inventory item list"
    aria-live="polite"
  ></section>

  <div class="serviq-inventory-empty" id="serviq-inventory-empty" hidden>
    <span class="serviq-inventory-empty-icon" aria-hidden="true">
      ⌕
    </span>
    <h3>No inventory items found</h3>
    <p>Try another search or change the stock health filter.</p>
    <button class="secondary-action" type="button" id="serviq-inventory-reset">
      Clear filters
    </button>
  </div>
</section>

<div class="serviq-inventory-modal" id="serviq-inventory-modal" hidden>
  <section
    class="serviq-inventory-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="serviq-inventory-modal-title"
  >
    <header class="serviq-inventory-modal-header">
      <div>
        <span class="eyebrow">INVENTORY MANAGEMENT</span>
        <h2 id="serviq-inventory-modal-title">Add stock item</h2>
        <p id="serviq-inventory-modal-description">
          Register a part or supply in your inventory.
        </p>
      </div>

      <button
        type="button"
        class="serviq-inventory-modal-close"
        id="serviq-inventory-modal-close"
        aria-label="Close inventory form"
      >
        ×
      </button>
    </header>

    <form id="serviq-inventory-form">
      <div class="serviq-inventory-form-grid">
        <label class="serviq-inventory-field serviq-inventory-field-wide">
          <span>
            Item name <b>*</b>
          </span>
          <input
            name="name"
            type="text"
            maxlength="120"
            placeholder="e.g. Universal Relay"
            required
          />
        </label>

        <label class="serviq-inventory-field">
          <span>
            SKU <b>*</b>
          </span>
          <input
            name="sku"
            type="text"
            maxlength="80"
            placeholder="e.g. EL-REL-01"
            required
          />
          <small id="serviq-inventory-sku-help">
            Use a unique stock-keeping code.
          </small>
        </label>

        <label class="serviq-inventory-field">
          <span>
            Unit <b>*</b>
          </span>
          <input
            name="unit"
            type="text"
            maxlength="24"
            placeholder="pcs, m, cyl..."
            required
          />
        </label>

        <label class="serviq-inventory-field">
          <span>
            Current quantity <b>*</b>
          </span>
          <input
            name="stock"
            type="number"
            min="0"
            max="1000000000"
            step="1"
            value="0"
            required
          />
        </label>

        <label class="serviq-inventory-field">
          <span>
            Reorder threshold <b>*</b>
          </span>
          <input
            name="min"
            type="number"
            min="0"
            max="1000000000"
            step="1"
            value="5"
            required
          />
        </label>
      </div>

      <div class="serviq-inventory-form-note">
        <span aria-hidden="true">i</span>
        Stock health is calculated automatically from the quantity and reorder
        threshold.
      </div>

      <div class="serviq-inventory-modal-actions">
        <button
          class="secondary-action"
          type="button"
          id="serviq-inventory-cancel"
        >
          Cancel
        </button>

        <button class="primary-action" type="submit" id="serviq-inventory-save">
          Add stock item
        </button>
      </div>
    </form>
  </section>
</div>

<script>
  import {
    createInventoryItem,
    deleteInventoryItem,
    getState,
    subscribe,
    updateInventoryItem,
  } from "../../lib/serviq/store";

  import type { InventoryItem } from "../../data/serviq/inventory";

  const list = document.querySelector<HTMLElement>("#serviq-inventory-list");

  const summary = document.querySelector<HTMLElement>(
    "#serviq-inventory-summary",
  );

  const searchInput = document.querySelector<HTMLInputElement>(
    "#serviq-inventory-search",
  );

  const healthFilter = document.querySelector<HTMLSelectElement>(
    "#serviq-inventory-health",
  );

  const sortSelect = document.querySelector<HTMLSelectElement>(
    "#serviq-inventory-sort",
  );

  const resultCount = document.querySelector<HTMLElement>(
    "#serviq-inventory-result-count",
  );

  const emptyState = document.querySelector<HTMLElement>(
    "#serviq-inventory-empty",
  );

  const modal = document.querySelector<HTMLElement>("#serviq-inventory-modal");

  const form = document.querySelector<HTMLFormElement>(
    "#serviq-inventory-form",
  );

  const modalTitle = document.querySelector<HTMLElement>(
    "#serviq-inventory-modal-title",
  );

  const modalDescription = document.querySelector<HTMLElement>(
    "#serviq-inventory-modal-description",
  );

  const saveButton = document.querySelector<HTMLButtonElement>(
    "#serviq-inventory-save",
  );

  const skuHelp = document.querySelector<HTMLElement>(
    "#serviq-inventory-sku-help",
  );

  const feedback = document.querySelector<HTMLElement>(
    "#serviq-inventory-feedback",
  );

  if (
    list &&
    summary &&
    searchInput &&
    healthFilter &&
    sortSelect &&
    resultCount &&
    emptyState &&
    modal &&
    form &&
    modalTitle &&
    modalDescription &&
    saveButton &&
    skuHelp &&
    feedback
  ) {
    type StockHealth = InventoryItem["state"];

    const healthRank: Record<StockHealth, number> = {
      Critical: 0,
      Low: 1,
      Healthy: 2,
    };

    let editingSku: string | null = null;
    let previousBodyOverflow = "";
    let feedbackTimeout: ReturnType<typeof setTimeout> | undefined;

    const escapeHtml = (value: unknown): string =>
      String(value ?? "").replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        };

        return entities[character] ?? character;
      });

    const deriveHealth = (stock: number, min: number): StockHealth => {
      if (stock <= 0) return "Critical";
      if (min > 0 && stock <= min * 0.6) return "Critical";
      if (stock <= min) return "Low";
      return "Healthy";
    };

    const getHealthClass = (health: StockHealth): string =>
      health.toLowerCase();

    const formatNumber = (value: number): string =>
      new Intl.NumberFormat("en-IN", {
        maximumFractionDigits: 0,
      }).format(value);

    const showFeedback = (
      message: string,
      kind: "success" | "error" = "success",
    ): void => {
      if (!feedback) return;

      if (feedbackTimeout) clearTimeout(feedbackTimeout);

      feedback.textContent = message;
      feedback.className = `serviq-inventory-feedback ${kind}`;
      feedback.hidden = false;

      feedbackTimeout = setTimeout(() => {
        if (feedback) feedback.hidden = true;
      }, 4000);
    };

    const renderSummary = (items: InventoryItem[]): void => {
      const healthy = items.filter(
        (item) => deriveHealth(item.stock, item.min) === "Healthy",
      ).length;

      const low = items.filter(
        (item) => deriveHealth(item.stock, item.min) === "Low",
      ).length;

      const critical = items.filter(
        (item) => deriveHealth(item.stock, item.min) === "Critical",
      ).length;

      const metrics = [
        {
          label: "Total SKUs",
          value: items.length,
          note: "Registered inventory items",
          accent: "gold",
          icon: "▤",
        },
        {
          label: "Healthy stock",
          value: healthy,
          note: "Quantity above reorder level",
          accent: "green",
          icon: "✓",
        },
        {
          label: "Low stock",
          value: low,
          note: "Replenishment recommended",
          accent: "amber",
          icon: "!",
        },
        {
          label: "Critical stock",
          value: critical,
          note: "Urgent restock attention",
          accent: "red",
          icon: "↓",
        },
      ];

      summary.innerHTML = metrics
        .map(
          (metric) => `
            <article class="serviq-inventory-metric ${metric.accent}">
              <div class="serviq-inventory-metric-top">
                <span>${escapeHtml(metric.label)}</span>
                <span class="serviq-inventory-metric-icon" aria-hidden="true">${metric.icon}</span>
              </div>
              <strong>${metric.value}</strong>
              <small>${escapeHtml(metric.note)}</small>
            </article>
          `,
        )
        .join("");
    };

    const renderInventory = (): void => {
      if (!list || !summary || !resultCount || !emptyState) return;

      const items = getState().inventory;
      const query = searchInput.value.trim().toLowerCase();
      const health = healthFilter.value;
      const sort = sortSelect.value;

      renderSummary(items);

      const filtered = items.filter((item) => {
        const matchesSearch = [item.name, item.sku, item.unit].some((value) =>
          String(value ?? "")
            .toLowerCase()
            .includes(query),
        );

        const itemHealth = deriveHealth(item.stock, item.min);
        const matchesHealth = health === "all" || itemHealth === health;

        return matchesSearch && matchesHealth;
      });

      filtered.sort((first, second) => {
        if (sort === "stock-asc") {
          return first.stock - second.stock;
        }

        if (sort === "stock-desc") {
          return second.stock - first.stock;
        }

        if (sort === "health") {
          return (
            healthRank[deriveHealth(first.stock, first.min)] -
            healthRank[deriveHealth(second.stock, second.min)]
          );
        }

        return first.name.localeCompare(second.name);
      });

      resultCount.textContent = `${filtered.length} of ${items.length} item${items.length === 1 ? "" : "s"}`;

      emptyState.hidden = filtered.length > 0;
      list.hidden = filtered.length === 0;

      list.innerHTML = filtered
        .map((item) => {
          const itemHealth = deriveHealth(item.stock, item.min);
          const healthClass = getHealthClass(itemHealth);
          const scale = Math.max(item.min * 3, 1);
          const barPercent = Math.min(
            100,
            Math.round((item.stock / scale) * 100),
          );

          const gap = Math.max(item.min - item.stock, 0);

          return `
            <article class="serviq-inventory-row" data-inventory-row="${escapeHtml(item.sku)}">
              <div class="serviq-inventory-item">
                <span class="serviq-inventory-item-icon ${healthClass}" aria-hidden="true">▦</span>
                <div>
                  <strong>${escapeHtml(item.name)}</strong>
                  <small>SKU: ${escapeHtml(item.sku)}</small>
                </div>
              </div>

              <div class="serviq-inventory-quantity">
                <strong>${formatNumber(item.stock)} <small>${escapeHtml(item.unit)}</small></strong>
                <span>Reorder at ${formatNumber(item.min)}</span>
              </div>

              <div class="serviq-inventory-health">
                <div class="serviq-inventory-health-label">
                  <span>Stock level</span>
                  <strong>${barPercent}%</strong>
                </div>
                <div
                  class="serviq-inventory-stock-track"
                  role="progressbar"
                  aria-label="Stock quantity relative to three times the reorder threshold"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="${barPercent}"
                >
                  <span class="${healthClass}" style="width: ${barPercent}%"></span>
                </div>
                <div class="serviq-inventory-health-bottom">
                  <span class="serviq-inventory-status ${healthClass}">
                    <i></i>
                    ${itemHealth}
                  </span>
                  ${
                    itemHealth === "Healthy"
                      ? `<small>Above threshold</small>`
                      : item.stock === 0
                        ? `<small>Out of stock</small>`
                        : `<small>${formatNumber(gap)} below threshold</small>`
                  }
                </div>
              </div>

              <div class="serviq-inventory-actions">
                <div class="serviq-inventory-quick-adjust" aria-label="Adjust stock quantity">
                  <button
                    type="button"
                    data-action="adjust"
                    data-direction="-1"
                    data-sku="${escapeHtml(item.sku)}"
                    aria-label="Remove one ${escapeHtml(item.unit)} from ${escapeHtml(item.name)}"
                    ${item.stock <= 0 ? "disabled" : ""}
                  >−</button>
                  <button
                    type="button"
                    data-action="adjust"
                    data-direction="1"
                    data-sku="${escapeHtml(item.sku)}"
                    aria-label="Add one ${escapeHtml(item.unit)} to ${escapeHtml(item.name)}"
                  >+</button>
                </div>
                <button
                  type="button"
                  class="serviq-inventory-edit"
                  data-action="edit"
                  data-sku="${escapeHtml(item.sku)}"
                >Edit</button>
                <button
                  type="button"
                  class="serviq-inventory-remove"
                  data-action="delete"
                  data-sku="${escapeHtml(item.sku)}"
                  aria-label="Remove ${escapeHtml(item.name)}"
                >Remove</button>
              </div>
            </article>
          `;
        })
        .join("");
    };

    const openModal = (item?: InventoryItem): void => {
      if (
        !modal ||
        !form ||
        !modalTitle ||
        !modalDescription ||
        !saveButton ||
        !skuHelp
      ) {
        return;
      }

      editingSku = item?.sku ?? null;
      form.reset();

      modalTitle.textContent = item ? "Edit stock item" : "Add stock item";

      modalDescription.textContent = item
        ? "Update stock quantity, threshold and item details."
        : "Register a part or supply in your inventory.";

      saveButton.textContent = item ? "Save changes" : "Add stock item";

      const nameInput = form.elements.namedItem("name") as HTMLInputElement;

      const skuInput = form.elements.namedItem("sku") as HTMLInputElement;

      const unitInput = form.elements.namedItem("unit") as HTMLInputElement;

      const stockInput = form.elements.namedItem("stock") as HTMLInputElement;

      const minInput = form.elements.namedItem("min") as HTMLInputElement;

      if (item) {
        nameInput.value = item.name;
        skuInput.value = item.sku;
        skuInput.readOnly = true;
        skuHelp.textContent = "SKU is locked while editing this record.";
        unitInput.value = item.unit;
        stockInput.value = String(item.stock);
        minInput.value = String(item.min);
      } else {
        skuInput.value = "";
        skuInput.readOnly = false;
        skuHelp.textContent = "Use a unique stock-keeping code.";
        stockInput.value = "0";
        minInput.value = "5";
      }

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      modal.hidden = false;

      window.setTimeout(() => nameInput.focus(), 0);
    };

    const closeModal = (): void => {
      if (!modal || !form) return;

      modal.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      editingSku = null;
      form.reset();

      const skuInput = form.elements.namedItem("sku") as HTMLInputElement;

      skuInput.readOnly = false;
    };

    const updateStockQuantity = (sku: string, direction: number): void => {
      const item = getState().inventory.find((entry) => entry.sku === sku);

      if (!item) {
        showFeedback("The inventory item could not be found.", "error");
        return;
      }

      const nextStock = item.stock + direction;

      if (nextStock < 0) {
        showFeedback("Stock quantity cannot be negative.", "error");
        return;
      }

      try {
        const updated = updateInventoryItem(sku, {
          stock: nextStock,
          state: deriveHealth(nextStock, item.min),
        });

        if (updated) {
          showFeedback(
            `${updated.name}: quantity is now ${formatNumber(updated.stock)} ${updated.unit}.`,
          );
        }
      } catch (error) {
        showFeedback(
          error instanceof Error ? error.message : "Unable to adjust stock.",
          "error",
        );
      }
    };

    const removeItem = (sku: string): void => {
      const item = getState().inventory.find((entry) => entry.sku === sku);

      if (!item) {
        showFeedback("The inventory item could not be found.", "error");
        return;
      }

      if (
        !window.confirm(
          `Remove "${item.name}" (${item.sku}) from inventory? This cannot be undone from this screen.`,
        )
      ) {
        return;
      }

      try {
        const deleted = deleteInventoryItem(sku);

        if (deleted) {
          showFeedback(`${item.name} was removed from inventory.`);
        } else {
          showFeedback("The item could not be removed.", "error");
        }
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to remove this item.",
          "error",
        );
      }
    };

    document
      .querySelector<HTMLButtonElement>("#serviq-add-inventory")
      ?.addEventListener("click", () => openModal());

    document
      .querySelector<HTMLButtonElement>("#serviq-inventory-modal-close")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-inventory-cancel")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-inventory-reset")
      ?.addEventListener("click", () => {
        searchInput.value = "";
        healthFilter.value = "all";
        sortSelect.value = "name";
        renderInventory();
      });

    searchInput.addEventListener("input", renderInventory);
    healthFilter.addEventListener("change", renderInventory);
    sortSelect.addEventListener("change", renderInventory);

    list.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("button[data-action]");

      if (!button) return;

      const action = button.dataset.action;
      const sku = button.dataset.sku;

      if (!sku) return;

      if (action === "edit") {
        const item = getState().inventory.find((entry) => entry.sku === sku);

        if (item) openModal(item);
        return;
      }

      if (action === "delete") {
        removeItem(sku);
        return;
      }

      if (action === "adjust") {
        const direction = Number(button.dataset.direction);

        if (direction !== 1 && direction !== -1) return;

        updateStockQuantity(sku, direction);
      }
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) {
        closeModal();
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      const name = String(formData.get("name") ?? "").trim();
      const sku = String(formData.get("sku") ?? "")
        .trim()
        .toUpperCase();
      const unit = String(formData.get("unit") ?? "").trim();
      const stock = Number(formData.get("stock"));
      const min = Number(formData.get("min"));

      if (!name || !sku || !unit) {
        showFeedback("Enter the item name, SKU and unit.", "error");
        return;
      }

      if (
        !Number.isSafeInteger(stock) ||
        !Number.isSafeInteger(min) ||
        stock < 0 ||
        min < 0 ||
        stock > 1000000000 ||
        min > 1000000000
      ) {
        showFeedback(
          "Stock quantity and reorder threshold must be non-negative whole numbers.",
          "error",
        );
        return;
      }

      const payload = {
        name,
        unit,
        stock,
        min,
        state: deriveHealth(stock, min),
      };

      try {
        if (editingSku) {
          const updated = updateInventoryItem(editingSku, payload);

          if (!updated) {
            showFeedback("The inventory item could not be found.", "error");
            return;
          }

          closeModal();
          showFeedback(`${updated.name} was updated successfully.`);
        } else {
          createInventoryItem({
            ...payload,
            sku,
          });

          closeModal();
          showFeedback(`${name} was added to inventory.`);
        }
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to save this inventory item.",
          "error",
        );
      }
    });

    subscribe(() => {
      renderInventory();
    });

    renderInventory();
  }
</script>

<style is:global>
  .serviq-inventory-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 24px;
  }

  .serviq-inventory-metric {
    min-width: 0;
    padding: 21px 22px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.09));
    border-radius: 18px;
    background: var(--panel, #101814);
  }

  .serviq-inventory-metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted, #97a59c);
    font-size: 12px;
    font-weight: 650;
  }

  .serviq-inventory-metric-icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 11px;
    font-size: 16px;
  }

  .serviq-inventory-metric.gold .serviq-inventory-metric-icon {
    color: var(--gold, #d6b568);
    background: rgba(214, 181, 104, 0.08);
  }

  .serviq-inventory-metric.green .serviq-inventory-metric-icon {
    color: #79d9a3;
    background: rgba(121, 217, 163, 0.08);
  }

  .serviq-inventory-metric.amber .serviq-inventory-metric-icon {
    color: #e6c078;
    background: rgba(230, 192, 120, 0.08);
  }

  .serviq-inventory-metric.red .serviq-inventory-metric-icon {
    color: #f09a9a;
    background: rgba(240, 154, 154, 0.08);
  }

  .serviq-inventory-metric > strong {
    display: block;
    margin: 12px 0 5px;
    color: var(--text, #edf3ed);
    font-size: clamp(27px, 2.2vw, 35px);
    font-weight: 680;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .serviq-inventory-metric > small {
    color: var(--muted, #97a59c);
    font-size: 12px;
    line-height: 1.5;
  }

  .serviq-inventory-toolbar {
    display: flex;
    align-items: end;
    gap: 14px;
