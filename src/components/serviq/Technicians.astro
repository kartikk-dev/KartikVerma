---
---

<section class="view serviq-technicians" data-panel="technicians">
  <div class="page-heading">
    <div>
      <span class="eyebrow">RESOURCES / TECHNICIANS</span>
      <h1>
        The field <em>team.</em>
      </h1>
      <p>Manage technician availability, workload and service performance.</p>
    </div>

    <button class="primary-action" id="serviq-add-technician" type="button">
      <span>+</span>
      Add Technician
    </button>
  </div>

  <div
    class="serviq-tech-feedback"
    id="serviq-tech-feedback"
    role="status"
    aria-live="polite"
    hidden
  ></div>

  <section
    class="serviq-tech-summary"
    id="serviq-tech-summary"
    aria-label="Technician team summary"
  ></section>

  <section class="serviq-tech-controls" aria-label="Filter technicians">
    <label class="serviq-tech-search">
      <span aria-hidden="true">⌕</span>
      <input
        id="serviq-tech-search"
        type="search"
        placeholder="Search name, role or zone..."
        autocomplete="off"
        aria-label="Search technicians"
      />
    </label>

    <label class="serviq-tech-filter">
      <span>Status</span>
      <select id="serviq-tech-status">
        <option value="all">All statuses</option>
        <option value="Available">Available</option>
        <option value="Assigned">Assigned</option>
        <option value="En Route">En Route</option>
        <option value="Working">Working</option>
        <option value="Off Duty">Off Duty</option>
      </select>
    </label>

    <label class="serviq-tech-filter">
      <span>Sort by</span>
      <select id="serviq-tech-sort">
        <option value="workload">Open workload</option>
        <option value="name">Name</option>
        <option value="rating">Rating</option>
      </select>
    </label>
  </section>

  <div class="serviq-tech-results-heading">
    <div>
      <span class="panel-label">TEAM DIRECTORY</span>
      <h2>Technician profiles</h2>
    </div>

    <span id="serviq-tech-result-count" class="serviq-tech-result-count">
      Loading team...
    </span>
  </div>

  <section
    class="profile-grid serviq-tech-grid"
    id="serviq-tech-grid"
    aria-label="Technician profiles"
    aria-live="polite"
  ></section>

  <div class="serviq-tech-empty" id="serviq-tech-empty" hidden>
    <span class="serviq-tech-empty-icon" aria-hidden="true">
      ⌕
    </span>
    <h3>No technicians found</h3>
    <p>Try another search or change the selected status filter.</p>
    <button
      type="button"
      class="secondary-action"
      id="serviq-tech-reset-filters"
    >
      Clear filters
    </button>
  </div>
</section>

<div class="serviq-tech-modal" id="serviq-tech-modal" hidden>
  <section
    class="serviq-tech-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="serviq-tech-modal-title"
  >
    <header class="serviq-tech-modal-header">
      <div>
        <span class="eyebrow">TEAM MANAGEMENT</span>
        <h2 id="serviq-tech-modal-title">Add technician</h2>
        <p id="serviq-tech-modal-description">Create a field team profile.</p>
      </div>

      <button
        type="button"
        class="serviq-tech-modal-close"
        id="serviq-tech-modal-close"
        aria-label="Close technician form"
      >
        ×
      </button>
    </header>

    <form id="serviq-tech-form">
      <div class="serviq-tech-form-grid">
        <label class="serviq-tech-field serviq-tech-field-wide">
          <span>
            Full name <b>*</b>
          </span>
          <input
            name="name"
            type="text"
            placeholder="e.g. Rahul Mehta"
            maxlength="100"
            required
          />
        </label>

        <label class="serviq-tech-field serviq-tech-field-wide">
          <span>
            Job role <b>*</b>
          </span>
          <input
            name="role"
            type="text"
            placeholder="e.g. Senior HVAC Technician"
            maxlength="120"
            required
          />
        </label>

        <label class="serviq-tech-field">
          <span>
            Service zone <b>*</b>
          </span>
          <input
            name="zone"
            type="text"
            placeholder="e.g. Rajpur Road"
            maxlength="100"
            required
          />
        </label>

        <label class="serviq-tech-field">
          <span>Availability</span>
          <select name="status" required>
            <option value="Available">Available</option>
            <option value="Assigned">Assigned</option>
            <option value="En Route">En Route</option>
            <option value="Working">Working</option>
            <option value="Off Duty">Off Duty</option>
          </select>
        </label>

        <label class="serviq-tech-field">
          <span>Jobs today</span>
          <input
            name="jobs"
            type="number"
            min="0"
            max="999"
            step="1"
            value="0"
            required
          />
        </label>

        <label class="serviq-tech-field">
          <span>Service rating</span>
          <input
            name="rating"
            type="number"
            min="0"
            max="5"
            step="0.1"
            value="5.0"
            required
          />
        </label>

        <label class="serviq-tech-field serviq-tech-field-wide">
          <span>Profile accent</span>
          <select name="color">
            <option value="gold">Gold</option>
            <option value="green">Green</option>
            <option value="blue">Blue</option>
            <option value="purple">Purple</option>
          </select>
        </label>
      </div>

      <div class="serviq-tech-form-note">
        <span aria-hidden="true">i</span>
        Initials are generated automatically from the technician's name.
      </div>

      <div class="serviq-tech-modal-actions">
        <button type="button" class="secondary-action" id="serviq-tech-cancel">
          Cancel
        </button>

        <button type="submit" class="primary-action" id="serviq-tech-save">
          Add technician
        </button>
      </div>
    </form>
  </section>
</div>

<script>
  import {
    createTechnician,
    deleteTechnician,
    getState,
    subscribe,
    updateTechnician,
    updateWorkOrder,
  } from "../../lib/serviq/store";

  import type { Technician } from "../../data/serviq/technicians";

  const root = document.querySelector<HTMLElement>(".serviq-technicians");

  const grid = document.querySelector<HTMLElement>("#serviq-tech-grid");

  const summary = document.querySelector<HTMLElement>("#serviq-tech-summary");

  const searchInput = document.querySelector<HTMLInputElement>(
    "#serviq-tech-search",
  );

  const statusFilter = document.querySelector<HTMLSelectElement>(
    "#serviq-tech-status",
  );

  const sortSelect =
    document.querySelector<HTMLSelectElement>("#serviq-tech-sort");

  const resultCount = document.querySelector<HTMLElement>(
    "#serviq-tech-result-count",
  );

  const emptyState = document.querySelector<HTMLElement>("#serviq-tech-empty");

  const modal = document.querySelector<HTMLElement>("#serviq-tech-modal");

  const form = document.querySelector<HTMLFormElement>("#serviq-tech-form");

  const modalTitle = document.querySelector<HTMLElement>(
    "#serviq-tech-modal-title",
  );

  const modalDescription = document.querySelector<HTMLElement>(
    "#serviq-tech-modal-description",
  );

  const saveButton =
    document.querySelector<HTMLButtonElement>("#serviq-tech-save");

  const feedback = document.querySelector<HTMLElement>("#serviq-tech-feedback");

  if (
    root &&
    grid &&
    summary &&
    searchInput &&
    statusFilter &&
    sortSelect &&
    resultCount &&
    emptyState &&
    modal &&
    form &&
    modalTitle &&
    modalDescription &&
    saveButton &&
    feedback
  ) {
    type StatusOption =
      "Available" | "Assigned" | "En Route" | "Working" | "Off Duty";

    const statusOptions: StatusOption[] = [
      "Available",
      "Assigned",
      "En Route",
      "Working",
      "Off Duty",
    ];

    const colorOptions = ["gold", "green", "blue", "purple"] as const;

    type TechnicianColor = (typeof colorOptions)[number];

    let editingTechnicianId: string | null = null;
    let previousBodyOverflow = "";
    let feedbackTimeout: ReturnType<typeof setTimeout> | undefined;

    const escapeHtml = (value: unknown): string =>
      String(value ?? "").replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        };

        return entities[character] ?? character;
      });

    const getInitials = (name: string): string =>
      name
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "ST";

    const normaliseColor = (color: string): TechnicianColor =>
      colorOptions.includes(color as TechnicianColor)
        ? (color as TechnicianColor)
        : "gold";

    const isClosedOrder = (status: string): boolean =>
      [
        "completed",
        "complete",
        "closed",
        "cancelled",
        "canceled",
        "invoiced",
        "paid",
      ].includes(status.trim().toLowerCase());

    const getOpenAssignments = (technicianId: string): number => {
      return getState().workOrders.filter(
        (order) =>
          order.technicianId === technicianId && !isClosedOrder(order.status),
      ).length;
    };

    const getStatusClass = (status: string): string => {
      switch (status.trim().toLowerCase()) {
        case "available":
          return "available";
        case "en route":
          return "route";
        case "working":
          return "working";
        case "assigned":
          return "assigned";
        default:
          return "off-duty";
      }
    };

    const showFeedback = (
      message: string,
      kind: "success" | "error" = "success",
    ): void => {
      if (!feedback) return;

      if (feedbackTimeout) {
        clearTimeout(feedbackTimeout);
      }

      feedback.textContent = message;
      feedback.className = `serviq-tech-feedback ${kind}`;
      feedback.hidden = false;

      feedbackTimeout = setTimeout(() => {
        if (feedback) feedback.hidden = true;
      }, 4000);
    };

    const renderSummary = (technicians: Technician[]): void => {
      const available = technicians.filter(
        (technician) => technician.status === "Available",
      ).length;

      const inField = technicians.filter((technician) =>
        ["Working", "En Route", "Assigned"].includes(technician.status),
      ).length;

      const openAssignments = technicians.reduce(
        (total, technician) => total + getOpenAssignments(technician.id),
        0,
      );

      const metrics = [
        {
          label: "Total technicians",
          value: technicians.length,
          note: "Registered team members",
          accent: "gold",
          icon: "◎",
        },
        {
          label: "Available now",
          value: available,
          note: "Ready for dispatch",
          accent: "green",
          icon: "✓",
        },
        {
          label: "Active in field",
          value: inField,
          note: "Working, assigned or en route",
          accent: "blue",
          icon: "↗",
        },
        {
          label: "Open assignments",
          value: openAssignments,
          note: "Across the current team",
          accent: "purple",
          icon: "▤",
        },
      ];

      summary.innerHTML = metrics
        .map(
          (metric) => `
            <article class="serviq-tech-metric ${metric.accent}">
              <div class="serviq-tech-metric-top">
                <span>${escapeHtml(metric.label)}</span>
                <span class="serviq-tech-metric-icon" aria-hidden="true">${metric.icon}</span>
              </div>
              <strong>${metric.value}</strong>
              <small>${escapeHtml(metric.note)}</small>
            </article>
          `,
        )
        .join("");
    };

    const renderTechnicians = (): void => {
      if (!grid || !summary || !resultCount || !emptyState) {
        return;
      }

      const technicians = getState().technicians;
      const query = searchInput.value.trim().toLowerCase();
      const selectedStatus = statusFilter.value;
      const selectedSort = sortSelect.value;

      renderSummary(technicians);

      const filtered = technicians.filter((technician) => {
        const matchesSearch = [
          technician.name,
          technician.role,
          technician.zone,
          technician.status,
        ].some((value) =>
          String(value ?? "")
            .toLowerCase()
            .includes(query),
        );

        const matchesStatus =
          selectedStatus === "all" || technician.status === selectedStatus;

        return matchesSearch && matchesStatus;
      });

      filtered.sort((first, second) => {
        if (selectedSort === "name") {
          return first.name.localeCompare(second.name);
        }

        if (selectedSort === "rating") {
          return second.rating - first.rating;
        }

        return getOpenAssignments(second.id) - getOpenAssignments(first.id);
      });

      resultCount.textContent = `${filtered.length} of ${technicians.length} technician${technicians.length === 1 ? "" : "s"}`;

      emptyState.hidden = filtered.length > 0;
      grid.hidden = filtered.length === 0;

      grid.innerHTML = filtered
        .map((technician) => {
          const color = normaliseColor(technician.color);
          const statusClass = getStatusClass(technician.status);
          const openAssignments = getOpenAssignments(technician.id);
          const loadPercent = Math.min(
            100,
            Math.round((openAssignments / 5) * 100),
          );

          const statuses = [...new Set([...statusOptions, technician.status])];

          const statusMarkup = statuses
            .map(
              (status) => `
                <option
                  value="${escapeHtml(status)}"
                  ${technician.status === status ? "selected" : ""}
                >${escapeHtml(status)}</option>
              `,
            )
            .join("");

          return `
            <article
              class="profile-card serviq-tech-card"
              data-tech-card="${escapeHtml(technician.id)}"
            >
              <div class="profile-card-top">
                <span class="tech-avatar large ${color}">
                  ${escapeHtml(technician.initials || getInitials(technician.name))}
                </span>

                <span class="serviq-tech-rating" aria-label="Rating ${escapeHtml(technician.rating)} out of 5">
                  <span aria-hidden="true">★</span>
                  ${Number(technician.rating).toFixed(1)}
                </span>
              </div>

              <h3>${escapeHtml(technician.name)}</h3>
              <p class="serviq-tech-role">${escapeHtml(technician.role)}</p>

              <div class="serviq-tech-status-row">
                <span class="profile-status">
                  <i class="${statusClass}"></i>
                  ${escapeHtml(technician.status)}
                </span>
              </div>

              <div class="serviq-tech-stats">
                <div>
                  <span>JOBS TODAY</span>
                  <strong>${Number(technician.jobs) || 0}</strong>
                </div>
                <div>
                  <span>OPEN JOBS</span>
                  <strong>${openAssignments}</strong>
                </div>
                <div>
                  <span>SERVICE ZONE</span>
                  <strong title="${escapeHtml(technician.zone)}">${escapeHtml(technician.zone)}</strong>
                </div>
              </div>

              <div class="serviq-tech-workload">
                <div class="serviq-tech-workload-label">
                  <span>Current workload</span>
                  <strong>${openAssignments} open</strong>
                </div>
                <div
                  class="serviq-tech-workload-track"
                  role="progressbar"
                  aria-label="Open assignments"
                  aria-valuemin="0"
                  aria-valuemax="5"
                  aria-valuenow="${Math.min(openAssignments, 5)}"
                >
                  <span style="width: ${loadPercent}%"></span>
                </div>
              </div>

              <label class="serviq-tech-availability">
                <span>Change availability</span>
                <select
                  data-action="status"
                  data-tech-id="${escapeHtml(technician.id)}"
                  aria-label="Change availability for ${escapeHtml(technician.name)}"
                >
                  ${statusMarkup}
                </select>
              </label>

              <div class="serviq-tech-card-actions">
                <button
                  type="button"
                  class="secondary-action"
                  data-action="edit"
                  data-tech-id="${escapeHtml(technician.id)}"
                >
                  Edit profile
                </button>

                <button
                  type="button"
                  class="serviq-tech-delete"
                  data-action="delete"
                  data-tech-id="${escapeHtml(technician.id)}"
                  aria-label="Remove ${escapeHtml(technician.name)}"
                >
                  Remove
                </button>
              </div>
            </article>
          `;
        })
        .join("");
    };

    const openModal = (technician?: Technician): void => {
      if (!modal || !form || !modalTitle || !modalDescription || !saveButton) {
        return;
      }

      editingTechnicianId = technician?.id ?? null;

      form.reset();

      modalTitle.textContent = technician
        ? "Edit technician"
        : "Add technician";

      modalDescription.textContent = technician
        ? "Update this team member's profile and availability."
        : "Create a new field team profile.";

      saveButton.textContent = technician ? "Save changes" : "Add technician";

      const nameInput = form.elements.namedItem("name") as HTMLInputElement;

      const roleInput = form.elements.namedItem("role") as HTMLInputElement;

      const zoneInput = form.elements.namedItem("zone") as HTMLInputElement;

      const statusInput = form.elements.namedItem(
        "status",
      ) as HTMLSelectElement;

      const jobsInput = form.elements.namedItem("jobs") as HTMLInputElement;

      const ratingInput = form.elements.namedItem("rating") as HTMLInputElement;

      const colorInput = form.elements.namedItem("color") as HTMLSelectElement;

      if (technician) {
        nameInput.value = technician.name;
        roleInput.value = technician.role;
        zoneInput.value = technician.zone;
        statusInput.value = technician.status;
        jobsInput.value = String(technician.jobs);
        ratingInput.value = String(technician.rating);
        colorInput.value = normaliseColor(technician.color);
      } else {
        statusInput.value = "Available";
        jobsInput.value = "0";
        ratingInput.value = "5.0";
        colorInput.value = "gold";
      }

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      modal.hidden = false;

      window.setTimeout(() => {
        nameInput.focus();
      }, 0);
    };

    const closeModal = (): void => {
      if (!modal || !form) return;

      modal.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      editingTechnicianId = null;
      form.reset();
    };

    const removeTechnician = (id: string): void => {
      const state = getState();
      const technician = state.technicians.find((item) => item.id === id);

      if (!technician) {
        showFeedback("This technician could not be found.", "error");
        return;
      }

      const activeOrders = state.workOrders.filter(
        (order) => order.technicianId === id && !isClosedOrder(order.status),
      );

      const confirmationMessage =
        activeOrders.length > 0
          ? `Remove ${technician.name} from the team? ${activeOrders.length} active work order(s) will be returned to Unassigned.`
          : `Remove ${technician.name} from the team?`;

      if (!window.confirm(confirmationMessage)) {
        return;
      }

      try {
        for (const order of activeOrders) {
          updateWorkOrder(order.id, {
            technicianId: "unassigned",
            technician: "Unassigned",
            status: "New",
          });
        }

        deleteTechnician(id);

        showFeedback(
          activeOrders.length > 0
            ? `${technician.name} removed. ${activeOrders.length} active work order(s) returned to Unassigned.`
            : `${technician.name} removed from the team.`,
        );
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to remove this technician.",
          "error",
        );
      }
    };

    document
      .querySelector<HTMLButtonElement>("#serviq-add-technician")
      ?.addEventListener("click", () => openModal());

    document
      .querySelector<HTMLButtonElement>("#serviq-tech-modal-close")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-tech-cancel")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-tech-reset-filters")
      ?.addEventListener("click", () => {
        searchInput.value = "";
        statusFilter.value = "all";
        sortSelect.value = "workload";
        renderTechnicians();
      });

    searchInput.addEventListener("input", renderTechnicians);
    statusFilter.addEventListener("change", renderTechnicians);
    sortSelect.addEventListener("change", renderTechnicians);

    grid.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      const actionButton = target.closest<HTMLButtonElement>(
        "button[data-action]",
      );

      if (!actionButton) return;

      const action = actionButton.dataset.action;
      const id = actionButton.dataset.techId;

      if (!id) return;

      if (action === "edit") {
        const technician = getState().technicians.find(
          (item) => item.id === id,
        );

        if (technician) {
          openModal(technician);
        }

        return;
      }

      if (action === "delete") {
        removeTechnician(id);
      }
    });

    grid.addEventListener("change", (event) => {
      const target = event.target;

      if (
        !(target instanceof HTMLSelectElement) ||
        target.dataset.action !== "status"
      ) {
        return;
      }

      const id = target.dataset.techId;

      if (!id) return;

      try {
        const updated = updateTechnician(id, {
          status: target.value,
        });

        if (updated) {
          showFeedback(
            `${updated.name}'s availability changed to ${updated.status}.`,
          );
        } else {
          showFeedback("The technician could not be found.", "error");
        }
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to update technician availability.",
          "error",
        );

        renderTechnicians();
      }
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) {
        closeModal();
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      const name = String(formData.get("name") ?? "").trim();
      const role = String(formData.get("role") ?? "").trim();
      const zone = String(formData.get("zone") ?? "").trim();
      const status = String(formData.get("status") ?? "");
      const jobs = Number(formData.get("jobs"));
      const rating = Number(formData.get("rating"));
      const color = normaliseColor(String(formData.get("color") ?? "gold"));

      if (!name || !role || !zone) {
        showFeedback(
          "Enter the technician's name, role and service zone.",
          "error",
        );
        return;
      }

      if (
        !Number.isInteger(jobs) ||
        jobs < 0 ||
        jobs > 999 ||
        !Number.isFinite(rating) ||
        rating < 0 ||
        rating > 5
      ) {
        showFeedback(
          "Enter a valid jobs count and a rating between 0 and 5.",
          "error",
        );
        return;
      }

      const payload = {
        name,
        initials: getInitials(name),
        role,
        status,
        zone,
        jobs,
        rating: Math.round(rating * 10) / 10,
        color,
      };

      try {
        if (editingTechnicianId) {
          const updated = updateTechnician(editingTechnicianId, payload);

          if (!updated) {
            showFeedback("This technician could not be found.", "error");
            return;
          }

          closeModal();
          showFeedback(`${name}'s profile has been updated.`);
        } else {
          createTechnician(payload);
          closeModal();
          showFeedback(`${name} has been added to the team.`);
        }
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to save this technician.",
          "error",
        );
      }
    });

    subscribe(() => {
      renderTechnicians();
    });

    renderTechnicians();
  }
</script>

<style is:global>
  .serviq-tech-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 24px;
  }

  .serviq-tech-metric {
    min-width: 0;
    padding: 21px 22px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.09));
    border-radius: 18px;
    background: var(--panel, #101814);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .serviq-tech-metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
