---
---

<div class="work-order-modal-root" id="modal-root" hidden>
  <button
    type="button"
    class="modal-backdrop"
    id="modal-backdrop"
    aria-label="Close work order details"
  ></button>

  <section
    class="work-order-modal serviq-wo-detail-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <header class="modal-header">
      <div>
        <span class="eyebrow">WORK ORDER DETAILS</span>
        <h2 id="modal-title">WO-0000</h2>
        <p id="modal-subtitle">Service details</p>
      </div>

      <button
        type="button"
        class="modal-close"
        id="modal-close"
        aria-label="Close work order details"
      >
        ×
      </button>
    </header>

    <div class="serviq-wo-detail-status-row">
      <span id="modal-priority" class="serviq-wo-detail-priority">
        Medium priority
      </span>
      <span id="modal-status" class="status-badge">
        <i></i>New
      </span>
    </div>

    <div class="modal-grid">
      <div class="modal-section">
        <span>JOB DETAILS</span>

        <div class="detail-row">
          <small>Customer</small>
          <strong id="modal-customer">-</strong>
        </div>

        <div class="detail-row">
          <small>Location</small>
          <strong id="modal-location">-</strong>
        </div>

        <div class="detail-row">
          <small>Technician</small>
          <strong id="modal-technician">Unassigned</strong>
        </div>

        <div class="detail-row">
          <small>Scheduled</small>
          <strong id="modal-scheduled">-</strong>
        </div>

        <div class="detail-row">
          <small>Created</small>
          <strong id="modal-created">-</strong>
        </div>
      </div>

      <div class="modal-section">
        <span>FINANCIAL</span>

        <div class="modal-amount">
          <small>ESTIMATED TOTAL</small>
          <strong id="modal-amount">₹0</strong>
        </div>

        <div class="detail-row">
          <small>Category</small>
          <strong id="serviq-modal-category">-</strong>
        </div>

        <div class="detail-row">
          <small>Work order ID</small>
          <strong id="serviq-modal-id">-</strong>
        </div>
      </div>
    </div>

    <div class="modal-section issue-section">
      <span>CUSTOMER ISSUE</span>
      <p id="modal-issue">No issue details provided.</p>
    </div>

    <div class="serviq-wo-detail-actions">
      <button type="button" class="modal-secondary" id="modal-reassign">
        Edit / Reassign
      </button>
      <button type="button" class="modal-secondary" id="modal-invoice">
        Go to Invoices
      </button>
      <button type="button" class="modal-primary" id="modal-next">
        Move to next status →
      </button>
    </div>

    <button
      type="button"
      class="serviq-wo-delete"
      id="serviq-delete-work-order"
    >
      Delete work order
    </button>
  </section>
</div>

<div class="serviq-wo-editor-overlay" id="serviq-wo-editor" hidden>
  <section
    class="serviq-wo-editor-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="serviq-wo-editor-title"
  >
    <header class="serviq-wo-editor-header">
      <div>
        <span class="eyebrow">WORK ORDER MANAGEMENT</span>
        <h2 id="serviq-wo-editor-title">New work order</h2>
        <p id="serviq-wo-editor-description">
          Create a service record for your team.
        </p>
      </div>

      <button
        type="button"
        class="serviq-wo-editor-close"
        id="serviq-wo-editor-close"
        aria-label="Close work order form"
      >
        ×
      </button>
    </header>

    <form id="serviq-wo-form">
      <div class="serviq-wo-form-grid">
        <label class="serviq-wo-field serviq-wo-field-wide">
          <span>
            Customer name <b>*</b>
          </span>
          <input
            name="customer"
            type="text"
            maxlength="120"
            placeholder="e.g. Arun Sharma"
            required
          />
        </label>

        <label class="serviq-wo-field serviq-wo-field-wide">
          <span>
            Service <b>*</b>
          </span>
          <input
            name="service"
            type="text"
            maxlength="140"
            placeholder="e.g. AC Repair"
            required
          />
        </label>

        <label class="serviq-wo-field">
          <span>
            Category <b>*</b>
          </span>
          <input
            name="category"
            type="text"
            maxlength="80"
            placeholder="e.g. HVAC"
            required
          />
        </label>

        <label class="serviq-wo-field">
          <span>Priority</span>
          <select name="priority">
            <option value="Urgent">Urgent</option>
            <option value="High">High</option>
            <option value="Medium" selected>
              Medium
            </option>
            <option value="Low">Low</option>
          </select>
        </label>

        <label class="serviq-wo-field serviq-wo-field-wide">
          <span>
            Service location <b>*</b>
          </span>
          <input
            name="location"
            type="text"
            maxlength="180"
            placeholder="Area, city or complete service address"
            required
          />
        </label>

        <label class="serviq-wo-field">
          <span>Assign technician</span>
          <select name="technicianId" id="serviq-wo-technician">
            <option value="unassigned">Unassigned</option>
          </select>
        </label>

        <label class="serviq-wo-field">
          <span>Status</span>
          <select name="status">
            <option value="New">New</option>
            <option value="Assigned">Assigned</option>
            <option value="Accepted">Accepted</option>
            <option value="En Route">En Route</option>
            <option value="Arrived">Arrived</option>
            <option value="Diagnosing">Diagnosing</option>
            <option value="In Progress">In Progress</option>
            <option value="Waiting for Parts">Waiting for Parts</option>
            <option value="Completed">Completed</option>
            <option value="Invoiced">Invoiced</option>
            <option value="Paid">Paid</option>
            <option value="Cancelled">Cancelled</option>
          </select>
        </label>

        <label class="serviq-wo-field">
          <span>Scheduled time</span>
          <input
            name="scheduled"
            type="text"
            maxlength="80"
            placeholder="e.g. 02:30 PM"
          />
        </label>

        <label class="serviq-wo-field">
          <span>
            Estimated amount (₹) <b>*</b>
          </span>
          <input
            name="amount"
            type="number"
            min="0"
            max="100000000000"
            step="1"
            value="0"
            required
          />
        </label>

        <label class="serviq-wo-field serviq-wo-field-wide">
          <span>
            Customer issue <b>*</b>
          </span>
          <textarea
            name="issue"
            rows="3"
            maxlength="1200"
            placeholder="Describe the reported service issue..."
            required
          ></textarea>
        </label>
      </div>

      <div class="serviq-wo-form-note">
        <span aria-hidden="true">i</span>
        This prototype stores changes in browser storage. It does not dispatch
        real technicians or contact customers.
      </div>

      <div class="serviq-wo-editor-actions">
        <button
          type="button"
          class="secondary-action"
          id="serviq-wo-editor-cancel"
        >
          Cancel
        </button>
        <button type="submit" class="primary-action" id="serviq-wo-editor-save">
          Create Work Order
        </button>
      </div>
    </form>
  </section>
</div>

<script>
  import {
    createWorkOrder,
    deleteWorkOrder,
    getState,
    subscribe,
    updateWorkOrder,
  } from "../../lib/serviq/store";

  import type { WorkOrder } from "../../data/serviq/workOrders";

  const detailRoot = document.querySelector<HTMLElement>("#modal-root");
  const detailBackdrop =
    document.querySelector<HTMLButtonElement>("#modal-backdrop");
  const detailClose = document.querySelector<HTMLButtonElement>("#modal-close");
  const editorRoot = document.querySelector<HTMLElement>("#serviq-wo-editor");
  const form = document.querySelector<HTMLFormElement>("#serviq-wo-form");
  const technicianSelect = document.querySelector<HTMLSelectElement>(
    "#serviq-wo-technician",
  );
  const editorTitle = document.querySelector<HTMLElement>(
    "#serviq-wo-editor-title",
  );
  const editorDescription = document.querySelector<HTMLElement>(
    "#serviq-wo-editor-description",
  );
  const editorSave = document.querySelector<HTMLButtonElement>(
    "#serviq-wo-editor-save",
  );

  if (
    detailRoot &&
    detailBackdrop &&
    detailClose &&
    editorRoot &&
    form &&
    technicianSelect &&
    editorTitle &&
    editorDescription &&
    editorSave
  ) {
    let activeWorkOrderId: string | null = null;
    let editingWorkOrderId: string | null = null;
    let previousBodyOverflow = "";

    const statusFlow = [
      "New",
      "Assigned",
      "Accepted",
      "En Route",
      "Arrived",
      "Diagnosing",
      "In Progress",
      "Waiting for Parts",
      "Completed",
      "Invoiced",
      "Paid",
    ];

    const closedStatuses = ["Completed", "Invoiced", "Paid", "Cancelled"];

    const escapeHtml = (value: unknown): string =>
      String(value ?? "").replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        };
        return entities[character] ?? character;
      });

    const formatCurrency = (amount: number): string =>
      new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0,
      }).format(amount);

    const statusClass = (status: string): string =>
      `status-${status.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

    const notify = (
      message: string,
      kind: "success" | "error" = "success",
    ): void => {
      document.dispatchEvent(
        new CustomEvent("serviq:toast", {
          detail: { message, kind },
        }),
      );
    };

    const setText = (selector: string, value: string): void => {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };

    const setDetailStatus = (order: WorkOrder): void => {
      const statusElement =
        document.querySelector<HTMLElement>("#modal-status");

      if (!statusElement) return;

      statusElement.className = `status-badge ${statusClass(order.status)}`;
      statusElement.innerHTML = `<i></i>${escapeHtml(order.status)}`;
    };

    const renderDetail = (order: WorkOrder): void => {
      activeWorkOrderId = order.id;

      setText("#modal-title", order.id);
      setText("#modal-subtitle", order.service);
      setText("#modal-priority", `${order.priority} priority`);
      setText("#modal-customer", order.customer);
      setText("#modal-location", order.location);
      setText("#modal-technician", order.technician || "Unassigned");
      setText("#modal-scheduled", order.scheduled || "Not scheduled");
      setText("#modal-created", order.created || "-");
      setText("#modal-amount", formatCurrency(order.amount));
      setText("#modal-issue", order.issue || "No issue details provided.");
      setText("#serviq-modal-category", order.category || "-");
      setText("#serviq-modal-id", order.id);

      setDetailStatus(order);

      const nextButton =
        document.querySelector<HTMLButtonElement>("#modal-next");

      if (nextButton) {
        const currentIndex = statusFlow.indexOf(order.status);
        const nextStatus =
          currentIndex < 0 ? undefined : statusFlow[currentIndex + 1];

        nextButton.disabled =
          !nextStatus || closedStatuses.includes(order.status);
        nextButton.textContent = nextStatus
          ? `Move to ${nextStatus} →`
          : "No next status";
      }
    };

    const openDetail = (id: string): void => {
      const order = getState().workOrders.find((item) => item.id === id);
      if (!order) {
        notify("This work order is no longer available.", "error");
        return;
      }

      activeWorkOrderId = id;
      renderDetail(order);

      if (editorRoot) editorRoot.hidden = true;

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      detailRoot.hidden = false;

      window.requestAnimationFrame(() => {
        detailRoot.classList.add("show");
      });
    };

    const closeDetail = (): void => {
      detailRoot.classList.remove("show");
      document.body.style.overflow = previousBodyOverflow;

      window.setTimeout(() => {
        detailRoot.hidden = true;
      }, 180);

      activeWorkOrderId = null;
    };

    const populateTechnicians = (selectedId = "unassigned"): void => {
      const technicians = getState().technicians;

      technicianSelect.innerHTML = `
        <option value="unassigned">Unassigned</option>
        ${technicians
          .map(
            (tech) => `
          <option value="${escapeHtml(tech.id)}">
            ${escapeHtml(tech.name)} - ${escapeHtml(tech.status)}
          </option>
        `,
          )
          .join("")}
      `;

      technicianSelect.value = technicians.some(
        (tech) => tech.id === selectedId,
      )
        ? selectedId
        : "unassigned";
    };

    const openEditor = (order?: WorkOrder): void => {
      editingWorkOrderId = order?.id ?? null;
      form.reset();
      populateTechnicians(order?.technicianId ?? "unassigned");

      editorTitle.textContent = order ? "Edit work order" : "New work order";
      editorDescription.textContent = order
        ? "Update the job details, assignment or status."
        : "Create a new operational service record.";
      editorSave.textContent = order ? "Save Changes" : "Create Work Order";

      const field = (
        name: string,
      ): HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement =>
        form.elements.namedItem(name) as
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

      field("customer").value = order?.customer ?? "";
      field("service").value = order?.service ?? "";
      field("category").value = order?.category ?? "";
      field("priority").value = order?.priority ?? "Medium";
      field("location").value = order?.location ?? "";
      field("status").value = order?.status ?? "New";
      field("scheduled").value = order?.scheduled ?? "";
      field("amount").value = String(order?.amount ?? 0);
      field("issue").value = order?.issue ?? "";

      if (detailRoot && !detailRoot.hidden) {
        detailRoot.hidden = true;
        detailRoot.classList.remove("show");
      }

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      editorRoot.hidden = false;

      window.setTimeout(() => field("customer").focus(), 0);
    };

    const closeEditor = (): void => {
      editorRoot.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      editingWorkOrderId = null;
      form.reset();
    };

    const openEditFromDetail = (): void => {
      const order = getState().workOrders.find(
        (item) => item.id === activeWorkOrderId,
      );

      if (order) openEditor(order);
    };

    const openInvoiceView = (): void => {
      closeDetail();

      const invoicesNav = document.querySelector<HTMLButtonElement>(
        '.nav-item[data-view="invoices"]',
      );

      if (invoicesNav) {
        invoicesNav.click();
      } else {
        notify("Open Invoices from the navigation to manage billing.");
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const newOrderButton = target.closest<HTMLButtonElement>(
        "#new-work-order, #new-work-order-2",
      );

      if (newOrderButton) {
        openEditor();
        return;
      }

      const editButton = target.closest<HTMLButtonElement>(
        "[data-edit-work-order]",
      );

      if (editButton) {
        const id = editButton.dataset.editWorkOrder;
        const order = getState().workOrders.find((item) => item.id === id);
        if (order) openEditor(order);
        return;
      }

      const detailButton = target.closest<HTMLElement>(
        ".work-order-trigger[data-work-order]",
      );

      if (detailButton) {
        const id = detailButton.dataset.workOrder;
        if (id) openDetail(id);
      }
    });

    detailClose.addEventListener("click", closeDetail);
    detailBackdrop.addEventListener("click", closeDetail);

    document
      .querySelector<HTMLButtonElement>("#modal-reassign")
      ?.addEventListener("click", openEditFromDetail);

    document
      .querySelector<HTMLButtonElement>("#modal-invoice")
      ?.addEventListener("click", openInvoiceView);

    document
      .querySelector<HTMLButtonElement>("#serviq-wo-editor-close")
      ?.addEventListener("click", closeEditor);

    document
      .querySelector<HTMLButtonElement>("#serviq-wo-editor-cancel")
      ?.addEventListener("click", closeEditor);

    document
      .querySelector<HTMLButtonElement>("#modal-next")
      ?.addEventListener("click", () => {
        if (!activeWorkOrderId) return;

        const order = getState().workOrders.find(
          (item) => item.id === activeWorkOrderId,
        );

        if (!order) return;

        const currentIndex = statusFlow.indexOf(order.status);
        const nextStatus = statusFlow[currentIndex + 1];

        if (!nextStatus || closedStatuses.includes(order.status)) {
          notify("This work order is already at a final status.");
          return;
        }

        try {
          const updated = updateWorkOrder(order.id, { status: nextStatus });

          if (updated) {
            renderDetail(updated);
            notify(`${updated.id} moved to ${updated.status}.`);
          }
        } catch (error) {
          notify(
            error instanceof Error
              ? error.message
              : "Could not update the status.",
            "error",
          );
        }
      });

    document
      .querySelector<HTMLButtonElement>("#serviq-delete-work-order")
      ?.addEventListener("click", () => {
        if (!activeWorkOrderId) return;

        const order = getState().workOrders.find(
          (item) => item.id === activeWorkOrderId,
        );

        if (!order) return;

        if (!window.confirm(`Delete ${order.id} for ${order.customer}?`))
          return;

        try {
          const deleted = deleteWorkOrder(order.id);

          if (deleted) {
            closeDetail();
            notify(`${order.id} was deleted.`);
          } else {
            notify("The work order could not be deleted.", "error");
          }
        } catch (error) {
          notify(
            error instanceof Error
              ? error.message
              : "Could not delete work order.",
            "error",
          );
        }
      });

    editorRoot.addEventListener("click", (event) => {
      if (event.target === editorRoot) closeEditor();
    });

    detailRoot.addEventListener("click", (event) => {
      if (event.target === detailRoot) closeDetail();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      if (!editorRoot.hidden) closeEditor();
      else if (!detailRoot.hidden) closeDetail();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const technicianId = String(data.get("technicianId") ?? "unassigned");
      const technician = getState().technicians.find(
        (item) => item.id === technicianId,
      );

      const customer = String(data.get("customer") ?? "").trim();
      const service = String(data.get("service") ?? "").trim();
      const category = String(data.get("category") ?? "").trim();
      const location = String(data.get("location") ?? "").trim();
      const priority = String(data.get("priority") ?? "Medium");
      const status = String(data.get("status") ?? "New");
      const scheduled = String(data.get("scheduled") ?? "").trim();
      const amount = Number(data.get("amount"));
      const issue = String(data.get("issue") ?? "").trim();

      if (!customer || !service || !category || !location || !issue) {
        notify("Complete all required fields before saving.", "error");
        return;
      }

      if (!Number.isFinite(amount) || amount < 0 || amount > 100000000000) {
        notify("Enter a valid non-negative amount.", "error");
        return;
      }

      const payload = {
        customer,
        service,
        category,
        location,
        technician: technician?.name ?? "Unassigned",
        technicianId: technician?.id ?? "unassigned",
        status,
        priority,
        scheduled,
        amount: Math.round(amount),
        issue,
      };

      try {
        if (editingWorkOrderId) {
          const updated = updateWorkOrder(editingWorkOrderId, payload);

          if (!updated) {
            notify("This work order could not be found.", "error");
            return;
          }

          closeEditor();
          notify(`${updated.id} was updated successfully.`);
        } else {
          const createdText = `Today, ${new Intl.DateTimeFormat("en-IN", {
            hour: "2-digit",
            minute: "2-digit",
          }).format(new Date())}`;

          const created = createWorkOrder({
            ...payload,
            created: createdText,
          });

          closeEditor();
          notify(`${created.id} was created successfully.`);
        }
      } catch (error) {
        notify(
          error instanceof Error ? error.message : "Could not save work order.",
          "error",
        );
      }
    });

    subscribe(() => {
      if (activeWorkOrderId && !detailRoot.hidden) {
        const order = getState().workOrders.find(
          (item) => item.id === activeWorkOrderId,
        );

        if (order) renderDetail(order);
        else closeDetail();
      }

      if (!editorRoot.hidden) {
        populateTechnicians(technicianSelect.value);
      }
    });
  }
</script>

<style is:global>
  .work-order-modal-root[hidden],
  .serviq-wo-editor-overlay[hidden] {
    display: none !important;
  }

  .work-order-modal-root {
    position: fixed;
    z-index: 9000;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: auto;
    padding: 24px;
  }

  .work-order-modal-root .modal-backdrop {
    position: fixed;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(1, 6, 4, 0.78);
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    cursor: default;
  }

  .serviq-wo-detail-modal {
    position: relative;
    z-index: 1;
    width: min(100%, 760px);
    max-height: min(90vh, 850px);
    overflow: auto;
    padding: 28px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 20px;
    background: var(--panel, #101814);
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(10px) scale(0.99);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .work-order-modal-root.show .serviq-wo-detail-modal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .serviq-wo-detail-modal .modal-header,
  .serviq-wo-editor-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .serviq-wo-detail-modal .modal-header h2,
  .serviq-wo-editor-header h2 {
    margin: 8px 0 6px;
    color: var(--text, #edf3ed);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .serviq-wo-detail-modal .modal-header p,
  .serviq-wo-editor-header p {
    margin: 0;
    color: var(--muted, #97a59c);
    font-size: 13px;
    line-height: 1.5;
  }

  .serviq-wo-detail-modal .modal-close,
  .serviq-wo-editor-close {
    display: grid;
    width: 39px;
    height: 39px;
    flex: 0 0 39px;
    place-items: center;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 11px;
    color: var(--text, #edf3ed);
    background: rgba(255, 255, 255, 0.025);
    font: inherit;
    font-size: 24px;
    cursor: pointer;
  }

  .serviq-wo-detail-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .serviq-wo-detail-priority {
    padding: 7px 10px;
    border: 1px solid rgba(214, 181, 104, 0.2);
    border-radius: 8px;
    color: var(--gold, #d6b568);
    font-size: 11px;
    font-weight: 700;
  }

  .serviq-wo-detail-modal .modal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
