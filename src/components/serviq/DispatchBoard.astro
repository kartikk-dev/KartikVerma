---
---

<div class="dispatch-board full-panel">
  <div class="panel-heading">
    <div>
      <span class="panel-label">DISPATCH BOARD</span>
      <h2>Thursday operations</h2>
    </div>

    <span class="live-pill">
      <i></i>
      Updating live
    </span>
  </div>

  <div class="dispatch-columns">
    <div class="dispatch-column">
      <div class="column-heading">
        <span>UNASSIGNED</span>
        <b>2</b>
      </div>

      <div class="dispatch-work-card">
        <span>WO-1053</span>
        <strong>Electrical Inspection</strong>
        <small>Sahastradhara Road</small>

        <button type="button" data-assign="WO-1053">
          Assign technician
        </button>
      </div>

      <div class="dispatch-work-card">
        <span>WO-1054</span>
        <strong>AC Installation</strong>
        <small>Kaulagarh</small>

        <button type="button" data-assign="WO-1054">
          Assign technician
        </button>
      </div>
    </div>

    <div class="dispatch-column">
      <div class="column-heading">
        <span>EN ROUTE</span>
        <b>2</b>
      </div>

      <div class="dispatch-work-card active-route">
        <span>WO-1049</span>
        <strong>Washing Machine Repair</strong>
        <small>Aman · 11 min away</small>

        <div class="mini-route-line">
          <i></i>
          <span>Moving to customer</span>
        </div>
      </div>

      <div class="dispatch-work-card active-route">
        <span>WO-1047</span>
        <strong>AC Gas Recharge</strong>
        <small>Rahul · 7 min away</small>

        <div class="mini-route-line">
          <i></i>
          <span>Moving to customer</span>
        </div>
      </div>
    </div>

    <div class="dispatch-column">
      <div class="column-heading">
        <span>WORKING</span>
        <b>2</b>
      </div>

      <div class="dispatch-work-card working">
        <span>WO-1048</span>
        <strong>Split AC Repair</strong>
        <small>Rahul · Rajpur Road</small>

        <div class="working-line">
          <span></span>
          Diagnosing
        </div>
      </div>

      <div class="dispatch-work-card working">
        <span>WO-1045</span>
        <strong>Solar Inspection</strong>
        <small>Priya · Clement Town</small>

        <div class="working-line">
          <span></span>
          Inspection
        </div>
      </div>
    </div>
  </div>
</div>
