---
---

<section class="view serviq-invoices" data-panel="invoices">
  <div class="page-heading">
    <div>
      <span class="eyebrow">FINANCE / INVOICES</span>
      <h1>
        Revenue starts with a <em>completed job.</em>
      </h1>
      <p>
        Manage billing records, track collections and identify overdue invoices.
      </p>
    </div>
    <button class="primary-action" id="serviq-add-invoice" type="button">
      <span>+</span>
      Create Invoice
    </button>
  </div>

  <div
    class="serviq-invoice-feedback"
    id="serviq-invoice-feedback"
    role="status"
    aria-live="polite"
    hidden
  ></div>

  <section
    id="serviq-invoice-summary"
    class="serviq-invoice-summary"
    aria-label="Invoice summary"
  ></section>

  <section class="serviq-invoice-toolbar" aria-label="Invoice filters">
    <label class="serviq-invoice-search">
      <span aria-hidden="true">⌕</span>
      <input
        id="serviq-invoice-search"
        type="search"
        placeholder="Search invoice, customer or work order..."
        autocomplete="off"
        aria-label="Search invoices"
      />
    </label>

    <label class="serviq-invoice-filter">
      <span>Payment status</span>
      <select id="serviq-invoice-status">
        <option value="all">All statuses</option>
        <option value="Draft">Draft</option>
        <option value="Paid">Paid</option>
        <option value="Overdue">Overdue</option>
      </select>
    </label>

    <label class="serviq-invoice-filter">
      <span>Sort by</span>
      <select id="serviq-invoice-sort">
        <option value="date-desc">Newest first</option>
        <option value="date-asc">Oldest first</option>
        <option value="amount-desc">Highest amount</option>
        <option value="amount-asc">Lowest amount</option>
      </select>
    </label>
  </section>

  <div class="serviq-invoice-results-heading">
    <div>
      <span class="panel-label">BILLING REGISTER</span>
      <h2>Invoice records</h2>
    </div>
    <span id="serviq-invoice-result-count" class="serviq-invoice-result-count">
      Loading invoices...
    </span>
  </div>

  <section
    id="serviq-invoice-list"
    class="serviq-invoice-list"
    aria-label="Invoices"
  >
    <div class="serviq-invoice-table-head" aria-hidden="true">
      <span>INVOICE / WORK ORDER</span>
      <span>CUSTOMER</span>
      <span>AMOUNT</span>
      <span>ISSUED</span>
      <span>STATUS</span>
      <span>ACTIONS</span>
    </div>
    <div
      id="serviq-invoice-rows"
      class="serviq-invoice-rows"
      aria-live="polite"
    ></div>
  </section>

  <div id="serviq-invoice-empty" class="serviq-invoice-empty" hidden>
    <span class="serviq-invoice-empty-icon" aria-hidden="true">
      ₹
    </span>
    <h3>No invoices found</h3>
    <p>Try another search or change the selected payment status.</p>
    <button class="secondary-action" id="serviq-invoice-reset" type="button">
      Clear filters
    </button>
  </div>
</section>

<div id="serviq-invoice-modal" class="serviq-invoice-modal" hidden>
  <section
    class="serviq-invoice-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="serviq-invoice-modal-title"
  >
    <header class="serviq-invoice-modal-header">
      <div>
        <span class="eyebrow">INVOICE MANAGEMENT</span>
        <h2 id="serviq-invoice-modal-title">Create invoice</h2>
        <p id="serviq-invoice-modal-description">
          Record a bill for a customer and work order.
        </p>
      </div>
      <button
        type="button"
        class="serviq-invoice-modal-close"
        id="serviq-invoice-modal-close"
        aria-label="Close invoice form"
      >
        ×
      </button>
    </header>

    <form id="serviq-invoice-form">
      <div class="serviq-invoice-form-grid">
        <label class="serviq-invoice-field serviq-invoice-field-wide">
          <span>
            Customer <b>*</b>
          </span>
          <input
            name="customer"
            type="text"
            maxlength="120"
            list="serviq-invoice-customer-options"
            placeholder="Enter a customer name"
            required
          />
          <datalist id="serviq-invoice-customer-options"></datalist>
        </label>

        <label class="serviq-invoice-field">
          <span>
            Work order reference <b>*</b>
          </span>
          <input
            name="workOrder"
            type="text"
            maxlength="100"
            list="serviq-invoice-work-order-options"
            placeholder="e.g. WO-1048"
            required
          />
          <datalist id="serviq-invoice-work-order-options"></datalist>
        </label>

        <label class="serviq-invoice-field">
          <span>
            Invoice amount (₹) <b>*</b>
          </span>
          <input
            name="amount"
            type="number"
            min="0.01"
            max="100000000000"
            step="0.01"
            placeholder="e.g. 2180"
            required
          />
        </label>

        <label class="serviq-invoice-field">
          <span>
            Invoice date <b>*</b>
          </span>
          <input name="date" type="date" required />
        </label>

        <label class="serviq-invoice-field">
          <span>Payment status</span>
          <select name="status" required>
            <option value="Draft">Draft</option>
            <option value="Paid">Paid</option>
            <option value="Overdue">Overdue</option>
          </select>
        </label>
      </div>

      <div class="serviq-invoice-form-note">
        <span aria-hidden="true">i</span>
        This prototype stores invoice records locally. It does not issue legally
        compliant tax invoices or process payments.
      </div>

      <div class="serviq-invoice-modal-actions">
        <button
          class="secondary-action"
          id="serviq-invoice-cancel"
          type="button"
        >
          Cancel
        </button>
        <button class="primary-action" id="serviq-invoice-save" type="submit">
          Create Invoice
        </button>
      </div>
    </form>
  </section>
</div>

<script>
  import {
    createInvoice,
    deleteInvoice,
    getState,
    subscribe,
    updateInvoice,
  } from "../../lib/serviq/store";

  import type { Invoice } from "../../data/serviq/invoices";

  const summary = document.querySelector<HTMLElement>(
    "#serviq-invoice-summary",
  );
  const searchInput = document.querySelector<HTMLInputElement>(
    "#serviq-invoice-search",
  );
  const statusFilter = document.querySelector<HTMLSelectElement>(
    "#serviq-invoice-status",
  );
  const sortSelect = document.querySelector<HTMLSelectElement>(
    "#serviq-invoice-sort",
  );
  const resultCount = document.querySelector<HTMLElement>(
    "#serviq-invoice-result-count",
  );
  const invoiceList = document.querySelector<HTMLElement>(
    "#serviq-invoice-list",
  );
  const rowsContainer = document.querySelector<HTMLElement>(
    "#serviq-invoice-rows",
  );
  const emptyState = document.querySelector<HTMLElement>(
    "#serviq-invoice-empty",
  );
  const modal = document.querySelector<HTMLElement>("#serviq-invoice-modal");
  const form = document.querySelector<HTMLFormElement>("#serviq-invoice-form");
  const modalTitle = document.querySelector<HTMLElement>(
    "#serviq-invoice-modal-title",
  );
  const modalDescription = document.querySelector<HTMLElement>(
    "#serviq-invoice-modal-description",
  );
  const saveButton = document.querySelector<HTMLButtonElement>(
    "#serviq-invoice-save",
  );
  const feedback = document.querySelector<HTMLElement>(
    "#serviq-invoice-feedback",
  );
  const customerOptions = document.querySelector<HTMLDataListElement>(
    "#serviq-invoice-customer-options",
  );
  const workOrderOptions = document.querySelector<HTMLDataListElement>(
    "#serviq-invoice-work-order-options",
  );

  if (
    summary &&
    searchInput &&
    statusFilter &&
    sortSelect &&
    resultCount &&
    invoiceList &&
    rowsContainer &&
    emptyState &&
    modal &&
    form &&
    modalTitle &&
    modalDescription &&
    saveButton &&
    feedback &&
    customerOptions &&
    workOrderOptions
  ) {
    type InvoiceStatus = Invoice["status"];

    const invoiceStatuses: InvoiceStatus[] = ["Draft", "Paid", "Overdue"];

    let editingInvoiceId: string | null = null;
    let previousBodyOverflow = "";
    let feedbackTimeout: ReturnType<typeof setTimeout> | undefined;

    const escapeHtml = (value: unknown): string =>
      String(value ?? "").replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        };
        return entities[character] ?? character;
      });

    const formatCurrency = (amount: number): string =>
      new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 2,
      }).format(amount);

    const toLocalISODate = (date = new Date()): string => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };

    const parseDate = (value: string): Date | null => {
      if (!value.trim()) return null;

      const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);

      if (match) {
        const parsed = new Date(
          Number(match[1]),
          Number(match[2]) - 1,
          Number(match[3]),
        );
        return Number.isNaN(parsed.getTime()) ? null : parsed;
      }

      const parsed = new Date(value);
      return Number.isNaN(parsed.getTime()) ? null : parsed;
    };

    const formatDate = (value: string): string => {
      const date = parseDate(value);
      if (!date) return value || "—";

      return new Intl.DateTimeFormat("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }).format(date);
    };

    const toDateInput = (value: string): string => {
      const date = parseDate(value);
      return date ? toLocalISODate(date) : toLocalISODate();
    };

    const showFeedback = (
      message: string,
      kind: "success" | "error" = "success",
    ): void => {
      if (!feedback) return;
      if (feedbackTimeout) clearTimeout(feedbackTimeout);

      feedback.textContent = message;
      feedback.className = `serviq-invoice-feedback ${kind}`;
      feedback.hidden = false;

      feedbackTimeout = setTimeout(() => {
        if (feedback) feedback.hidden = true;
      }, 4000);
    };

    const updateReferenceOptions = (): void => {
      const state = getState();

      customerOptions.innerHTML = state.customers
        .map(
          (customer) =>
            `<option value="${escapeHtml(customer.name)}"></option>`,
        )
        .join("");

      workOrderOptions.innerHTML = state.workOrders
        .map(
          (order) =>
            `<option value="${escapeHtml(order.id)}">${escapeHtml(order.customer)} — ${escapeHtml(order.service)}</option>`,
        )
        .join("");
    };

    const renderSummary = (invoices: Invoice[]): void => {
      const total = invoices.reduce((sum, invoice) => sum + invoice.amount, 0);
      const paidInvoices = invoices.filter(
        (invoice) => invoice.status === "Paid",
      );
      const collected = paidInvoices.reduce(
        (sum, invoice) => sum + invoice.amount,
        0,
      );
      const outstandingInvoices = invoices.filter(
        (invoice) => invoice.status !== "Paid",
      );
      const outstanding = outstandingInvoices.reduce(
        (sum, invoice) => sum + invoice.amount,
        0,
      );
      const overdueInvoices = invoices.filter(
        (invoice) => invoice.status === "Overdue",
      );
      const overdue = overdueInvoices.reduce(
        (sum, invoice) => sum + invoice.amount,
        0,
      );

      const metrics = [
        {
          label: "Total invoiced",
          value: formatCurrency(total),
          note: `${invoices.length} invoice${invoices.length === 1 ? "" : "s"} recorded`,
          accent: "gold",
          icon: "₹",
        },
        {
          label: "Collected",
          value: formatCurrency(collected),
          note: "Invoices marked as paid",
          accent: "green",
          icon: "✓",
        },
        {
          label: "Outstanding",
          value: formatCurrency(outstanding),
          note: `${outstandingInvoices.length} unpaid invoice${outstandingInvoices.length === 1 ? "" : "s"}`,
          accent: "blue",
          icon: "◷",
        },
        {
          label: "Overdue",
          value: formatCurrency(overdue),
          note: `${overdueInvoices.length} overdue invoice${overdueInvoices.length === 1 ? "" : "s"}`,
          accent: "red",
          icon: "!",
        },
      ];

      summary.innerHTML = metrics
        .map(
          (metric) => `
            <article class="serviq-invoice-metric ${metric.accent}">
              <div class="serviq-invoice-metric-top">
                <span>${escapeHtml(metric.label)}</span>
                <span class="serviq-invoice-metric-icon" aria-hidden="true">${metric.icon}</span>
              </div>
              <strong>${escapeHtml(metric.value)}</strong>
              <small>${escapeHtml(metric.note)}</small>
            </article>
          `,
        )
        .join("");
    };

    const renderInvoices = (): void => {
      const invoices = getState().invoices;
      const query = searchInput.value.trim().toLowerCase();
      const selectedStatus = statusFilter.value;
      const sort = sortSelect.value;

      renderSummary(invoices);
      updateReferenceOptions();

      const filtered = invoices.filter((invoice) => {
        const matchesSearch = [
          invoice.id,
          invoice.customer,
          invoice.workOrder,
          invoice.status,
          invoice.date,
        ].some((value) =>
          String(value ?? "")
            .toLowerCase()
            .includes(query),
        );

        const matchesStatus =
          selectedStatus === "all" || invoice.status === selectedStatus;

        return matchesSearch && matchesStatus;
      });

      filtered.sort((first, second) => {
        if (sort === "amount-desc") return second.amount - first.amount;
        if (sort === "amount-asc") return first.amount - second.amount;

        const firstDate = parseDate(first.date)?.getTime() ?? 0;
        const secondDate = parseDate(second.date)?.getTime() ?? 0;

        return sort === "date-asc"
          ? firstDate - secondDate
          : secondDate - firstDate;
      });

      resultCount.textContent = `${filtered.length} of ${invoices.length} invoice${invoices.length === 1 ? "" : "s"}`;

      emptyState.hidden = filtered.length > 0;
      invoiceList.hidden = filtered.length === 0;

      rowsContainer.innerHTML = filtered
        .map((invoice) => {
          const statusClass = invoice.status.toLowerCase();

          const statusOptions = invoiceStatuses
            .map(
              (status) =>
                `<option value="${status}" ${invoice.status === status ? "selected" : ""}>${status}</option>`,
            )
            .join("");

          return `
            <article class="serviq-invoice-row">
              <div class="serviq-invoice-primary">
                <strong>${escapeHtml(invoice.id)}</strong>
                <small>${escapeHtml(invoice.workOrder)}</small>
              </div>

              <div class="serviq-invoice-customer">
                <strong>${escapeHtml(invoice.customer)}</strong>
                <small>Customer</small>
              </div>

              <strong class="serviq-invoice-amount">${escapeHtml(formatCurrency(invoice.amount))}</strong>

              <span class="serviq-invoice-date">${escapeHtml(formatDate(invoice.date))}</span>

              <label class="serviq-invoice-status-control">
                <span class="serviq-invoice-status ${statusClass}">
                  <i></i>
                  ${escapeHtml(invoice.status)}
                </span>
                <select data-action="status" data-invoice-id="${escapeHtml(invoice.id)}" aria-label="Change status for invoice ${escapeHtml(invoice.id)}">
                  ${statusOptions}
                </select>
              </label>

              <div class="serviq-invoice-actions">
                ${
                  invoice.status !== "Paid"
                    ? `<button type="button" class="serviq-invoice-mark-paid" data-action="paid" data-invoice-id="${escapeHtml(invoice.id)}">Mark paid</button>`
                    : `<span class="serviq-invoice-paid-label">✓ Paid</span>`
                }
                <button type="button" class="serviq-invoice-edit" data-action="edit" data-invoice-id="${escapeHtml(invoice.id)}">Edit</button>
                <button type="button" class="serviq-invoice-delete" data-action="delete" data-invoice-id="${escapeHtml(invoice.id)}" aria-label="Delete invoice ${escapeHtml(invoice.id)}">Delete</button>
              </div>
            </article>
          `;
        })
        .join("");
    };

    const openModal = (invoice?: Invoice): void => {
      editingInvoiceId = invoice?.id ?? null;
      form.reset();

      modalTitle.textContent = invoice ? "Edit invoice" : "Create invoice";
      modalDescription.textContent = invoice
        ? "Update the customer, work order, amount or payment status."
        : "Record a bill for a customer and work order.";
      saveButton.textContent = invoice ? "Save changes" : "Create Invoice";

      const customerInput = form.elements.namedItem(
        "customer",
      ) as HTMLInputElement;
      const workOrderInput = form.elements.namedItem(
        "workOrder",
      ) as HTMLInputElement;
      const amountInput = form.elements.namedItem("amount") as HTMLInputElement;
      const dateInput = form.elements.namedItem("date") as HTMLInputElement;
      const statusInput = form.elements.namedItem(
        "status",
      ) as HTMLSelectElement;

      if (invoice) {
        customerInput.value = invoice.customer;
        workOrderInput.value = invoice.workOrder;
        amountInput.value = String(invoice.amount);
        dateInput.value = toDateInput(invoice.date);
        statusInput.value = invoice.status;
      } else {
        dateInput.value = toLocalISODate();
        statusInput.value = "Draft";
      }

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      modal.hidden = false;
      window.setTimeout(() => customerInput.focus(), 0);
    };

    const closeModal = (): void => {
      modal.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      editingInvoiceId = null;
      form.reset();
    };

    const setInvoiceStatus = (id: string, status: InvoiceStatus): void => {
      try {
        const updated = updateInvoice(id, { status });

        if (!updated) {
          showFeedback("The invoice could not be found.", "error");
          return;
        }

        showFeedback(`${updated.id} status changed to ${updated.status}.`);
      } catch (error) {
        showFeedback(
          error instanceof Error
            ? error.message
            : "Unable to update invoice status.",
          "error",
        );
      }
    };

    const removeInvoice = (id: string): void => {
      const invoice = getState().invoices.find((item) => item.id === id);

      if (!invoice) {
        showFeedback("The invoice could not be found.", "error");
        return;
      }

      if (
        !window.confirm(`Delete invoice ${invoice.id} for ${invoice.customer}?`)
      ) {
        return;
      }

      try {
        if (deleteInvoice(id)) {
          showFeedback(`${id} was deleted.`);
        } else {
          showFeedback("The invoice could not be deleted.", "error");
        }
      } catch (error) {
        showFeedback(
          error instanceof Error ? error.message : "Unable to delete invoice.",
          "error",
        );
      }
    };

    document
      .querySelector<HTMLButtonElement>("#serviq-add-invoice")
      ?.addEventListener("click", () => openModal());

    document
      .querySelector<HTMLButtonElement>("#serviq-invoice-modal-close")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-invoice-cancel")
      ?.addEventListener("click", closeModal);

    document
      .querySelector<HTMLButtonElement>("#serviq-invoice-reset")
      ?.addEventListener("click", () => {
        searchInput.value = "";
        statusFilter.value = "all";
        sortSelect.value = "date-desc";
        renderInvoices();
      });

    searchInput.addEventListener("input", renderInvoices);
    statusFilter.addEventListener("change", renderInvoices);
    sortSelect.addEventListener("change", renderInvoices);

    rowsContainer.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("button[data-action]");
      if (!button) return;

      const action = button.dataset.action;
      const id = button.dataset.invoiceId;
      if (!id) return;

      const invoice = getState().invoices.find((item) => item.id === id);

      if (!invoice) {
        showFeedback("The invoice could not be found.", "error");
        return;
      }

      if (action === "edit") {
        openModal(invoice);
      } else if (action === "paid") {
        setInvoiceStatus(id, "Paid");
      } else if (action === "delete") {
        removeInvoice(id);
      }
    });

    rowsContainer.addEventListener("change", (event) => {
      const target = event.target;

      if (
        !(target instanceof HTMLSelectElement) ||
        target.dataset.action !== "status"
      ) {
        return;
      }

      const id = target.dataset.invoiceId;
      const status = target.value as InvoiceStatus;

      if (id && invoiceStatuses.includes(status)) {
        setInvoiceStatus(id, status);
      }
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) closeModal();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const customer = String(formData.get("customer") ?? "").trim();
      const workOrder = String(formData.get("workOrder") ?? "").trim();
      const amount = Number(formData.get("amount"));
      const date = String(formData.get("date") ?? "");
      const status = String(formData.get("status") ?? "") as InvoiceStatus;

      if (!customer || !workOrder || !date) {
        showFeedback(
          "Enter the customer, work order reference and invoice date.",
          "error",
        );
        return;
      }

      if (!Number.isFinite(amount) || amount <= 0 || amount > 100000000000) {
        showFeedback(
          "Enter a valid invoice amount greater than zero.",
          "error",
        );
        return;
      }

      if (!invoiceStatuses.includes(status)) {
        showFeedback("Choose a valid invoice status.", "error");
        return;
      }

      const payload = {
        customer,
        workOrder,
        amount: Math.round(amount * 100) / 100,
        date,
        status,
      };

      try {
        if (editingInvoiceId) {
          const updated = updateInvoice(editingInvoiceId, payload);

          if (!updated) {
            showFeedback("This invoice could not be found.", "error");
            return;
          }

          closeModal();
          showFeedback(`${updated.id} was updated successfully.`);
          return;
        }

        const state = getState();
        const year = new Date().getFullYear();
        let id = "";
        let attempts = 0;

        do {
          id = `INV-${year}-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
          attempts += 1;
        } while (
          state.invoices.some((invoice) => invoice.id === id) &&
          attempts < 10
        );

        if (state.invoices.some((invoice) => invoice.id === id)) {
          showFeedback(
            "Could not generate a unique invoice number. Please retry.",
            "error",
          );
          return;
        }

        createInvoice({ id, ...payload });
        closeModal();
        showFeedback(`${id} was created successfully.`);
      } catch (error) {
        showFeedback(
          error instanceof Error ? error.message : "Unable to save invoice.",
          "error",
        );
      }
    });

    subscribe(renderInvoices);
    renderInvoices();
  }
</script>

<style is:global>
  .serviq-invoice-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 24px;
  }

  .serviq-invoice-metric {
    min-width: 0;
    padding: 21px 22px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.09));
    border-radius: 18px;
    background: var(--panel, #101814);
  }

  .serviq-invoice-metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted, #97a59c);
    font-size: 12px;
    font-weight: 650;
