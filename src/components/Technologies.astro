const filters = [
  { label: "All", value: "all" },
  { label: "Frontend", value: "frontend" },
  { label: "Languages", value: "languages" },
  { label: "Frameworks & Runtime", value: "frameworks" },
  { label: "Data & APIs", value: "data-apis" },
  { label: "Tools & Specialist Areas", value: "tools-specialist" },
];

const logoUrl = (technology: Technology) => {
  const color = technology.color.replace("#", "");

  if (technology.logo) {
    return `https://cdn.simpleicons.org/${technology.logo}/${color}`;
  }

  return `https://api.iconify.design/lucide/${technology.icon}.svg?color=%23${color}`;
};
---

<section
  class="technologies-section"
  id="technologies"
  aria-labelledby="technologies-heading"
>
  <div class="technology-atmosphere" aria-hidden="true"></div>

  <div class="technology-shell">
    <header class="section-header">
      <p class="section-eyebrow">
        <span class="eyebrow-mark" aria-hidden="true"></span>
        TECHNOLOGY STACK
      </p>

      <h2 id="technologies-heading">
        The tools <span>behind the work.</span>
      </h2>

      <p class="section-description">
        Explore the languages, frameworks and tools behind the work.
        Select a category or move through the stack.
      </p>
    </header>

    <div class="technology-toolbar">
      <p class="toolbar-label">EXPLORE BY CATEGORY</p>

      <div class="technology-filters" role="group" aria-label="Filter technologies">
        {
          filters.map((filter, index) => (
            <button
              type="button"
              class:list={["filter-button", index === 0 && "is-active"]}
              data-filter={filter.value}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <p class="sr-only" aria-live="polite" data-filter-status>
        Showing all technologies.
      </p>
    </div>

    <div class="technology-carousel">
      <div
        class="technology-stage"
        data-tech-stage
        aria-label="Technology carousel"
        aria-roledescription="carousel"
      >
        <div class="technology-ring" data-tech-ring>
          {
            technologies.map((technology) => (
              <article
                class="technology-card"
                data-tech-group={technology.group}
                data-tech-name={technology.name}
                style={`--tech-color: ${technology.color};`}
                role="button"
                tabindex="0"
                aria-label={`${technology.name}. ${technology.description}`}
              >
                <div class="technology-card-top">
                  <span class="technology-category">{technology.category}</span>
                  <span class="technology-indicator" aria-hidden="true"></span>
                </div>

                <div class="technology-heading">
                  <span class="technology-logo-wrap">
                    <img
                      class="technology-logo"
                      src={logoUrl(technology)}
                      alt=""
                      width="42"
                      height="42"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="technology-logo-fallback" aria-hidden="true">
                      {technology.name.slice(0, 2)}
                    </span>
                  </span>

                  <h3>{technology.name}</h3>
                </div>

                <p class="technology-description">{technology.description}</p>

                <div class="technology-syntax">
                  <span class="syntax-label">EXAMPLE</span>
                  <pre><code>{technology.syntax}</code></pre>
                </div>

                <span class="technology-card-line" aria-hidden="true"></span>
              </article>
            ))
          }
        </div>

        <div class="technology-empty" data-tech-empty hidden>
          No technologies in this category.
        </div>
      </div>

      <div class="carousel-controls">
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-prev
          aria-label="Previous technology"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <span class="carousel-hint">EXPLORE THE STACK</span>

        <button
          class="carousel-arrow"
          type="button"
          data-carousel-next
          aria-label="Next technology"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <footer class="technology-footer">
      <p>
        Technology choices depend on the problem, product requirements, and
        implementation context.
      </p>
    </footer>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".technologies-section").forEach((section) => {
    if (section.dataset.carouselInitialized === "true") return;
    section.dataset.carouselInitialized = "true";

    const stage = section.querySelector<HTMLElement>("[data-tech-stage]");
    const ring = section.querySelector<HTMLElement>("[data-tech-ring]");
    const empty = section.querySelector<HTMLElement>("[data-tech-empty]");
    const filterButtons = Array.from(section.querySelectorAll<HTMLButtonElement>(".filter-button"));
    const allCards = Array.from(section.querySelectorAll<HTMLElement>(".technology-card"));
    const status = section.querySelector<HTMLElement>("[data-filter-status]");
    const prevButton = section.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextButton = section.querySelector<HTMLButtonElement>("[data-carousel-next]");

    if (!stage || !ring || !empty || !prevButton || !nextButton) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const ROTATION_INTERVAL = 3400;

    let activeCards = [...allCards];
    let activeIndex = 0;
    let rotationTimer: number | null = null;
    let isInView = false;
    let touchStartX: number | null = null;

    allCards.forEach((card) => {
      const image = card.querySelector<HTMLImageElement>(".technology-logo");

      if (!image) return;

      const markFailed = () => card.classList.add("logo-failed");
      image.addEventListener("error", markFailed, { once: true });

      if (image.complete && image.naturalWidth === 0) {
        markFailed();
      }

      image.addEventListener("load", () => {
        card.classList.remove("logo-failed");
      });
    });

    const getOffset = (index: number, current: number, total: number): number => {
      if (total <= 1) return 0;

      let offset = (index - current + total) % total;
      if (offset > total / 2) offset -= total;
      return offset;
    };

    const stopRotation = () => {
      if (rotationTimer !== null) {
        window.clearTimeout(rotationTimer);
        rotationTimer = null;
      }
    };

    const positionCards = () => {
      if (!activeCards.length || stage.clientWidth === 0) return;

      const isPhone = window.innerWidth <= 640;
      const visibleDistance = isPhone ? 1 : 2;

      const step = Math.max(
        isPhone ? 110 : 175,
        Math.min(
          isPhone ? 132 : 245,
          stage.clientWidth * (isPhone ? 0.39 : 0.26),
        ),
      );

      activeCards.forEach((card, index) => {
        const offset = getOffset(index, activeIndex, activeCards.length);
        const distance = Math.abs(offset);
        const visible = distance <= visibleDistance;
        const scale = distance === 0 ? 1 : Math.max(0.79, 1 - distance * 0.09);

        card.style.transform =
          `translate(-50%, -50%) translateX(${offset * step}px) ` +
          `translateZ(${-distance * 34}px) rotateY(${offset * -4}deg) scale(${scale})`;

        card.style.opacity = !visible
          ? "0"
          : distance === 0
            ? "1"
            : distance === 1
              ? "0.54"
              : "0.2";

        card.style.filter =
          distance === 0 || reducedMotion.matches
            ? "none"
            : `blur(${Math.min(1.1, distance * 0.5)}px)`;

        card.style.visibility = visible ? "visible" : "hidden";
        card.style.pointerEvents = visible ? "auto" : "none";
        card.style.zIndex = String(10 - distance);
        card.tabIndex = visible ? 0 : -1;
        card.classList.toggle("is-active", distance === 0);
        card.setAttribute("aria-hidden", String(!visible));
      });
    };

    const scheduleRotation = () => {
      stopRotation();

      if (
        activeCards.length <= 1 ||
        reducedMotion.matches ||
        !isInView ||
        document.visibilityState !== "visible"
      ) {
        return;
      }

      rotationTimer = window.setTimeout(() => {
        moveTo(activeIndex + 1);
      }, ROTATION_INTERVAL);
    };

    const moveTo = (index: number): void => {
      if (!activeCards.length) return;

      activeIndex = ((index % activeCards.length) + activeCards.length) %
        activeCards.length;

      positionCards();
      scheduleRotation();
    };

    const setFilter = (value: string, clickedButton: HTMLButtonElement | null = null): void => {
      filterButtons.forEach((button) => {
        const active = button.dataset.filter === value;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      activeCards = allCards.filter((card) => {
        return value === "all" || card.dataset.techGroup === value;
      });

      allCards.forEach((card) => {
        card.classList.toggle("is-filtered-out", !activeCards.includes(card));
      });

      activeIndex = 0;
      ring.hidden = activeCards.length === 0;
      empty.hidden = activeCards.length > 0;

      if (status) {
        const label = clickedButton?.textContent?.trim() ||
          filterButtons.find((button) => button.dataset.filter === value)
            ?.textContent?.trim() || "All";

        status.textContent = `Showing ${activeCards.length} technologies in ${label}.`;
      }

      positionCards();
      scheduleRotation();
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setFilter(button.dataset.filter || "all", button);
      });
    });

    allCards.forEach((card) => {
      const activateCard = () => {
        const index = activeCards.indexOf(card);
        if (index !== -1) moveTo(index);
      };

      card.addEventListener("click", activateCard);

      card.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          activateCard();
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          moveTo(activeIndex + 1);
        } else if (event.key === "ArrowLeft") {
          event.preventDefault();
          moveTo(activeIndex - 1);
        }
      });
    });

    prevButton.addEventListener("click", () => moveTo(activeIndex - 1));
    nextButton.addEventListener("click", () => moveTo(activeIndex + 1));

    stage.addEventListener("pointerdown", (event: PointerEvent) => {
      if (event.pointerType === "mouse") return;
      touchStartX = event.clientX;
    });

    stage.addEventListener("pointerup", (event: PointerEvent) => {
      if (touchStartX === null) return;

      const delta = event.clientX - touchStartX;
      touchStartX = null;

      if (Math.abs(delta) > 42) {
        moveTo(activeIndex + (delta < 0 ? 1 : -1));
      }
    });

    stage.addEventListener("pointercancel", () => {
      touchStartX = null;
    });

    window.addEventListener("resize", positionCards, { passive: true });
    document.addEventListener("visibilitychange", scheduleRotation);

    reducedMotion.addEventListener("change", () => {
      positionCards();
      scheduleRotation();
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isInView = Boolean(entry?.isIntersecting);
        scheduleRotation();
      },
      { threshold: 0.1 },
    );

    observer.observe(stage);
    setFilter("all");
  });
</script>

<style>
  .technologies-section {
    --tech-accent: #e44752;
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(76px, 8vw, 112px) clamp(18px, 6vw, 88px);
    overflow: clip;
    color: #f5e7e8;
    background: #0b0809;
    scroll-margin-top: 95px;
  }

  .technologies-section *,
  .technologies-section *::before,
  .technologies-section *::after {
    box-sizing: border-box;
  }

  .technology-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 85% 18%, rgba(228, 71, 82, 0.08), transparent 35%),
      radial-gradient(ellipse at 10% 82%, rgba(139, 31, 47, 0.055), transparent 32%);
  }

  .technology-shell {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Centre the heading group without changing the carousel or toolbar layout. */
  .section-header {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    text-align: center;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    margin: 0 0 21px;
    color: #d3a4a9;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.15em;
    line-height: 1.6;
  }

  .eyebrow-mark {
    width: 24px;
    height: 2px;
    flex: 0 0 auto;
    background: #e44752;
  }

  .section-header h2 {
    width: 100%;
    margin: 0;
    color: #f5e7e8;
    font-size: clamp(1rem, 4.5vw, 3.6rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .section-header h2 span {
    display: inline;
    color: #e66a73;
    white-space: nowrap;
  }

  .section-description {
    width: 100%;
    max-width: 610px;
    margin: 20px auto 0;
    color: #b7a7aa;
    font-size: 0.93rem;
    line-height: 1.85;
    text-align: center;
  }

  .technology-toolbar {
    margin-top: 34px;
    padding-bottom: 20px;
    border-bottom: 1px solid #382126;
