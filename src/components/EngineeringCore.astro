
---
const layers = [
  {
    title: "Experience",
    category: "Discovery",
    subtitle: "Understand the problem first.",
    description:
      "Begin with the people, requirements, context, and intended outcome. Understand what the product needs to solve before deciding how to build it.",
    focus: ["User needs", "Requirements", "Product goals"],
    visual: "experience",
    accent: "#E44752",
  },
  {
    title: "Interface",
    category: "Interaction design",
    subtitle: "Make every interaction clear.",
    description:
      "Build interfaces that make information easy to understand. Responsive layouts, meaningful feedback, accessibility, and consistent interaction patterns all matter.",
    focus: ["Responsive UI", "Accessibility", "Usability"],
    visual: "interface",
    accent: "#59B8FF",
  },
  {
    title: "Application",
    category: "Application logic",
    subtitle: "Define how the product works.",
    description:
      "Connect components, state, validation, and business rules into predictable application behaviour. Keep responsibilities clear and implementation maintainable.",
    focus: ["Component design", "State", "Validation"],
    visual: "application",
    accent: "#C4B5FD",
  },
  {
    title: "Data",
    category: "Data architecture",
    subtitle: "Give information a reliable structure.",
    description:
      "Model data carefully, define relationships, validate inputs, and handle loading and error states. Good data design makes an application easier to trust and extend.",
    focus: ["Data models", "Databases", "Integrity"],
    visual: "data",
    accent: "#F7C948",
  },
  {
    title: "Intelligence",
    category: "Problem solving",
    subtitle: "Turn information into useful outcomes.",
    description:
      "Use analytical thinking, automation, and AI capabilities where they solve a real problem. Keep outputs relevant, understandable, and grounded in the available context.",
    focus: ["Analysis", "Automation", "AI workflows"],
    visual: "intelligence",
    accent: "#B79AFF",
  },
  {
    title: "Integration",
    category: "Connected systems",
    subtitle: "Make every part work together.",
    description:
      "Connect services through consistent APIs, authentication, data contracts, and error handling. Treat integrations as part of the product, not an afterthought.",
    focus: ["APIs", "Authentication", "Reliability"],
    visual: "integration",
    accent: "#4FD1B5",
  },
  {
    title: "Production",
    category: "Delivery and reliability",
    subtitle: "Prepare the system for real use.",
    description:
      "Think beyond a successful local run. Consider performance, secure configuration, deployment, observability, and the maintenance a product needs over time.",
    focus: ["Performance", "Deployment", "Maintainability"],
    visual: "production",
    accent: "#FFA45B",
  },
];
---

<section
  id="engineering-core"
  class="engineering-section"
  aria-labelledby="engineering-heading"
>
  <div class="engineering-atmosphere" aria-hidden="true"></div>
  <div class="engineering-cursor-glow" data-engineering-glow aria-hidden="true"></div>

  <div class="engineering-container">
    <header class="engineering-header">
      <span class="engineering-heading-rule" aria-hidden="true"></span>

      <h2 id="engineering-heading">
        The thinking behind
        <span>the build.</span>
      </h2>

      <p>
        A product is more than its interface. I treat requirements, application
        logic, data, integrations, and delivery as connected parts of one system.
      </p>
    </header>

    <div class="engineering-carousel">
      <div
        class="engineering-stage"
        data-engineering-stage
        aria-label="Engineering principles"
        aria-roledescription="carousel"
      >
        <div class="engineering-ring" data-engineering-ring>
          {layers.map((layer) => (
            <article
              class={`engineering-card engineering-card--${layer.visual}`}
              data-engineering-card
              data-engineering-visual={layer.visual}
              style={`--engineering-accent: ${layer.accent};`}
              aria-label={`${layer.title}: ${layer.description}`}
              tabindex="0"
            >
              <div class="engineering-card-top">
                <span class="engineering-category">{layer.category}</span>
                <span class="engineering-card-status" aria-hidden="true"></span>
              </div>

              <div class={`engineering-visual engineering-visual--${layer.visual}`} aria-hidden="true">
                {layer.visual === "experience" && (
                  <div class="experience-art">
                    <span class="experience-orbit experience-orbit-a"></span>
                    <span class="experience-orbit experience-orbit-b"></span>
                    <span class="experience-orbit experience-orbit-c"></span>
                    <span class="experience-core"></span>
                    <span class="experience-cross experience-cross-a"></span>
                    <span class="experience-cross experience-cross-b"></span>
                  </div>
                )}

                {layer.visual === "interface" && (
                  <div class="interface-art">
                    <div class="interface-window-top">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="interface-window-body">
                      <span class="interface-sidebar"></span>
                      <div class="interface-content">
                        <span class="interface-line line-wide"></span>
                        <span class="interface-line line-short"></span>
                        <div class="interface-blocks">
                          <span></span><span></span><span></span>
                        </div>
                        <span class="interface-line line-medium"></span>
                      </div>
                    </div>
                  </div>
                )}

                {layer.visual === "application" && (
                  <div class="application-art">
                    <span class="app-connector app-connector-a"></span>
                    <span class="app-connector app-connector-b"></span>
                    <span class="app-connector app-connector-c"></span>
                    <span class="app-node app-node-a"><i></i></span>
                    <span class="app-node app-node-b"><i></i></span>
                    <span class="app-node app-node-c"><i></i></span>
                    <span class="app-node app-node-d"><i></i></span>
                  </div>
                )}

                {layer.visual === "data" && (
                  <div class="data-art">
                    <div class="data-gridline"></div>
                    <div class="data-gridline"></div>
                    <div class="data-gridline"></div>
                    <div class="data-bars">
                      <span style="--bar-height: 35%"></span>
                      <span style="--bar-height: 52%"></span>
                      <span style="--bar-height: 43%"></span>
                      <span style="--bar-height: 72%"></span>
                      <span style="--bar-height: 59%"></span>
                      <span style="--bar-height: 91%"></span>
                      <span style="--bar-height: 69%"></span>
                      <span style="--bar-height: 81%"></span>
                    </div>
                    <div class="data-base"></div>
                  </div>
                )}

                {layer.visual === "intelligence" && (
                  <div class="intelligence-art">
                    <span class="intelligence-orbit intelligence-orbit-a"></span>
                    <span class="intelligence-orbit intelligence-orbit-b"></span>
                    <span class="intelligence-orbit intelligence-orbit-c"></span>
                    <span class="intelligence-node intelligence-node-a"></span>
                    <span class="intelligence-node intelligence-node-b"></span>
                    <span class="intelligence-node intelligence-node-c"></span>
                    <span class="intelligence-node intelligence-node-d"></span>
                    <span class="intelligence-core"></span>
                  </div>
                )}

                {layer.visual === "integration" && (
                  <div class="integration-art">
                    <span class="integration-path integration-path-a"></span>
                    <span class="integration-path integration-path-b"></span>
                    <span class="integration-path integration-path-c"></span>
                    <span class="integration-node integration-node-a"><i></i></span>
                    <span class="integration-node integration-node-b"><i></i></span>
                    <span class="integration-node integration-node-c"><i></i></span>
                  </div>
                )}

                {layer.visual === "production" && (
                  <div class="production-art">
                    <div class="production-window">
                      <div class="production-window-top">
                        <span></span><span></span><span></span>
                      </div>
                      <div class="production-command">
                        <i></i><span></span>
                      </div>
                      <div class="production-command production-command-second">
                        <i></i><span></span>
                      </div>
                      <div class="production-success">
                        <span></span>
                        <i></i>
                      </div>
                      <div class="production-progress"><span></span></div>
                    </div>
                    <span class="production-orbit"></span>
                  </div>
                )}
              </div>

              <div class="engineering-card-content">
                <h3>{layer.title}</h3>
                <p class="engineering-card-subtitle">{layer.subtitle}</p>
                <p class="engineering-card-description">{layer.description}</p>

                <div class="engineering-focus">
                  {layer.focus.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </div>

              <span class="engineering-card-bottom" aria-hidden="true"></span>
            </article>
          ))}
        </div>

        <div class="engineering-empty" data-engineering-empty hidden>
          No engineering principles are available.
        </div>
      </div>

      <div class="engineering-controls">
        <button
          class="engineering-arrow"
          type="button"
          data-engineering-prev
          aria-label="Previous engineering principle"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M19 12H5M12 19l-7-7 7-7"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <span class="engineering-control-label">EXPLORE THE PROCESS</span>

        <button
          class="engineering-arrow"
          type="button"
          data-engineering-next
          aria-label="Next engineering principle"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M12 5l7 7-7 7"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>

    <footer class="engineering-footer">
      
      <p>Clear decisions. Connected systems. Maintainable software.</p>
    </footer>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".engineering-section").forEach((section) => {
    if (section.dataset.engineeringInitialized === "true") return;
    section.dataset.engineeringInitialized = "true";

    const stage = section.querySelector<HTMLElement>("[data-engineering-stage]");
    const ring = section.querySelector<HTMLElement>("[data-engineering-ring]");
    const glow = section.querySelector<HTMLElement>("[data-engineering-glow]");
    const empty = section.querySelector<HTMLElement>("[data-engineering-empty]");
    const prevButton = section.querySelector<HTMLButtonElement>("[data-engineering-prev]");
    const nextButton = section.querySelector<HTMLButtonElement>("[data-engineering-next]");

    const cards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-engineering-card]"),
    );

    if (
      !stage ||
      !ring ||
      !glow ||
      !empty ||
      !prevButton ||
      !nextButton ||
      cards.length === 0
    ) {
      return;
    }

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    const finePointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    );

    let activeIndex = 0;
    let activeCards = [...cards];
    let rotationTimer: number | null = null;
    let isInView = false;
    let pointerStartX: number | null = null;
    let cursorFrame: number | null = null;
    let cursorX = 0;
    let cursorY = 0;

    const ROTATION_INTERVAL = 4600;

    const getOffset = (index: number, current: number, total: number): number => {
      if (total <= 1) return 0;

      let offset = (index - current + total) % total;
      if (offset > total / 2) offset -= total;
      return offset;
    };

    const stopRotation = () => {
      if (rotationTimer !== null) {
        window.clearTimeout(rotationTimer);
        rotationTimer = null;
      }
    };

    const positionCards = () => {
      if (activeCards.length === 0 || stage.clientWidth === 0) return;

      const isPhone = window.innerWidth <= 640;
      const maxVisibleDistance = isPhone ? 1 : 2;

      const step = Math.max(
        isPhone ? 234 : 295,
        Math.min(
          isPhone ? 255 : 340,
          stage.clientWidth * (isPhone ? 0.68 : 0.285),
        ),
      );

      activeCards.forEach((card, index) => {
        const offset = getOffset(index, activeIndex, activeCards.length);
        const distance = Math.abs(offset);
        const visible = distance <= maxVisibleDistance;

        const scale =
          distance === 0
            ? 1
            : Math.max(isPhone ? 0.83 : 0.79, 1 - distance * 0.085);

        const rotation = offset * -5;
        const depth = distance * (isPhone ? 26 : 38);

        card.style.transform =
          `translate(-50%, -50%) translateX(${offset * step}px) ` +
          `translateZ(${-depth}px) rotateY(${rotation}deg) scale(${scale})`;

        card.style.opacity = !visible
          ? "0"
          : distance === 0
            ? "1"
            : distance === 1
              ? isPhone ? "0.42" : "0.58"
              : "0.22";

        // Keep the active card completely sharp. Neighbouring cards only
        // receive a very light focus falloff, rather than a heavy blur.
        card.style.filter =
          distance === 0 || reducedMotion.matches
            ? "none"
            : `blur(${Math.min(0.7, distance * 0.28)}px)`;

        card.style.visibility = visible ? "visible" : "hidden";
        card.style.pointerEvents = visible ? "auto" : "none";
        card.style.zIndex = String(20 - distance);
        card.tabIndex = visible ? 0 : -1;

        card.classList.toggle("is-active", distance === 0);
        card.setAttribute("aria-hidden", String(!visible));
        card.setAttribute("aria-current", distance === 0 ? "true" : "false");
      });
    };

    const scheduleRotation = () => {
      stopRotation();

      if (
        activeCards.length <= 1 ||
        reducedMotion.matches ||
        !isInView ||
        document.visibilityState !== "visible"
      ) {
        return;
      }

      rotationTimer = window.setTimeout(() => {
        moveTo(activeIndex + 1);
      }, ROTATION_INTERVAL);
    };

    const moveTo = (index: number): void => {
      if (activeCards.length === 0) return;

      activeIndex =
        ((index % activeCards.length) + activeCards.length) %
        activeCards.length;

      positionCards();
      scheduleRotation();
    };

    const resetTilt = (card: HTMLElement): void => {
      card.style.setProperty("--card-tilt-x", "0deg");
      card.style.setProperty("--card-tilt-y", "0deg");
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const index = activeCards.indexOf(card);
        if (index !== -1) moveTo(index);
      });

      card.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          const index = activeCards.indexOf(card);
          if (index !== -1) moveTo(index);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          moveTo(activeIndex + 1);
        } else if (event.key === "ArrowLeft") {
          event.preventDefault();
          moveTo(activeIndex - 1);
        }
      });

      card.addEventListener("pointermove", (event: PointerEvent) => {
        if (
          !finePointer.matches ||
          reducedMotion.matches ||
          event.pointerType !== "mouse"
        ) {
          return;
        }

        const bounds = card.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;

        const x = (event.clientX - bounds.left) / bounds.width;
        const y = (event.clientY - bounds.top) / bounds.height;

        card.style.setProperty(
          "--card-tilt-x",
          `${((0.5 - y) * 3).toFixed(2)}deg`,
        );

        card.style.setProperty(
          "--card-tilt-y",
          `${((x - 0.5) * 4).toFixed(2)}deg`,
        );
      });

      card.addEventListener("pointerleave", () => resetTilt(card));
      card.addEventListener("blur", () => resetTilt(card));
    });

    prevButton.addEventListener("click", () => {
      moveTo(activeIndex - 1);
    });

    nextButton.addEventListener("click", () => {
      moveTo(activeIndex + 1);
    });

    stage.addEventListener("pointerdown", (event: PointerEvent) => {
      if (event.pointerType === "mouse") return;
      pointerStartX = event.clientX;
    });

    stage.addEventListener("pointerup", (event: PointerEvent) => {
      if (pointerStartX === null) return;

      const delta = event.clientX - pointerStartX;
      pointerStartX = null;

      if (Math.abs(delta) > 45) {
        moveTo(activeIndex + (delta < 0 ? 1 : -1));
      }
    });

    stage.addEventListener("pointercancel", () => {
      pointerStartX = null;
    });

    // The cursor glow follows slowly, so it feels like light, not a cursor trail.
    section.addEventListener("pointermove", (event: PointerEvent) => {
      if (
        !finePointer.matches ||
        reducedMotion.matches ||
        event.pointerType !== "mouse"
      ) {
        return;
      }

      const bounds = section.getBoundingClientRect();
      cursorX = event.clientX - bounds.left;
      cursorY = event.clientY - bounds.top;

      if (cursorFrame !== null) return;

      cursorFrame = window.requestAnimationFrame(() => {
        glow.style.left = `${cursorX}px`;
        glow.style.top = `${cursorY}px`;
        glow.classList.add("is-visible");
        cursorFrame = null;
      });
    });

    section.addEventListener("pointerleave", () => {
      glow.classList.remove("is-visible");
    });

    window.addEventListener("resize", positionCards, { passive: true });
    document.addEventListener("visibilitychange", scheduleRotation);

    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        glow.classList.remove("is-visible");
        cards.forEach(resetTilt);
      }

      positionCards();
      scheduleRotation();
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isInView = Boolean(entry?.isIntersecting);
        scheduleRotation();
      },
      { threshold: 0.1 },
    );

    observer.observe(stage);

    ring.hidden = false;
    empty.hidden = true;
    positionCards();
  });
</script>

<style>
  .engineering-section {
    --engineering-bg: #0d090b;
    --engineering-surface: #151012;
    --engineering-text: #f5e7e8;
    --engineering-muted: #b7a7aa;
    --engineering-accent: #e44752;

    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(75px, 8.2vw, 115px) clamp(18px, 6vw, 88px);
    overflow: clip;
    color: var(--engineering-text);
    background:
      linear-gradient(180deg, #100a0c, #0b0809 64%);
    scroll-margin-top: 95px;
  }

  .engineering-section *,
  .engineering-section *::before,
  .engineering-section *::after {
    box-sizing: border-box;
  }

  .engineering-atmosphere {
    position: absolute;
    z-index: -3;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 12%, rgba(228, 71, 82, 0.085), transparent 37%),
      radial-gradient(ellipse at 4% 65%, rgba(101, 48, 65, 0.075), transparent 32%),
      radial-gradient(ellipse at 96% 78%, rgba(83, 39, 51, 0.07), transparent 31%);
  }

  .engineering-cursor-glow {
    position: absolute;
    z-index: -1;
    top: 35%;
    left: 50%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle,
      rgba(228, 71, 82, 0.105) 0%,
      rgba(228, 71, 82, 0.045) 30%,
      transparent 72%
    );
    filter: blur(20px);
    transform: translate(-50%, -50%);
    transition:
      left 500ms cubic-bezier(0.2, 0.65, 0.2, 1),
      top 500ms cubic-bezier(0.2, 0.65, 0.2, 1),
      opacity 300ms ease;
    will-change: left, top;
  }

  .engineering-cursor-glow.is-visible {
    opacity: 1;
  }

  .engineering-container {
    position: relative;
    width: 100%;
    max-width: 1220px;
    margin-inline: auto;
  }

  .engineering-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 850px;
    margin: 0 auto clamp(29px, 4.2vw, 46px);
    text-align: center;
  }

  .engineering-heading-rule {
    display: block;
    width: 31px;
    height: 3px;
    margin-bottom: 18px;
    background: var(--engineering-accent);
    box-shadow: 0 0 16px rgba(228, 71, 82, 0.35);
  }

  .engineering-header h2 {
    margin: 0;
    color: var(--engineering-text);
    font-size: clamp(2.45rem, 5.2vw, 4.4rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.08;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .engineering-header h2 span {
    display: block;
    color: #e66a73;
  }

  .engineering-header > p {
    max-width: 720px;
    margin: 19px 0 0;
    color: var(--engineering-muted);
    font-size: 0.94rem;
    line-height: 1.85;
  }

  .engineering-carousel {
    position: relative;
    width: 100%;
    perspective: 1400px;
  }

  .engineering-stage {
    position: relative;
    min-height: 450px;
    overflow: hidden;
    perspective: 1300px;
    perspective-origin: 50% 45%;
    transform-style: preserve-3d;
    touch-action: pan-y;
  }

  .engineering-ring {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .engineering-ring[hidden],
  .engineering-empty[hidden] {
    display: none !important;
  }

  .engineering-card {
    --engineering-accent: #e44752;
    --card-tilt-x: 0deg;
    --card-tilt-y: 0deg;

    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    width: min(345px, calc(100% - 32px));
    min-height: 355px;
    max-height: 390px;
    padding: clamp(20px, 2.6vw, 27px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--engineering-accent) 34%, #302126);
    border-radius: 15px;
    background:
      radial-gradient(
        ellipse at 95% 0%,
        color-mix(in srgb, var(--engineering-accent) 12%, transparent),
        transparent 48%
      ),
      linear-gradient(150deg, #191114, #100c0e 77%);
    transform-origin: center center;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    outline: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 680ms cubic-bezier(0.2, 0.68, 0.2, 1),
      opacity 530ms ease,
      filter 530ms ease,
      border-color 240ms ease,
      box-shadow 260ms ease,
      background-color 260ms ease;
    will-change: transform, opacity, filter;
  }

  .engineering-card.is-active {
    border-color: color-mix(in srgb, var(--engineering-accent) 78%, #fff 0%);
    background:
      radial-gradient(
        ellipse at 100% 0%,
        color-mix(in srgb, var(--engineering-accent) 16%, transparent),
        transparent 49%
      ),
      linear-gradient(150deg, #1b1215, #100c0e 77%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.075),
      0 22px 54px rgba(0, 0, 0, 0.34),
      0 0 0 1px color-mix(in srgb, var(--engineering-accent) 13%, transparent),
      0 0 30px color-mix(in srgb, var(--engineering-accent) 15%, transparent);
  }

  .engineering-card.is-active:hover,
  .engineering-card.is-active:focus-visible {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.085),
      0 25px 60px rgba(0, 0, 0, 0.37),
      0 0 0 1px color-mix(in srgb, var(--engineering-accent) 17%, transparent),
      0 0 36px color-mix(in srgb, var(--engineering-accent) 22%, transparent);
  }

  .engineering-card:focus-visible {
    outline: 2px solid var(--engineering-accent);
    outline-offset: 4px;
  }

  .engineering-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .engineering-category {
    color: var(--engineering-accent);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .engineering-card-status {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border: 1px solid var(--engineering-accent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--engineering-accent) 65%, transparent);
