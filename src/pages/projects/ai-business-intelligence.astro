---
const pageTitle = 'Metricline | Business Analytics Workspace';
const pageDescription = 'A business analytics workspace for reviewing your own CSV exports, with client-owned workspaces and browser-local data processing.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f7f5" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/business-analytics.svg?v=2" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('metricline-theme-v1') === 'dark') document.documentElement.classList.add('theme-dark');
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="app-frame">
      <button class="mobile-scrim" type="button" aria-label="Close navigation" data-close-mobile-nav hidden></button>

      <aside class="sidebar" id="app-sidebar" aria-label="Main navigation">
        <a class="brand" href="#overview" aria-label="Metricline overview">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" focusable="false"><rect class="brand-shell" x="1" y="1" width="38" height="38" rx="11"/><path class="brand-bars" d="M9 27V21M15.5 27V16M22 27V19M28.5 27V12"/><path class="brand-trend" d="m8 16 7-5 7 2 9-6"/><circle class="brand-node" cx="31" cy="7" r="2.3"/></svg></span>
          <span class="brand-copy"><strong>Metricline</strong><small>BUSINESS ANALYTICS</small></span>
        </a>

        <div class="workspace-control">
          <label for="workspace-picker">WORKSPACE</label>
          <select id="workspace-picker" class="workspace-picker" data-workspace-picker aria-label="Choose workspace" hidden><option value="">Choose a workspace</option></select>
          <div class="no-workspace" data-no-workspace><span class="workspace-avatar">＋</span><span><strong>No workspace yet</strong><small>Start with your own data</small></span></div>
          <button class="button button-outline workspace-create" type="button" data-create-workspace><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Create workspace</button>
        </div>

        <p class="nav-label">ANALYSIS</p>
        <nav class="primary-nav" aria-label="Analysis sections">
          <a class="nav-link is-active" href="#overview" data-nav-link><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>Overview</span></a>
          <a class="nav-link" href="#revenue" data-nav-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M7 15l4-4 3 2 5-6"/></svg><span>Revenue</span></a>
          <a class="nav-link" href="#products" data-nav-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.7 7.5 4.4 7.5-4.4M12 12.1V21"/></svg><span>Products</span></a>
          <a class="nav-link" href="#records" data-nav-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg><span>Imported records</span></a>
        </nav>

        <p class="nav-label nav-label-lower">PREFERENCES</p>
        <nav class="primary-nav" aria-label="Preferences">
          <button class="nav-link" type="button" data-open-settings><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.1.9-1.2 2.1-1.4-.5a7.7 7.7 0 0 1-1.4.8l-.3 1.5h-2.5l-.3-1.5a7.7 7.7 0 0 1-1.5-.8l-1.4.5-1.2-2.1 1.1-.9a6.6 6.6 0 0 1 0-1.7l-1.1-.9 1.2-2.1 1.4.5a7.7 7.7 0 0 1 1.5-.8l.3-1.5h2.5l.3 1.5a7.7 7.7 0 0 1 1.4.8l1.4-.5 1.2 2.1-1.1.9a6.6 6.6 0 0 1-.1 1.6Z" transform="translate(-1 -1) scale(.98)"/></svg><span>Settings</span></button>
          <a class="nav-link" href="/business-analytics/privacy-settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 4.8-3 8-7 10-4-2-7-5.2-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg><span>Privacy & data</span></a>
        </nav>

        <div class="sidebar-spacer"></div>
        <div class="sidebar-status"><span class="status-dot"></span><div><strong data-sidebar-status>No workspace loaded</strong><small data-sidebar-subtitle>Data stays in this browser</small></div></div>
        <div class="sidebar-footer"><span>Metricline</span><span>Client-owned workspace</span></div>
      </aside>

      <div class="main-column">
        <header class="topbar">
          <div class="topbar-leading">
            <button class="icon-button mobile-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="app-sidebar" data-open-mobile-nav><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
            <div class="breadcrumb"><span>Workspace</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"/></svg><strong data-breadcrumb>Get started</strong></div>
          </div>
          <div class="topbar-actions">
            <label class="global-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input type="search" placeholder="Search imported records" aria-label="Search imported records" data-global-search disabled /></label>
            <button class="icon-button" type="button" aria-label="Show workspace status" data-open-notifications><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></button>
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme"><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.7 8.7 0 0 1 9.8 3.5 8.8 8.8 0 1 0 20.5 14.2Z"/></svg><span data-theme-label>Dark theme</span></button>
            <a class="back-to-portfolio" href="/" aria-label="Back to portfolio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14"/></svg><span>Back to Portfolio</span></a>
          </div>
        </header>

        <main class="dashboard-main" id="main-content">
          <section class="setup-view" data-setup-view aria-labelledby="setup-title">
            <div class="setup-intro">
              <span class="eyebrow">A workspace built around your business</span>
              <h1 id="setup-title">Your data, clearly understood.</h1>
              <p>Create a workspace for your own business, identify it with your internal reference, then import a CSV export. You can review the detected fields before building the dashboard.</p>
            </div>
            <form class="setup-card" data-workspace-form>
              <div class="form-heading"><span class="step-number">01</span><div><h2>Create a workspace</h2><p>These details identify this workspace on this browser and device.</p></div></div>
              <div class="form-grid">
                <label class="field"><span>Business name <b aria-hidden="true">*</b></span><input name="businessName" type="text" minlength="2" maxlength="100" placeholder="e.g. Acme Trading Co." autocomplete="organization" required data-business-name /></label>
                <label class="field"><span>Business / workspace ID <b aria-hidden="true">*</b></span><input name="businessId" type="text" minlength="2" maxlength="64" placeholder="e.g. ACME-OPS-01" autocomplete="off" required data-business-id /><small>Use an internal business reference. Do not enter passwords or government-issued personal IDs.</small></label>
                <label class="field"><span>Reporting currency</span><select name="currency" data-currency><option value="INR">INR — Indian rupee</option><option value="USD">USD — US dollar</option><option value="GBP">GBP — Pound sterling</option><option value="EUR">EUR — Euro</option><option value="CAD">CAD — Canadian dollar</option><option value="AUD">AUD — Australian dollar</option><option value="AED">AED — UAE dirham</option><option value="none">No currency symbol</option></select></label>
              </div>
              <div class="upload-section">
                <div class="form-heading upload-heading"><span class="step-number">02</span><div><h2>Import your spreadsheet</h2><p>Export your Excel workbook as <strong>CSV UTF-8</strong> first.</p></div></div>
                <label class="upload-drop" data-upload-drop for="workspace-file"><input id="workspace-file" name="workspaceFile" type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values" required data-workspace-file /><span class="upload-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m-5 5 5-5 5 5"/><path d="M4 15v4h16v-4"/></svg></span><strong data-file-label>Choose a CSV file</strong><span data-file-helper>or drag and drop it here · no fixed size cap</span><span class="file-chip" data-file-chip hidden></span></label>
                <div class="csv-preview" data-csv-preview hidden aria-live="polite"></div>
              </div>
              <div class="setup-footer"><p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 4.8-3 8-7 10-4-2-7-5.2-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>Your CSV is processed in this browser and saved in this browser’s local database. It is not uploaded to a server in this preview.</p><button class="button button-primary button-large" type="submit" data-create-submit disabled>Create workspace <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button></div>
              <p class="form-feedback" data-setup-feedback role="status"></p>
            </form>
            <div class="setup-footnote"><span>No prefilled business data</span><span>Review column matches before import</span><span>Saved on this device only</span></div>
          </section>

          <section class="dashboard-view" data-dashboard-view hidden aria-labelledby="overview-title">
            <section class="page-heading" id="overview" aria-labelledby="overview-title">
              <div><p class="eyebrow">BUSINESS PERFORMANCE</p><h1 id="overview-title" data-overview-title>Business overview</h1><p class="page-subtitle" data-page-subtitle>Built from the records you imported.</p></div>
              <div class="heading-actions"><span class="data-badge"><span></span><span data-data-badge>Imported CSV</span></span><button class="button button-primary" type="button" data-export-report><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 17v3h16v-3"/></svg>Export CSV</button></div>
            </section>

            <div class="dataset-summary" data-dataset-summary role="status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5 12 2l8 3.5v13L12 22l-8-3.5v-13Z"/><path d="m4 5.5 8 3.8 8-3.8M12 9.3V22"/></svg><div><strong data-dataset-name>Workspace data</strong><p data-dataset-detail></p></div><button class="text-button" type="button" data-create-workspace>＋ Add workspace</button></div>

            <section class="kpi-grid" aria-label="Key business metrics">
              <article class="metric-card metric-revenue"><div class="metric-topline"><span class="metric-label" data-revenue-label>Total revenue</span><span class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M17 7.5c0-1.7-2.2-3-5-3s-5 1.3-5 3 2 2.5 5 3 5 1.3 5 3-2.2 3-5 3-5-1.3-5-3"/></svg></span></div><strong class="metric-value" data-kpi="revenue">—</strong><div class="metric-foot"><span class="metric-note" data-revenue-note>Needs a revenue or amount column</span></div></article>
              <article class="metric-card"><div class="metric-topline"><span class="metric-label" data-record-label>Imported records</span><span class="metric-icon icon-blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg></span></div><strong class="metric-value" data-kpi="records">—</strong><div class="metric-foot"><span class="metric-note" data-record-note>Rows in this dataset</span></div></article>
              <article class="metric-card"><div class="metric-topline"><span class="metric-label" data-customer-label>Unique customers</span><span class="metric-icon icon-amber"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-1.5A4.5 4.5 0 0 1 8 14h2a4.5 4.5 0 0 1 4.5 4.5V20M16 5.5a3 3 0 0 1 0 5.5M17 14.5a4.5 4.5 0 0 1 3.5 4.5v1"/></svg></span></div><strong class="metric-value" data-kpi="customers">—</strong><div class="metric-foot"><span class="metric-note" data-customer-note>Needs a customer identifier</span></div></article>
              <article class="metric-card"><div class="metric-topline"><span class="metric-label">Average order value</span><span class="metric-icon icon-rose"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18 9 13l4 3 7-9"/><path d="M14 7h6v6"/></svg></span></div><strong class="metric-value" data-kpi="average">—</strong><div class="metric-foot"><span class="metric-note" data-average-note>Calculated when revenue data is available</span></div></article>
            </section>

            <section class="content-grid" id="revenue">
              <article class="panel revenue-panel"><div class="panel-heading"><div><p class="eyebrow">TREND</p><h2>Revenue over time</h2><p class="panel-subtitle" data-chart-subtitle>Based on your imported date and revenue columns.</p></div><span class="panel-badge" data-trend-unit>Imported data</span></div><div class="chart-area" data-revenue-chart><div class="empty-panel">Import a dataset to see a revenue trend.</div></div></article>
              <article class="panel channel-panel"><div class="panel-heading"><div><p class="eyebrow">BREAKDOWN</p><h2 data-breakdown-title>Records by category</h2><p class="panel-subtitle" data-breakdown-subtitle>Detected from your fields.</p></div></div><div class="breakdown-content" data-breakdown-content><div class="empty-panel">A channel, category, or status column will appear here when available.</div></div></article>
            </section>

            <section class="panel records-panel" id="products"><div class="panel-heading records-heading"><div><p class="eyebrow">PRODUCT PERFORMANCE</p><h2 data-products-title>Product summary</h2><p class="panel-subtitle" data-products-subtitle>Grouped from the product fields in your file.</p></div><span class="table-count" data-product-count>—</span></div><div class="table-scroll"><table class="data-table"><thead data-product-head><tr><th scope="col">Product</th><th scope="col">Records</th><th scope="col">Revenue</th></tr></thead><tbody data-product-rows><tr><td colspan="3" class="table-empty">Import records to see product analysis.</td></tr></tbody></table></div></section>

            <section class="panel records-panel recent-panel" id="records"><div class="panel-heading records-heading"><div><p class="eyebrow">SOURCE DATA</p><h2>Imported records</h2><p class="panel-subtitle" data-records-subtitle>Preview of rows from your CSV file.</p></div><span class="table-count" data-row-count>—</span></div><div class="table-scroll"><table class="data-table"><thead data-record-head></thead><tbody data-record-rows><tr><td class="table-empty">No imported data.</td></tr></tbody></table></div></section>
            <div class="dashboard-bottom-actions"><button class="button button-outline" type="button" data-create-workspace>＋ Create another workspace</button><button class="text-button danger-text" type="button" data-delete-workspace>Remove this workspace</button></div>
          </section>
        </main>

        <footer class="app-footer"><a class="footer-brand" href="#overview">Metricline</a><span>Your imported data stays in this browser in this preview.</span><nav aria-label="Legal pages"><a href="/business-analytics/privacy">Privacy</a><a href="/business-analytics/terms">Terms</a><a href="/business-analytics/cookies">Cookies</a><a href="/business-analytics/privacy-settings">Privacy settings</a><a href="/business-analytics/user-agreement">User agreement</a></nav></footer>
      </div>
    </div>

    <dialog class="app-dialog" data-settings-dialog aria-labelledby="settings-title"><form method="dialog" class="dialog-top"><div><p class="eyebrow">PREFERENCES</p><h2 id="settings-title">Workspace settings</h2></div><button class="icon-button" aria-label="Close settings" value="close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></form><div class="settings-group"><div><strong>Appearance</strong><p>Choose the theme that works for you.</p></div><div class="settings-control"><button class="choice-button" type="button" data-settings-theme="light">Light</button><button class="choice-button" type="button" data-settings-theme="dark">Dark</button></div></div><div class="settings-group"><div><strong>Compact tables</strong><p>Fit more records on screen.</p></div><label class="switch"><input type="checkbox" data-compact-toggle/><span></span></label></div><div class="settings-group"><div><strong>Reduce motion</strong><p>Use shorter transitions and less movement.</p></div><label class="switch"><input type="checkbox" data-motion-toggle/><span></span></label></div><div class="settings-group"><div><strong>Local data</strong><p>Imported workspace files are stored in this browser's IndexedDB. Clearing site data removes them.</p></div><span class="setting-status">Browser only</span></div><div class="dialog-actions"><a class="button button-outline" href="/business-analytics/privacy-settings">Privacy settings</a><button class="button button-primary" type="button" data-save-settings>Save preferences</button></div></dialog>
    <dialog class="app-dialog small-dialog" data-notifications-dialog aria-labelledby="notifications-title"><form method="dialog" class="dialog-top"><div><p class="eyebrow">WORKSPACE STATUS</p><h2 id="notifications-title">Status and activity</h2></div><button class="icon-button" aria-label="Close status" value="close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></form><div class="status-message"><span class="status-dot"></span><div><strong data-status-title>No workspace is active</strong><p data-status-message>Create a workspace and import a CSV file to start analysing your own data.</p></div></div><p class="dialog-help">This preview runs analysis locally in your browser and does not send your spreadsheet to a backend service.</p></dialog>
    <dialog class="app-dialog privacy-dialog" data-privacy-dialog aria-labelledby="privacy-title"><form method="dialog" class="dialog-top"><div><p class="eyebrow">YOUR CHOICE</p><h2 id="privacy-title">Privacy preferences</h2></div><button class="icon-button" aria-label="Close privacy preferences" value="close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></form><div class="settings-group"><div><strong>Essential local storage</strong><p>Used to remember theme and workspace preferences. This is required for this browser-only preview.</p></div><span class="setting-status">Always active</span></div><div class="settings-group"><div><strong>Analytics and advertising</strong><p>No analytics or advertising trackers are installed by this preview.</p></div><span class="setting-status">Not installed</span></div><div class="dialog-actions"><button class="button button-outline" type="button" data-cookie-choice="reject">Reject optional</button><button class="button button-primary" type="button" data-cookie-choice="necessary">Save necessary only</button></div><nav class="dialog-legal-links"><a href="/business-analytics/privacy">Privacy policy</a><a href="/business-analytics/cookies">Cookie policy</a><a href="/business-analytics/cookies/essential">Essential storage</a><a href="/business-analytics/cookies/necessary">Necessary storage</a><a href="/business-analytics/cookies/reject">Reject optional cookies</a></nav></dialog>

    <section class="cookie-banner" data-cookie-banner hidden aria-label="Privacy preferences"><div><strong>Privacy choices</strong><p>This preview uses essential browser storage for workspace data and preferences. Optional tracking is not installed.</p></div><div class="cookie-actions"><button class="button button-outline" type="button" data-cookie-choice="reject">Reject optional</button><button class="button button-primary" type="button" data-cookie-choice="necessary">Necessary only</button><button class="text-button" type="button" data-open-privacy>Manage</button></div></section>
    <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6"/></svg><span>Top</span></button>
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script is:inline>
      (() => {
        const $ = (selector, root = document) => root.querySelector(selector);
        const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
        const root = document.documentElement;
        const toast = $('[data-toast]');
        const setupView = $('[data-setup-view]');
        const dashboardView = $('[data-dashboard-view]');
        const workspaceForm = $('[data-workspace-form]');
        const fileInput = $('[data-workspace-file]');
        const fileLabel = $('[data-file-label]');
        const fileHelper = $('[data-file-helper]');
        const fileChip = $('[data-file-chip]');
        const csvPreview = $('[data-csv-preview]');
        const createSubmit = $('[data-create-submit]');
        const setupFeedback = $('[data-setup-feedback]');
        const workspacePicker = $('[data-workspace-picker]');
        const globalSearch = $('[data-global-search]');
        const backToTop = $('[data-back-to-top]');
        const settingsDialog = $('[data-settings-dialog]');
        const privacyDialog = $('[data-privacy-dialog]');
        const notificationsDialog = $('[data-notifications-dialog]');
        const cookieBanner = $('[data-cookie-banner]');
        const sidebar = $('#app-sidebar');
        const mobileScrim = $('[data-close-mobile-nav]');
        let toastTimer = null;
        let selectedFile = null;
        let selectedParsed = null;
        let activeWorkspace = null;
        let workspaces = [];
        let compactTables = false;
        let reduceMotion = false;
        let searchTerm = '';

        const DB_NAME = 'metricline-workspaces-v1';
        const STORE_NAME = 'workspaces';
        const ACTIVE_KEY = 'metricline-active-workspace-v1';

        function safeStore(key, value) { try { localStorage.setItem(key, value); } catch {} }
        function safeRead(key) { try { return localStorage.getItem(key); } catch { return null; } }
        function openDatabase() {
          return new Promise((resolve, reject) => {
            if (!('indexedDB' in window)) { reject(new Error('This browser does not support local workspace storage.')); return; }
            const request = indexedDB.open(DB_NAME, 1);
            request.onupgradeneeded = () => {
              const database = request.result;
              if (!database.objectStoreNames.contains(STORE_NAME)) database.createObjectStore(STORE_NAME, { keyPath: 'key' });
            };
            request.onsuccess = () => resolve(request.result);
            request.onerror = () => reject(new Error('Could not open local workspace storage.'));
          });
        }
        async function dbRun(mode, action, value) {
          const database = await openDatabase();
          return new Promise((resolve, reject) => {
            const transaction = database.transaction(STORE_NAME, mode);
            const store = transaction.objectStore(STORE_NAME);
            let request;
            if (action === 'put') request = store.put(value);
            else if (action === 'get') request = store.get(value);
            else if (action === 'getAll') request = store.getAll();
            else if (action === 'delete') request = store.delete(value);
            if (request) {
              request.onsuccess = () => resolve(request.result);
              request.onerror = () => reject(new Error('Workspace storage operation failed.'));
            } else {
              transaction.oncomplete = () => resolve(true);
              transaction.onerror = () => reject(new Error('Workspace storage operation failed.'));
            }
            transaction.oncomplete = () => { if (action === 'put' || action === 'delete') resolve(true); database.close(); };
            transaction.onerror = () => { database.close(); reject(new Error('Workspace storage operation failed.')); };
          });
        }
        function openDialog(dialog) { if (dialog && !dialog.open) dialog.showModal(); }
        function closeDialog(dialog) { if (dialog?.open) dialog.close(); }
        function showToast(message, isError = false) {
          if (!toast) return;
          toast.textContent = message;
          toast.classList.toggle('is-error', isError);
          toast.classList.add('is-visible');
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 3200);
        }
        function escapeHtml(value) {
          return String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
        }
        function setTheme(theme) {
          const dark = theme === 'dark';
