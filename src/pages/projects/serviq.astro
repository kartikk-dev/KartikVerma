<script define:vars={{ workOrders, technicians }}>
  const state = {
    currentView: "overview",
    selectedWorkOrder: null,
    workOrders: [...workOrders],
    technicians: [...technicians],
  };

  const sidebar = document.querySelector("#sidebar");
  const mobileMenu = document.querySelector("#mobile-menu");
  const sidebarClose = document.querySelector("#sidebar-close");
  const mobileOverlay = document.querySelector("#mobile-overlay");

  const modalRoot = document.querySelector("#modal-root");
  const modalBackdrop = document.querySelector("#modal-backdrop");
  const modalClose = document.querySelector("#modal-close");

  const toastElement = document.querySelector("#toast");
  const globalSearch = document.querySelector("#global-search");
  const breadcrumbCurrent = document.querySelector("#breadcrumb-current");

  const viewLabels = {
    overview: "Overview",
    "work-orders": "Work Orders",
    dispatch: "Dispatch",
    technicians: "Technicians",
    customers: "Customers",
    inventory: "Inventory",
    invoices: "Invoices",
    analytics: "Analytics",
  };

  const showToast = (message) => {
    if (!toastElement) return;

    toastElement.textContent = message;
    toastElement.classList.add("show");

    window.clearTimeout(showToast.timer);

    showToast.timer = window.setTimeout(() => {
      toastElement.classList.remove("show");
    }, 2600);
  };

  const closeSidebar = () => {
    sidebar?.classList.remove("open");
    mobileOverlay?.classList.remove("show");
    document.body.classList.remove("menu-open");
  };

  const openSidebar = () => {
    sidebar?.classList.add("open");
    mobileOverlay?.classList.add("show");
    document.body.classList.add("menu-open");
  };

  const switchView = (viewName) => {
    const panels = document.querySelectorAll("[data-panel]");
    const navItems = document.querySelectorAll(".nav-item[data-view]");

    panels.forEach((panel) => {
      panel.classList.toggle(
        "active",
        panel.getAttribute("data-panel") === viewName,
      );
    });

    navItems.forEach((item) => {
      item.classList.toggle(
        "active",
        item.getAttribute("data-view") === viewName,
      );
    });

    state.currentView = viewName;

    if (breadcrumbCurrent) {
      breadcrumbCurrent.textContent = viewLabels[viewName] || "Overview";
    }

    closeSidebar();

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  document.querySelectorAll(".nav-item[data-view]").forEach((button) => {
    button.addEventListener("click", () => {
      switchView(button.dataset.view || "overview");
    });
  });

  document
    .querySelectorAll("[data-view].view-all-button, [data-view].panel-link")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const view = button.dataset.view;

        if (view) {
          switchView(view);
        }
      });
    });

  mobileMenu?.addEventListener("click", openSidebar);
  sidebarClose?.addEventListener("click", closeSidebar);
  mobileOverlay?.addEventListener("click", closeSidebar);

  const getWorkOrder = (id) => state.workOrders.find((item) => item.id === id);

  const getStatusClass = (status = "") =>
    `status-${status.toLowerCase().replaceAll(" ", "-")}`;

  const openWorkOrder = (id) => {
    const order = getWorkOrder(id);

    if (!order || !modalRoot) return;

    state.selectedWorkOrder = order.id;

    const setText = (selector, value) => {
      const element = document.querySelector(selector);

      if (element) {
        element.textContent = value;
      }
    };

    setText("#modal-title", order.id);
    setText("#modal-subtitle", order.service);
    setText("#modal-priority", order.priority);
    setText("#modal-customer", order.customer);
    setText("#modal-location", order.location);
    setText("#modal-technician", order.technician);
    setText("#modal-scheduled", order.scheduled);
    setText("#modal-created", order.created);
    setText("#modal-amount", `₹${order.amount.toLocaleString("en-IN")}`);
    setText("#modal-issue", order.issue);

    const statusElement = document.querySelector("#modal-status");

    if (statusElement) {
      statusElement.className = `status-badge ${getStatusClass(order.status)}`;

      statusElement.innerHTML = `<i></i>${order.status}`;
    }

    modalRoot.hidden = false;
    document.body.classList.add("modal-open");

    window.requestAnimationFrame(() => {
      modalRoot.classList.add("show");
    });
  };

  const closeWorkOrder = () => {
    modalRoot?.classList.remove("show");
    document.body.classList.remove("modal-open");

    window.setTimeout(() => {
      if (modalRoot) {
        modalRoot.hidden = true;
      }
    }, 180);
  };

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const workOrderButton = target.closest(".work-order-trigger");

    if (workOrderButton) {
      const workOrderId = workOrderButton.getAttribute("data-work-order");

      if (workOrderId) {
        openWorkOrder(workOrderId);
      }
    }

    const technicianButton = target.closest("[data-tech]");

    if (technicianButton && !technicianButton.classList.contains("map-tech")) {
      const techId = technicianButton.getAttribute("data-tech");

      const tech = state.technicians.find((item) => item.id === techId);

      if (tech) {
        showToast(`${tech.name} · ${tech.status} · ${tech.jobs} jobs today`);
      }
    }

    const assignButton = target.closest("[data-assign]");

    if (assignButton) {
      showToast(`${assignButton.dataset.assign} added to dispatch queue.`);
    }
  });

  modalClose?.addEventListener("click", closeWorkOrder);
  modalBackdrop?.addEventListener("click", closeWorkOrder);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeWorkOrder();
      closeSidebar();
    }

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      globalSearch?.focus();
    }
  });

  const nextStatuses = [
    "New",
    "Assigned",
    "Accepted",
    "En Route",
    "Arrived",
    "Diagnosing",
    "In Progress",
    "Waiting for Parts",
    "Completed",
    "Invoiced",
    "Paid",
  ];

  document.querySelector("#modal-next")?.addEventListener("click", () => {
    const currentOrder = getWorkOrder(state.selectedWorkOrder);

    if (!currentOrder) return;

    const currentIndex = nextStatuses.indexOf(currentOrder.status);

    const nextStatus =
      nextStatuses[Math.min(nextStatuses.length - 1, currentIndex + 1)];

    if (nextStatus === currentOrder.status) {
      showToast(`${currentOrder.id} is already at ${currentOrder.status}.`);
      return;
    }

    currentOrder.status = nextStatus;

    openWorkOrder(currentOrder.id);

    showToast(`${currentOrder.id} moved to ${nextStatus}.`);

    refreshOverviewRows();
  });

  document.querySelector("#modal-reassign")?.addEventListener("click", () => {
    showToast("Technician reassignment queue opened.");
  });

  document.querySelector("#modal-invoice")?.addEventListener("click", () => {
    showToast("Invoice draft created.");
  });

  document
    .querySelectorAll("#new-work-order, #new-work-order-2")
    .forEach((button) => {
      button.addEventListener("click", () => {
        showToast("New Work Order workspace opened.");
      });
    });

  document.querySelector("#auto-assign")?.addEventListener("click", () => {
    showToast("Dispatch engine assigned the highest-priority open job.");
  });

  document.querySelector("#support-button")?.addEventListener("click", () => {
    showToast("Support center opened for the Operations workspace.");
  });

  document
    .querySelector("#notification-button")
    ?.addEventListener("click", () => {
      showToast("3 operational notifications need attention.");
    });

  document.querySelector("#export-button")?.addEventListener("click", () => {
    showToast("Operations report prepared for export.");
  });

  const refreshOverviewRows = () => {
    const rows = document.querySelectorAll("#operations-body tr");

    rows.forEach((row) => {
      const id = row
        .querySelector("[data-work-order]")
        ?.getAttribute("data-work-order");

      if (!id) return;

      const order = getWorkOrder(id);

      if (!order) return;

      const statusBadge = row.querySelector(".status-badge");

      if (statusBadge) {
        statusBadge.className = `status-badge ${getStatusClass(order.status)}`;

        statusBadge.innerHTML = `<i></i>${order.status}`;
      }

      row.dataset.status = order.status;
    });
  };

  document.querySelectorAll("[data-filter-status]").forEach((button) => {
    button.addEventListener("click", () => {
      document
        .querySelectorAll("[data-filter-status]")
        .forEach((item) => item.classList.remove("active"));

      button.classList.add("active");

      const filter = button.getAttribute("data-filter-status");

      document.querySelectorAll("#operations-body tr").forEach((row) => {
        const status = row.dataset.status || "";

        let visible = true;

        if (filter === "active") {
          visible =
            status !== "Completed" &&
            status !== "Paid" &&
            status !== "Invoiced";
        }

        if (filter === "completed") {
          visible =
            status === "Completed" ||
            status === "Invoiced" ||
            status === "Paid";
        }

        row.style.display = visible ? "" : "none";
      });
    });
  });

  const normalize = (value = "") =>
    value.toLowerCase().trim().replace(/\s+/g, " ");

  globalSearch?.addEventListener("input", () => {
    const query = normalize(globalSearch.value);

    if (!query) {
      document
        .querySelectorAll("#operations-body tr")
        .forEach((row) => (row.style.display = ""));

      return;
    }

    document.querySelectorAll("#operations-body tr").forEach((row) => {
      const searchable = normalize(row.getAttribute("data-search") || "");

      row.style.display = searchable.includes(query) ? "" : "none";
    });

    if (state.currentView !== "work-orders") {
      switchView("work-orders");
    }
  });
</script>

