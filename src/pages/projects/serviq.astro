---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="SERVIQ - Field service operations management for work orders, dispatch, technicians, inventory, invoices and service analytics."
    />
    <meta name="theme-color" content="#07100d" />
    <title>SERVIQ - Field Operations, Under Control.</title>
  </head>

  <body>
    <main class="serviq-app">
      <aside class="sidebar" id="sidebar">
        <div class="brand">
          <a href="/" class="brand-mark" aria-label="Back to portfolio">
            <span class="brand-symbol">
              <i></i>
              <i></i>
              <i></i>
            </span>

            <span>
              <strong>SERVIQ</strong>
              <small>Field Operations</small>
            </span>
          </a>

          <button
            type="button"
            class="sidebar-close"
            id="sidebar-close"
            aria-label="Close navigation"
          >
            ×
          </button>
        </div>

        <div class="workspace-switcher">
          <span class="workspace-avatar">KV</span>

          <div>
            <strong>Kartik Verma</strong>
            <small>Operations workspace</small>
          </div>

          <span class="workspace-arrow">⌄</span>
        </div>

        <nav class="side-nav" aria-label="SERVIQ navigation">
          <div class="nav-group">
            <span class="nav-label">OPERATIONS</span>

            <button class="nav-item active" data-view="overview">
              <span class="nav-icon">◈</span>
              <span>Overview</span>
              <b>⌘1</b>
            </button>

            <button class="nav-item" data-view="work-orders">
              <span class="nav-icon">▣</span>
              <span>Work Orders</span>
              <em>6</em>
            </button>

            <button class="nav-item" data-view="dispatch">
              <span class="nav-icon">⌁</span>
              <span>Dispatch</span>
              <em class="pulse-count">3</em>
            </button>
          </div>

          <div class="nav-group">
            <span class="nav-label">RESOURCES</span>

            <button class="nav-item" data-view="technicians">
              <span class="nav-icon">◎</span>
              <span>Technicians</span>
            </button>

            <button class="nav-item" data-view="customers">
              <span class="nav-icon">◌</span>
              <span>Customers</span>
            </button>

            <button class="nav-item" data-view="inventory">
              <span class="nav-icon">□</span>
              <span>Inventory</span>
              <em class="warning-count">2</em>
            </button>
          </div>

          <div class="nav-group">
            <span class="nav-label">FINANCE</span>

            <button class="nav-item" data-view="invoices">
              <span class="nav-icon">◫</span>
              <span>Invoices</span>
            </button>

            <button class="nav-item" data-view="analytics">
              <span class="nav-icon">↗</span>
              <span>Analytics</span>
            </button>
          </div>
        </nav>

        <div class="sidebar-bottom">
          <button class="support-card" type="button" id="support-button">
            <span class="support-orb">?</span>
            <span>
              <strong>Need help?</strong>
              <small>Open support center</small>
            </span>
            <span>↗</span>
          </button>

          <div class="sidebar-user">
            <div class="user-avatar">K</div>

            <div>
              <strong>Kartik Verma</strong>
              <small>Administrator</small>
            </div>

            <button type="button" aria-label="Account menu">
              •••
            </button>
          </div>
        </div>
      </aside>

      <div class="page-shell">
        <header class="topbar">
          <button
            type="button"
            class="mobile-menu"
            id="mobile-menu"
            aria-label="Open navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>

          <div class="breadcrumb">
            <span>SERVIQ</span>
            <i>/</i>
            <strong id="breadcrumb-current">Overview</strong>
          </div>

          <div class="topbar-center">
            <div class="global-search">
              <span>⌕</span>
              <input
                type="search"
                id="global-search"
                placeholder="Search work orders, customers, technicians..."
                autocomplete="off"
              />
              <kbd>⌘ K</kbd>
            </div>
          </div>

          <div class="topbar-actions">
            <a href="/" class="portfolio-back" aria-label="Back to portfolio">
              <span class="portfolio-back-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M11.5 4.25L6 10L11.5 15.75"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M6.25 10H16"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
              <span class="portfolio-back-label">Portfolio</span>
            </a>

            <button
              class="icon-button"
              type="button"
              aria-label="Notifications"
              id="notification-button"
            >
              <span class="notification-dot"></span>◔
            </button>

            <button class="date-button" type="button" id="date-button">
              <span>08 OCT 2026</span>
              <b>Today</b>
            </button>

            <button class="topbar-avatar" type="button" aria-label="Profile">
              K
            </button>
          </div>
        </header>

        <section class="page-content">
          <div class="view view-overview active" data-panel="overview">
            <div class="page-heading">
              <div>
                <span class="eyebrow">THURSDAY · 08 OCTOBER 2026</span>
                <h1>
                  Good afternoon,
                  <em>Kartik.</em>
                </h1>
                <p>
                  Here is what is happening across your field operations today.
                </p>
              </div>

              <div class="heading-actions">
                <button
                  class="secondary-action"
                  id="export-button"
                  type="button"
                >
                  <span>↓</span>
                  Export
                </button>

                <button
                  class="primary-action"
                  id="new-work-order"
                  type="button"
                >
                  <span>+</span>
                  New Work Order
                </button>
              </div>
            </div>

            <section class="metric-grid">
              <article class="metric-card accent-gold">
                <div class="metric-head">
                  <span>OPEN WORK ORDERS</span>
                  <span class="metric-icon">▣</span>
                </div>

                <div class="metric-main">
                  <strong>24</strong>
                  <span class="metric-up">+12.4%</span>
                </div>

                <div class="metric-foot">
                  <span>vs. yesterday</span>
                  <span>18 scheduled today</span>
                </div>
              </article>

              <article class="metric-card accent-green">
                <div class="metric-head">
                  <span>ACTIVE TECHNICIANS</span>
                  <span class="metric-icon">◎</span>
                </div>

                <div class="metric-main">
                  <strong>08</strong>
                  <span class="metric-up">+2 today</span>
                </div>

                <div class="metric-foot">
                  <span>6 working</span>
                  <span>2 available</span>
                </div>
              </article>

              <article class="metric-card accent-violet">
                <div class="metric-head">
                  <span>AVG. RESOLUTION</span>
                  <span class="metric-icon">◷</span>
                </div>

                <div class="metric-main">
                  <strong>2h 14m</strong>
                  <span class="metric-down">−18m</span>
                </div>

                <div class="metric-foot">
                  <span>this week</span>
                  <span>Target · 2h 30m</span>
                </div>
              </article>

              <article class="metric-card accent-blue">
                <div class="metric-head">
                  <span>REVENUE THIS MONTH</span>
                  <span class="metric-icon">₹</span>
                </div>

                <div class="metric-main">
                  <strong>₹8.42L</strong>
                  <span class="metric-up">+18.8%</span>
                </div>

                <div class="metric-foot">
                  <span>vs. last month</span>
                  <span>₹2.1L outstanding</span>
                </div>
              </article>
            </section>

            <section class="dashboard-grid">
              <article class="panel operations-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-label">LIVE OPERATIONS</span>
                    <h2>Today's work orders</h2>
                  </div>

                  <div class="panel-actions">
                    <button
                      type="button"
                      class="filter-pill active"
                      data-filter-status="all"
                    >
                      All
                    </button>
                    <button
                      type="button"
                      class="filter-pill"
                      data-filter-status="active"
                    >
                      Active
                    </button>
                    <button
                      type="button"
                      class="filter-pill"
                      data-filter-status="completed"
                    >
                      Completed
                    </button>
                  </div>
                </div>

                <div class="table-wrap">
                  <table class="operations-table">
                    <thead>
                      <tr>
                        <th>WORK ORDER</th>
                        <th>CUSTOMER</th>
                        <th>SERVICE</th>
                        <th>TECHNICIAN</th>
                        <th>STATUS</th>
                        <th>AMOUNT</th>
                        <th></th>
                      </tr>
                    </thead>

                    <tbody id="operations-body">
                      {workOrders.map((order) => (
                        <tr
                          data-status={order.status}
                          data-search={`${order.id} ${order.customer} ${order.service} ${order.technician}`}
                        >
                          <td>
                            <button
                              type="button"
                              class="table-link work-order-trigger"
                              data-work-order={order.id}
                            >
                              {order.id}
                            </button>
                          </td>

                          <td>
                            <div class="customer-cell">
                              <span class="mini-avatar">
                                {order.customer
                                  .split(" ")
                                  .map((word) => word[0])
                                  .join("")}
                              </span>

                              <div>
                                <strong>{order.customer}</strong>
                                <small>{order.location}</small>
                              </div>
                            </div>
                          </td>

                          <td>
                            <div class="service-cell">
                              <strong>{order.service}</strong>
                              <small>{order.category}</small>
                            </div>
                          </td>

                          <td>
                            <div class="technician-mini">
                              <span
                                class={`tech-dot ${order.status === "En Route" ? "blue" : order.status === "In Progress" ? "gold" : "green"}`}
                              ></span>
                              {order.technician}
                            </div>
                          </td>

                          <td>
                            <span
                              class={`status-badge status-${order.status.toLowerCase().replaceAll(" ", "-")}`}
                            >
                              <i></i>
                              {order.status}
                            </span>
                          </td>

                          <td>
                            <strong class="amount">
                              ₹{order.amount.toLocaleString("en-IN")}
                            </strong>
                          </td>

                          <td>
                            <button
                              class="row-menu work-order-trigger"
                              type="button"
                              data-work-order={order.id}
                              aria-label={`Open ${order.id}`}
                            >
                              •••
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div class="panel-footer">
                  <button
                    type="button"
                    class="view-all-button"
                    data-view="work-orders"
                  >
                    View all work orders
                    <span>↗</span>
                  </button>
                </div>
              </article>

              <article class="panel dispatch-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-label">FIELD CONTROL</span>
                    <h2>Live dispatch</h2>
                  </div>

                  <span class="live-pill">
                    <i></i>
                    Live
                  </span>
                </div>

                <div class="map-shell">
                  <div class="map-grid-lines"></div>

                  <div class="map-road road-a"></div>
                  <div class="map-road road-b"></div>
                  <div class="map-road road-c"></div>
                  <div class="map-road road-d"></div>

                  <div class="map-label label-a">Rajpur Rd</div>
                  <div class="map-label label-b">Jakhan</div>
                  <div class="map-label label-c">Ballupur</div>
                  <div class="map-label label-d">Clement Town</div>

                  <div class="map-route route-a"></div>
                  <div class="map-route route-b"></div>

                  <button
                    class="map-tech tech-a"
                    type="button"
                    data-tech="tech-01"
                  >
                    <span>RM</span>
                  </button>

                  <button
                    class="map-tech tech-b"
                    type="button"
                    data-tech="tech-02"
                  >
                    <span>AR</span>
                  </button>

                  <button
                    class="map-tech tech-c"
                    type="button"
                    data-tech="tech-03"
                  >
                    <span>PJ</span>
                  </button>

                  <div class="map-home">⌂</div>

                  <div class="map-card">
                    <span>ACTIVE FIELD</span>
                    <strong>6 technicians</strong>
                    <small>3 routes in motion</small>
                  </div>
                </div>

                <div class="dispatch-list">
                  {technicians.slice(0, 3).map((tech) => (
                    <button
                      type="button"
                      class="dispatch-row"
                      data-tech={tech.id}
                    >
                      <span class={`tech-avatar ${tech.color}`}>
                        {tech.initials}
                      </span>

                      <span>
                        <strong>{tech.name}</strong>
                        <small>
                          {tech.zone} · {tech.jobs} jobs today
                        </small>
                      </span>

                      <span
                        class={`availability-dot ${tech.status === "Working" ? "working" : tech.status === "En Route" ? "route" : "available"}`}
                      ></span>
                    </button>
                  ))}
                </div>
              </article>
            </section>

            <section class="lower-grid">
              <article class="panel workload-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-label">TEAM LOAD</span>
                    <h2>Technician performance</h2>
                  </div>

                  <button
                    type="button"
                    class="panel-link"
                    data-view="technicians"
                  >
                    Manage team ↗
                  </button>
                </div>

                <div class="technician-list">
                  {technicians.map((tech) => (
                    <div class="performance-row">
                      <div class="performance-person">
                        <span class={`tech-avatar ${tech.color}`}>
                          {tech.initials}
                        </span>

                        <div>
                          <strong>{tech.name}</strong>
                          <small>{tech.role}</small>
                        </div>
                      </div>

                      <div class="performance-progress">
                        <div class="progress-meta">
                          <span>{tech.jobs} assigned</span>
                          <strong>{tech.rating} ★</strong>
                        </div>

                        <div class="progress-track">
                          <span
                            style={`width:${Math.min(92, 35 + tech.jobs * 14)}%`}
                          ></span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </article>

              <article class="panel revenue-panel">
                <div class="panel-heading">
                  <div>
                    <span class="panel-label">REVENUE</span>
                    <h2>Weekly performance</h2>
                  </div>

                  <span class="chart-value">₹5.57L</span>
                </div>

                <div class="chart">
                  <div class="chart-grid">
                    <span>₹1.0L</span>
                    <span>₹75K</span>
                    <span>₹50K</span>
                    <span>₹25K</span>
                    <span>₹0</span>
                  </div>

                  <div class="chart-bars">
                    {revenueData.map((item) => (
                      <div class="bar-item">
                        <div
                          class="bar"
                          style={`height:${(item.value / maxRevenue) * 92}%`}
                        >
                          <span>₹{Math.round(item.value / 1000)}K</span>
                        </div>

                        <small>{item.day}</small>
                      </div>
                    ))}
                  </div>
                </div>
              </article>
            </section>

            <section class="activity-strip">
              <span class="activity-live">
                <i></i>
                LIVE ACTIVITY
              </span>

              <div class="activity-marquee" id="activity-marquee">
                <span>Rahul checked in at WO-1048</span>
                <i>·</i>
                <span>Invoice INV-2026-0181 marked paid</span>
                <i>·</i>
                <span>New electrical service request received</span>
                <i>·</i>
                <span>Priya completed solar inspection</span>
              </div>
