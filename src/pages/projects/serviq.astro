  }

  .wo-card-footer {
    margin-top: 0.85rem;
  }

  .wo-card-footer > strong {
    color: #dbe1da;
    font-size: 0.56rem;
  }

  .dispatch-page-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(300px, 0.65fr);

    gap: 0.8rem;
  }

  .dispatch-columns {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 0.7rem;

    margin-top: 1rem;
  }

  .dispatch-column {
    padding: 0.75rem;

    border: 1px solid rgba(231, 239, 231, 0.05);

    border-radius: 0.9rem;

    background: rgba(255, 255, 255, 0.012);
  }

  .column-heading {
    display: flex;
    justify-content: space-between;

    margin-bottom: 0.55rem;

    color: #66736b;

    font-size: 0.46rem;

    letter-spacing: 0.1em;
  }

  .column-heading b {
    color: #8f9c94;
  }

  .dispatch-work-card {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;

    padding: 0.75rem;

    margin-bottom: 0.45rem;

    border: 1px solid rgba(231, 239, 231, 0.06);

    border-radius: 0.75rem;

    background: rgba(255, 255, 255, 0.02);
  }

  .dispatch-work-card > span {
    color: var(--gold);

    font-size: 0.44rem;

    font-weight: 800;
  }

  .dispatch-work-card strong {
    font-size: 0.56rem;
  }

  .dispatch-work-card small {
    color: #67736b;
    font-size: 0.44rem;
  }

  .dispatch-work-card button {
    margin-top: 0.3rem;

    min-height: 28px;

    border: 1px solid var(--line);

    border-radius: 0.48rem;

    background: rgba(255, 255, 255, 0.02);

    color: #98a49d;

    cursor: pointer;

    font-size: 0.45rem;
  }

  .active-route,
  .dispatch-work-card.working {
    border-color: rgba(127, 174, 215, 0.12);
  }

  .mini-route-line,
  .working-line {
    display: flex;
    align-items: center;

    gap: 0.4rem;

    margin-top: 0.15rem;

    color: #65736b;

    font-size: 0.43rem;
  }

  .mini-route-line i,
  .working-line span {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--blue);
  }

  .working-line span {
    background: var(--gold);
  }

  .field-team-list {
    display: grid;
    gap: 0.15rem;
  }

  .field-team-row {
    grid-template-columns:
      30px
      minmax(0, 1fr)
      auto;

    padding: 0.72rem 0.2rem;
  }

  .field-state {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;

    color: #728078;

    font-size: 0.45rem;
  }

  .field-state i {
    width: 5px;
    height: 5px;

    border-radius: 50%;
  }

  .field-state i.available {
    background: var(--green);
  }

  .field-state i.route {
    background: var(--blue);
  }

  .field-state i.working {
    background: var(--gold);
  }

  .profile-grid,
  .customer-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 0.8rem;
  }

  .profile-card,
  .customer-card {
    padding: 1rem;
  }

  .profile-card-top,
  .customer-card-header {
    display: flex;

    align-items: center;

    justify-content: space-between;
  }

  .card-more,
  .customer-card-header button {
    border: 0;
    background: transparent;
    color: #59675f;
    cursor: pointer;
  }

  .profile-card h3,
  .customer-card h3 {
    margin: 1rem 0 0.2rem;

    font-size: 0.9rem;
  }

  .profile-card > p,
  .customer-card > small {
    color: #69766e;
    font-size: 0.5rem;
  }

  .profile-status {
    display: inline-flex;
    align-items: center;

    gap: 0.35rem;

    margin-top: 0.72rem;

    color: #87948c;

    font-size: 0.48rem;
  }

  .profile-status i {
    width: 5px;
    height: 5px;

    border-radius: 50%;
  }

  .profile-status i.available {
    background: var(--green);
  }

  .profile-status i.route {
    background: var(--blue);
  }

  .profile-status i.working {
    background: var(--gold);
  }

  .profile-stats,
  .customer-value {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 0.35rem;

    margin-top: 1rem;
  }

  .profile-stats > div,
  .customer-value > div {
    padding: 0.55rem;

    border: 1px solid rgba(231, 239, 231, 0.06);

    border-radius: 0.6rem;

    background: rgba(255, 255, 255, 0.015);
  }

  .profile-stats span,
  .customer-value span {
    display: block;

    color: #5d6a62;

    font-size: 0.39rem;

    letter-spacing: 0.08em;
  }

  .profile-stats strong,
  .customer-value strong {
    display: block;

    margin-top: 0.2rem;

    color: #d9dfd8;

    font-size: 0.55rem;
  }

  .profile-card-button {
    width: 100%;

    min-height: 34px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-top: 0.9rem;

    padding: 0 0.68rem;

    border: 1px solid var(--line);

    border-radius: 0.6rem;

    background: rgba(255, 255, 255, 0.02);

    color: #9aa59e;

    cursor: pointer;

    font-size: 0.48rem;
  }

  .large-customer-avatar {
    width: 46px;
    height: 46px;

    border-radius: 1rem;

    color: var(--gold-bright);

    background: rgba(217, 199, 139, 0.08);

    border: 1px solid rgba(217, 199, 139, 0.12);

    font-size: 0.6rem;
  }

  .customer-meta {
    display: grid;
    gap: 0.32rem;

    margin-top: 0.9rem;

    color: #6d7971;

    font-size: 0.47rem;
  }

  .customer-value {
    grid-template-columns: repeat(2, 1fr);
  }

  .inventory-summary {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 0.65rem;

    margin-bottom: 1rem;
  }

  .inventory-summary-card {
    padding: 0.85rem;

    border: 1px solid var(--line);

    border-radius: 0.82rem;

    background: rgba(255, 255, 255, 0.018);
  }

  .inventory-summary-card span,
  .invoice-summary span {
    display: block;

    color: #59675f;

    font-size: 0.43rem;

    letter-spacing: 0.12em;

    font-weight: 800;
  }

  .inventory-summary-card strong {
    display: block;

    margin-top: 0.42rem;

    font-size: 1.25rem;
  }

  .inventory-summary-card small {
    display: block;

    margin-top: 0.23rem;

    color: #68746c;

    font-size: 0.44rem;
  }

  .inventory-summary-card.warning strong,
  .text-warning {
    color: var(--orange);
  }

  .inventory-summary-card.danger strong,
  .text-danger {
    color: var(--red);
  }

  .inventory-table {
    display: grid;
  }

  .inventory-row {
    display: grid;

    grid-template-columns:
      1.6fr
      0.5fr
      1.4fr
      0.55fr;

    gap: 1rem;

    align-items: center;

    padding: 0.82rem 0;

    border-bottom: 1px solid rgba(231, 239, 231, 0.05);
  }

  .inventory-row > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .inventory-row strong {
    color: #dce1dc;
    font-size: 0.56rem;
  }

  .inventory-row small {
    color: #637067;
    font-size: 0.43rem;
  }

  .inventory-health {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap: 0.6rem;

    align-items: center;
  }

  .stock-track {
    height: 5px;

    overflow: hidden;

    border-radius: 999px;

    background: rgba(255, 255, 255, 0.04);
  }

  .stock-track span {
    display: block;

    height: 100%;

    border-radius: inherit;

    background: linear-gradient(90deg, rgba(128, 184, 151, 0.2), var(--green));
  }

  .stock-track span.low {
    background: linear-gradient(
      90deg,
      rgba(213, 161, 109, 0.18),
      var(--orange)
    );
  }

  .stock-track span.critical {
    background: linear-gradient(90deg, rgba(215, 137, 125, 0.18), var(--red));
  }

  .inventory-action,
  .invoice-open {
    border: 1px solid var(--line);

    border-radius: 0.5rem;

    min-height: 30px;

    background: rgba(255, 255, 255, 0.02);

    color: #97a39c;

    cursor: pointer;

    font-size: 0.44rem;
  }

  .invoice-summary {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 0.75rem;

    margin-bottom: 0.8rem;
  }

  .invoice-summary > div {
    padding: 1rem;

    border: 1px solid var(--line);

    border-radius: var(--radius-lg);

    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    );
  }

  .invoice-summary strong {
    display: block;

    margin-top: 0.4rem;

    font-size: 1.4rem;
  }

  .invoice-summary small {
    display: block;

    margin-top: 0.2rem;

    color: #657168;

    font-size: 0.46rem;
  }

  .invoice-list {
    display: grid;
  }

  .invoice-row {
    display: grid;

    grid-template-columns:
      1.2fr
      1fr
      0.8fr
      0.7fr
      auto;

    align-items: center;

    gap: 1rem;

    padding: 0.85rem 0;

    border-bottom: 1px solid rgba(231, 239, 231, 0.05);
  }

  .invoice-row > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .invoice-row strong {
    font-size: 0.56rem;
  }

  .invoice-row small,
  .invoice-row span {
    color: #66736b;
    font-size: 0.44rem;
  }

  .invoice-status {
    justify-self: start;
  }

  .invoice-status.paid {
    color: var(--green);
    background: rgba(128, 184, 151, 0.08);
  }

  .invoice-status.draft {
    color: var(--gold);
    background: rgba(217, 199, 139, 0.08);
  }

  .invoice-status.overdue {
    color: var(--red);
    background: rgba(215, 137, 125, 0.08);
  }

  .analytics-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 0.8rem;
  }

  .analytics-large {
    grid-column: span 2;
    min-height: 360px;
  }

  .analytics-stat {
    min-height: 360px;

    display: flex;
    flex-direction: column;

    align-items: flex-start;

    justify-content: flex-start;
  }

  .analytics-stat > strong {
    margin-top: 0.8rem;

    font-size: 2.3rem;

    letter-spacing: -0.05em;
  }

  .analytics-stat p {
    margin-top: auto;

    color: #66736b;

    font-size: 0.5rem;
  }

  .large-chart {
    height: 245px;

    display: flex;

    align-items: flex-end;

    gap: 0.8rem;

    padding-top: 1.5rem;
  }

  .large-bar-wrap {
    flex: 1;
    height: 100%;

    display: flex;
    flex-direction: column;

    justify-content: flex-end;
    align-items: center;

    gap: 0.5rem;
  }

  .large-bar {
    position: relative;

    width: min(34px, 70%);

    min-height: 22px;

    border-radius: 0.5rem 0.5rem 0.2rem 0.2rem;

    background: linear-gradient(
      180deg,
      rgba(217, 199, 139, 0.92),
      rgba(217, 199, 139, 0.12)
    );
  }

  .large-bar span {
    position: absolute;

    left: 50%;
    bottom: calc(100% + 5px);

    transform: translateX(-50%);

    opacity: 0;

    white-space: nowrap;

    color: var(--gold-bright);

    font-size: 0.4rem;
  }

  .large-bar-wrap:hover .large-bar span {
    opacity: 1;
  }

  .large-bar-wrap small {
    color: #657169;
    font-size: 0.43rem;
  }

  .circular-progress {
    position: relative;

    width: 145px;
    height: 145px;

    display: grid;
    place-items: center;

    margin: 1.6rem auto;

    border-radius: 50%;

    background: conic-gradient(
      var(--green) 0 87%,
      rgba(255, 255, 255, 0.05) 87% 100%
    );
  }

  .circular-progress::before {
    content: "";

    position: absolute;
    inset: 10px;

    border-radius: 50%;

    background: var(--panel-strong);
  }

  .circular-progress span {
    position: relative;
    z-index: 1;

    font-size: 1.5rem;
    font-weight: 800;

    color: #edf1eb;
  }

  .rating-dots {
    display: flex;
    gap: 0.45rem;

    margin-top: 2rem;
  }

  .rating-dots i {
    width: 15px;
    height: 15px;

    border-radius: 50%;

    background: var(--gold);
  }

  .rating-dots i.muted {
    background: rgba(255, 255, 255, 0.07);
  }

  .response-line {
    width: 100%;

    height: 7px;

    margin-top: 2rem;
  }

  .response-line span {
    background: linear-gradient(90deg, rgba(127, 174, 215, 0.2), var(--blue));
  }

  .modal-root {
    position: fixed;
    inset: 0;

    z-index: 500;

    display: grid;
    place-items: center;

    padding: 1rem;

    opacity: 0;

    transition: opacity 0.18s ease;
  }

  .modal-root.show {
    opacity: 1;
  }

  .modal-root[hidden] {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;

    border: 0;

    background: rgba(2, 7, 4, 0.82);

    backdrop-filter: blur(18px);

    cursor: pointer;
  }

  .work-order-modal {
    position: relative;
    z-index: 2;

    width: min(760px, 100%);

    max-height: min(88vh, 780px);

    overflow-y: auto;

    padding: 1.35rem;

    border: 1px solid var(--line-strong);

    border-radius: 1.4rem;

    background: linear-gradient(
      145deg,
      rgba(16, 29, 23, 0.98),
      rgba(6, 13, 9, 0.98)
    );

    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.58);

    transform: translateY(14px) scale(0.98);

    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-root.show .work-order-modal {
    transform: translateY(0) scale(1);
  }

  .modal-close {
    position: absolute;

    top: 1rem;
    right: 1rem;

    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border: 1px solid var(--line);

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.03);

    color: #98a49d;

    cursor: pointer;

    font-size: 0.9rem;
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 1rem;

    padding-right: 3rem;
  }

  .modal-header h2 {
    margin: 0;

    font:
      600 2.4rem / 1 "Playfair Display",
      Georgia,
      serif;
  }

  .modal-header p {
    margin: 0.35rem 0 0;

    color: #77837b;

    font-size: 0.65rem;
  }

  .modal-priority {
    padding: 0.36rem 0.55rem;

    border-radius: 999px;

    color: var(--red);
    background: rgba(215, 137, 125, 0.08);

    font-size: 0.46rem;
  }

  .modal-status-line {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    margin-top: 1rem;

    padding-bottom: 0.9rem;

    border-bottom: 1px solid var(--line);

    color: #5f6c64;

    font-size: 0.46rem;
  }

  .modal-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 0.7rem;

    margin-top: 0.9rem;
  }

  .modal-section {
    padding: 0.9rem;

    border: 1px solid rgba(231, 239, 231, 0.065);

    border-radius: var(--radius-md);

    background: rgba(255, 255, 255, 0.017);
  }

  .modal-section > span {
    display: block;

    margin-bottom: 0.7rem;

    color: #607067;

    font-size: 0.44rem;

    letter-spacing: 0.13em;

    font-weight: 800;
  }

  .detail-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    padding: 0.42rem 0;

    border-bottom: 1px solid rgba(231, 239, 231, 0.04);
  }

  .detail-row:last-child {
    border-bottom: 0;
  }

  .detail-row small {
    color: #637068;
    font-size: 0.46rem;
  }

  .detail-row strong {
    color: #d6ddd7;
    font-size: 0.49rem;
    text-align: right;
  }

  .modal-amount small {
    display: block;

    color: #637068;

    font-size: 0.43rem;

    letter-spacing: 0.1em;
  }

  .modal-amount strong {
    display: block;

    margin-top: 0.3rem;

    color: var(--gold-bright);

    font-size: 1.7rem;
  }

  .issue-section {
    margin-top: 0.7rem;
  }

  .issue-section p {
    margin: 0;

    color: #a5b0a8;

    font-size: 0.64rem;

    line-height: 1.7;
  }

  .modal-action-grid {
    display: grid;

    grid-template-columns:
      0.7fr
      0.7fr
      1.3fr;

    gap: 0.55rem;

    margin-top: 0.8rem;
  }

  .modal-secondary,
  .modal-primary {
    min-height: 40px;

    border-radius: 0.7rem;

    cursor: pointer;

    font-size: 0.52rem;
    font-weight: 800;
  }

  .modal-secondary {
    border: 1px solid var(--line);

    background: rgba(255, 255, 255, 0.02);

    color: #9ea9a2;
  }

  .modal-primary {
    border: 1px solid rgba(217, 199, 139, 0.26);

    background: linear-gradient(
      135deg,
      rgba(217, 199, 139, 0.13),
      rgba(255, 255, 255, 0.025)
    );

    color: #edeadf;
  }

  .toast {
    position: fixed;

    left: 50%;
    bottom: 1.3rem;

    z-index: 700;

    transform: translate(-50%, 15px);

    min-width: min(280px, calc(100% - 2rem));

    padding: 0.76rem 1rem;

    border: 1px solid rgba(217, 199, 139, 0.18);

    border-radius: 0.75rem;

    background: rgba(11, 20, 16, 0.96);

    backdrop-filter: blur(18px);

    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.32);

    color: #cdd4cd;

    text-align: center;

    font-size: 0.55rem;

    opacity: 0;
    pointer-events: none;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .mobile-overlay {
    display: none;
  }

  body.modal-open {
    overflow: hidden;
  }

  @media (max-width: 1250px) {
    .sidebar {
      width: 245px;
    }

    .page-shell {
      width: calc(100% - 245px);
      margin-left: 245px;
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .work-order-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-grid,
    .customer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .analytics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .analytics-large {
      grid-column: span 2;
    }
  }

  @media (max-width: 980px) {
    .sidebar {
      transform: translateX(-100%);

      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-close {
      display: grid;
      place-items: center;
    }

    .page-shell {
      width: 100%;
      margin-left: 0;
    }

    .mobile-menu {
      display: inline-flex;

      width: 36px;
      height: 36px;

      flex-direction: column;

      justify-content: center;
      align-items: center;

      gap: 4px;

      border: 1px solid var(--line);

      border-radius: 0.65rem;

      background: rgba(255, 255, 255, 0.025);

      cursor: pointer;
    }

    .mobile-menu span {
      width: 13px;
      height: 1px;

      background: #b6c0b9;
    }

    .topbar {
      grid-template-columns:
        auto
        minmax(0, 1fr)
        auto;

      padding: 0 1rem;
    }

    .breadcrumb {
      display: none;
    }

    .topbar-center {
      justify-content: flex-start;
    }

    .global-search {
      width: min(100%, 420px);
    }

    .mobile-overlay {
      display: block;

      position: fixed;
      inset: 0;

      z-index: 90;

      background: rgba(0, 0, 0, 0.48);

      opacity: 0;
      pointer-events: none;

      transition: opacity 0.2s ease;
    }

    .mobile-overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    body.menu-open {
      overflow: hidden;
    }

    .dispatch-page-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .topbar {
      height: 62px;

      grid-template-columns:
        auto
        minmax(0, 1fr)
        auto;
    }

    .global-search kbd {
      display: none;
    }

    .global-search input {
      font-size: 0.57rem;
    }

    .date-button {
      display: none;
    }

    .page-content {
      padding: 1.2rem 0.8rem 2rem;
    }

    .page-heading {
      flex-direction: column;

      align-items: stretch;

