        background: var(--bg);
        color: var(--text);
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --bg: #111815;
        --surface: #18211c;
        --surface-soft: #1e2a23;
        --surface-raised: #27372e;
        --text: #edf4ef;
        --muted: #a8b8ae;
        --line: #34463b;
        --accent: #63bba6;
        --accent-hover: #7bceb9;
        --warm: #ee8a6c;
        --focus: #f3a185;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, .18);
        --shadow-md: 0 14px 34px rgba(0, 0, 0, .2);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 90px; background: var(--bg); }
      body { margin: 0; min-width: 320px; background: var(--bg); color: var(--text); font-size: 15px; line-height: 1.6; transition: background-color .2s ease, color .2s ease; }
      body.dialog-open { overflow: hidden; }
      button, input, select { font: inherit; }
      button, select { cursor: pointer; }
      a { color: inherit; text-underline-offset: 3px; }
      button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
      ::selection { background: rgba(23, 120, 110, .18); color: var(--text); }
      [hidden] { display: none !important; }
      .skip-link { position: fixed; top: -60px; left: 16px; z-index: 200; padding: 10px 14px; border-radius: 8px; background: var(--text); color: var(--bg); text-decoration: none; }
      .skip-link:focus { top: 12px; }
      .app-shell { min-height: 100vh; }

      /* Navigation */
      .site-header { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: clamp(14px, 2vw, 28px); min-height: 76px; padding: 12px clamp(16px, 4.5vw, 64px); border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(14px); }
      .header-start { display: flex; align-items: center; flex: 0 1 auto; min-width: 0; gap: clamp(12px, 1.7vw, 24px); }
      .portfolio-back-link { display: inline-flex; align-items: center; gap: 7px; flex: 0 0 auto; padding: 9px 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--muted); font-size: 12px; font-weight: 650; text-decoration: none; white-space: nowrap; transition: color .18s ease, border-color .18s ease, background .18s ease; }
      .portfolio-back-link svg, .mobile-portfolio-link svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .portfolio-back-link:hover { color: var(--accent); border-color: var(--accent); background: var(--surface-soft); }
      .brand { display: inline-flex; align-items: center; gap: 9px; min-width: max-content; color: var(--text); font-size: 16px; font-weight: 850; letter-spacing: .065em; text-decoration: none; text-transform: uppercase; }
      .brand-mark { display: block; width: 30px; height: 30px; flex: 0 0 auto; }
      .brand-mark-shell { fill: var(--accent); }
      .brand-mark-film { fill: #fff; }
      .brand-mark-sprocket { fill: var(--warm); }
      .brand-mark-play { fill: var(--accent); }
      .desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 2.5vw, 36px); margin-inline: auto; }
      .desktop-nav a, .desktop-nav button { padding: 8px 0; border: 0; background: transparent; color: var(--muted); font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; transition: color .15s ease; }
      .desktop-nav a:hover, .desktop-nav button:hover { color: var(--accent); }
      .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex: 0 0 auto; }
      .button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 42px; padding: 10px 15px; border: 1px solid transparent; border-radius: 10px; font-size: 13px; font-weight: 700; line-height: 1.2; text-decoration: none; white-space: nowrap; transition: background-color .16s ease, color .16s ease, border-color .16s ease, transform .16s ease, box-shadow .16s ease; }
      .button:active { transform: translateY(1px); }
      .button-primary { background: var(--accent); color: #fff; border-color: var(--accent); box-shadow: 0 4px 12px rgba(23, 120, 110, .13); }
      .button-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
      .button-secondary { background: var(--surface); color: var(--text); border-color: var(--line); }
      .button-secondary:hover { background: var(--surface-soft); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
      .button-quiet { background: transparent; color: var(--muted); border-color: transparent; }
      .button-quiet:hover { color: var(--accent); background: var(--surface-soft); }
      .count { display: inline-grid; min-width: 20px; height: 20px; padding: 0 5px; place-items: center; border-radius: 999px; background: var(--warm); color: #fff; font-size: 11px; font-weight: 800; font-variant-numeric: tabular-nums; }
      .theme-toggle { min-height: 39px; padding: 8px 11px; }
      .theme-icon { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      html[data-theme="light"] .theme-icon-moon, html[data-theme="dark"] .theme-icon-sun { display: none; }
      .mobile-menu-button { display: none; width: 42px; height: 42px; align-items: center; justify-content: center; flex-direction: column; gap: 5px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
      .mobile-menu-button span { display: block; width: 17px; height: 2px; border-radius: 2px; background: var(--text); }
      .mobile-nav { position: relative; z-index: 45; display: grid; gap: 0; padding: 6px 20px 12px; border-bottom: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow-sm); }
      .mobile-nav a, .mobile-nav button { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 46px; padding: 10px 2px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--text); font-size: 14px; text-align: left; text-decoration: none; }
      .mobile-nav .mobile-portfolio-link { color: var(--accent); font-weight: 750; }
      .mobile-nav .mobile-portfolio-link svg { width: 16px; height: 16px; }

      /* Hero and search */
      .hero { display: block; padding: clamp(68px, 10vw, 124px) 20px clamp(60px, 8vw, 98px); border-bottom: 1px solid var(--line); background: radial-gradient(ellipse at top center, color-mix(in srgb, var(--accent) 7%, var(--bg)), var(--bg) 64%); }
      .hero-copy { width: min(100%, 790px); margin: 0 auto; text-align: center; }
      .eyebrow { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 0 0 17px; color: var(--warm); font-size: 10px; font-weight: 800; letter-spacing: .14em; line-height: 1.5; text-transform: uppercase; }
      .eyebrow-rule { display: inline-block; width: 20px; height: 2px; border-radius: 2px; background: var(--warm); }
      .hero h1 { max-width: 820px; margin: 0 auto; color: var(--text); font-size: clamp(42px, 7.2vw, 76px); font-weight: 790; letter-spacing: -.065em; line-height: 1.02; }
      .hero h1 span { color: var(--accent); }
      .hero-description { margin: 21px auto 0; color: var(--muted); font-size: clamp(15px, 1.5vw, 17px); line-height: 1.7; }
      .search-form { width: min(100%, 720px); margin: 34px auto 0; text-align: left; }
      .search-form label, .genre-area label, .country-control label { display: block; margin-bottom: 8px; color: var(--text); font-size: 12px; font-weight: 750; }
      .search-controls { display: flex; align-items: stretch; gap: 9px; }
      .search-controls input { width: 100%; min-width: 0; min-height: 52px; padding: 0 16px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface); color: var(--text); box-shadow: var(--shadow-sm); outline-offset: 2px; transition: border-color .16s ease, box-shadow .16s ease; }
      .search-controls input::placeholder { color: color-mix(in srgb, var(--muted) 78%, transparent); }
      .search-controls input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent); outline: none; }
      .search-controls button { min-width: 112px; min-height: 52px; }
      .search-controls button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .search-hint { margin: 8px 0 0; color: var(--muted); font-size: 11px; }
      .status-line { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 16px 0 0; color: var(--muted); font-size: 11px; }
      .status-dot { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: #c78b44; }
      .status-dot.is-online { background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 13%, transparent); }

      /* Discovery */
      .discovery-section { width: min(100%, var(--content-width)); margin: 0 auto; padding: clamp(54px, 7vw, 88px) clamp(16px, 4vw, 40px) 74px; }
      .section-heading { display: grid; justify-items: center; gap: 3px; margin: 0 0 24px; text-align: center; }
      .section-heading .eyebrow { margin-bottom: 4px; }
      .section-heading h2 { margin: 0; color: var(--text); font-size: clamp(30px, 4vw, 42px); font-weight: 760; letter-spacing: -.045em; line-height: 1.15; }
      .discovery-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px 20px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .filter-tabs { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(14px, 2.4vw, 28px); }
      .filter-tab { position: relative; min-height: 38px; padding: 4px 0 9px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font-size: 13px; font-weight: 650; transition: color .15s ease, border-color .15s ease; }
      .filter-tab:hover { color: var(--text); }
      .filter-tab.is-active { border-bottom-color: var(--accent); color: var(--accent); font-weight: 800; }
      .rail-controls { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .results-label { margin: 0; color: var(--muted); font-size: 11px; text-transform: capitalize; }
      .rail-buttons { display: inline-flex; gap: 6px; }
      .rail-scroll-button { display: grid; width: 33px; height: 33px; place-items: center; padding: 0; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--text); }
      .rail-scroll-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .rail-scroll-button:disabled { opacity: .4; cursor: default; }
      .genre-area { display: flex; align-items: center; gap: 11px; padding: 19px 0 20px; }
      .genre-area label { margin: 0; }
      .genre-area select, .country-control select { max-width: 100%; min-height: 40px; padding: 8px 34px 8px 11px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--text); }
      .notice { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: 8px 0 20px; padding: 15px 17px; border: 1px solid #ecd7bd; border-radius: 12px; background: #fff8f0; color: #593f27; }
      html[data-theme="dark"] .notice { border-color: #6a4c34; background: #2c241c; color: #f1d6bd; }
      .notice[hidden] { display: none !important; }
      .notice strong { display: block; margin-bottom: 3px; font-size: 13px; }
      .notice p { margin: 0; color: inherit; opacity: .84; font-size: 12px; line-height: 1.55; }
      .notice .button { flex: 0 0 auto; }
      .search-summary { margin: 0 0 12px; color: var(--muted); font-size: 12px; }
      .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); align-items: start; gap: 26px 17px; min-height: 150px; margin: 0; padding: 7px 0 18px; }
      .movie-card { position: relative; min-width: 0; border-radius: 13px; transform: translateZ(0); transform-style: preserve-3d; transition: transform .2s ease; }
      .poster-frame { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 11px; background: var(--surface-soft); box-shadow: var(--shadow-sm); transition: box-shadow .2s ease, border-color .2s ease; }
      .poster-button { position: relative; display: block; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; padding: 0; border: 0; background: var(--surface-soft); text-align: left; }
      .poster-button img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
      .poster-missing { display: grid; width: 100%; height: 100%; min-height: 180px; place-items: center; padding: 14px; color: var(--muted); font-size: 12px; text-align: center; }
      .save-button { position: absolute; z-index: 2; top: 9px; right: 9px; min-height: 32px; padding: 0 10px; border: 1px solid rgba(255,255,255,.55); border-radius: 8px; background: rgba(18, 31, 25, .9); color: #fff; font-size: 11px; font-weight: 750; backdrop-filter: blur(8px); transition: background .16s ease, border-color .16s ease; }
      .save-button:hover { background: var(--accent); }
      .save-button[aria-pressed="true"] { border-color: var(--warm); background: var(--warm); color: #fff; }
      .movie-card-copy { padding: 10px 2px 0; }
      .movie-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin: 0 0 6px; color: var(--muted); font-size: 10px; line-height: 1.45; }
      .movie-title-button { display: block; width: 100%; padding: 0; border: 0; background: transparent; color: var(--text); font-size: 14px; font-weight: 750; line-height: 1.4; text-align: left; overflow-wrap: anywhere; }
      .movie-title-button:hover { color: var(--accent); }
      .movie-genre { margin: 5px 0 0; color: var(--muted); font-size: 11px; line-height: 1.5; }
      .loading-state, .empty-state { grid-column: 1 / -1; min-width: 0; min-height: 145px; padding: 32px 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--muted); font-size: 13px; }
      .empty-state h3 { margin: 0 0 7px; color: var(--text); font-size: 18px; }
      .empty-state p { max-width: 610px; margin: 0 0 16px; color: var(--muted); font-size: 13px; }
      .load-more-wrap { display: flex; justify-content: center; margin-top: 30px; }
      .load-more-wrap [hidden] { display: none !important; }

      /* Footer and dialogs */
      .site-footer { display: flex; align-items: flex-start; justify-content: space-between; gap: 36px; padding: 30px clamp(16px, 4.5vw, 64px) 36px; border-top: 1px solid var(--line); background: var(--surface); }
      .footer-brand-block { max-width: 600px; }
      .footer-brand-block > p { margin: 12px 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
      .attribution { display: flex; align-items: center; gap: 11px; margin-top: 15px; }
      .attribution img { display: block; width: 26px; height: 26px; flex: 0 0 auto; object-fit: contain; }
      .attribution p { max-width: 460px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.65; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 10px 17px; max-width: 450px; }
      .footer-links a, .footer-links button { padding: 0; border: 0; background: transparent; color: var(--muted); font-size: 12px; text-decoration: none; }
      .footer-links a:hover, .footer-links button:hover { color: var(--accent); }
      .detail-dialog, .watchlist-dialog, .consent-dialog { width: min(900px, calc(100vw - 24px)); max-width: none; max-height: min(90dvh, 900px); overflow: auto; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--text); box-shadow: var(--shadow-md); }
      .detail-dialog::backdrop, .watchlist-dialog::backdrop, .consent-dialog::backdrop { background: rgba(9, 22, 16, .48); backdrop-filter: blur(3px); }
      .detail-dialog > form, .watchlist-dialog > form, .consent-dialog > form { position: sticky; top: 0; z-index: 5; display: flex; justify-content: flex-end; height: 0; margin: 0; }
      .dialog-close { min-height: 35px; margin: 10px; padding: 0 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text); font-size: 12px; font-weight: 700; }
      .detail-layout { display: grid; grid-template-columns: minmax(180px, .62fr) 1fr; border-bottom: 1px solid var(--line); }
      .detail-poster { display: grid; min-height: 300px; place-items: center; overflow: hidden; background: var(--surface-soft); color: var(--muted); }
      .detail-poster img { display: block; width: 100%; height: 100%; max-height: 470px; object-fit: cover; }
      .detail-poster p { padding: 20px; }
      .detail-content { padding: 44px clamp(20px, 4vw, 38px) 30px; }
      .detail-content .eyebrow, .provider-heading .eyebrow, .reviews-section .eyebrow { justify-content: flex-start; margin-bottom: 8px; }
      .detail-content h2 { margin: 0 0 10px; color: var(--text); font-size: clamp(27px, 4vw, 39px); letter-spacing: -.045em; line-height: 1.1; }
      .detail-rating { margin: 0 0 8px; color: #b17a2b; font-size: 12px; font-weight: 700; }
      .detail-meta, .detail-genres { color: var(--muted); font-size: 12px; }
      .detail-meta { margin: 0 0 16px; }
      .detail-overview { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.75; white-space: pre-wrap; }
      .detail-genres { margin-top: 14px; }
      .detail-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
      .provider-section, .reviews-section { padding: 25px clamp(18px, 3vw, 30px) 28px; border-bottom: 1px solid var(--line); }
      .provider-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
      .provider-heading h3, .reviews-section h3 { margin: 0; color: var(--text); font-size: 22px; letter-spacing: -.025em; }
      .country-control label { margin-bottom: 6px; font-size: 11px; }
      .country-control select { min-width: 170px; }
      .subtle-copy { margin: 11px 0 16px; color: var(--muted); font-size: 12px; line-height: 1.65; }
      .provider-group { padding: 15px 0; border-top: 1px solid var(--line); }
      .provider-group h4 { margin: 0 0 10px; color: var(--text); font-size: 13px; }
      .provider-group ul { display: flex; flex-wrap: wrap; gap: 12px 18px; margin: 0; padding: 0; list-style: none; }
      .provider-group li { display: flex; align-items: center; gap: 8px; max-width: 220px; color: var(--muted); font-size: 12px; }
      .provider-group img { width: 30px; height: 30px; border-radius: 7px; object-fit: cover; background: var(--surface-soft); }
      .provider-link-wrap { margin: 15px 0 0; }
      .provider-credit, .empty-inline { color: var(--muted); font-size: 11px; line-height: 1.65; }
      .review-list { display: grid; gap: 10px; }
      .review-card { padding: 15px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface-soft); }
      .review-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; color: var(--text); font-size: 12px; }
      .review-rating { color: #b17a2b; }
      .review-card p { margin: 10px 0; color: var(--muted); font-size: 12px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
      .review-card a, .watch-item-copy button { color: var(--accent); font-size: 12px; }
      .watchlist-dialog, .consent-dialog { width: min(590px, calc(100vw - 24px)); padding: 26px; }
      .watchlist-dialog h2, .consent-dialog h2 { margin: 0; color: var(--text); font-size: clamp(26px, 4vw, 32px); letter-spacing: -.04em; }
      .watchlist-items { display: grid; gap: 11px; margin: 18px 0; }
      .watch-item { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
      .watch-item > img, .watch-poster-missing { display: grid; width: 56px; height: 78px; place-items: center; border-radius: 6px; background: var(--surface-soft); color: var(--muted); font-size: 9px; object-fit: cover; }
      .watch-item-copy { min-width: 0; }
      .watch-item-copy strong { display: block; color: var(--text); font-size: 13px; overflow-wrap: anywhere; }
      .watch-item-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; }
      .watch-item-copy button { margin-top: 6px; padding: 0; border: 0; background: transparent; text-decoration: underline; text-underline-offset: 3px; }
      .watch-item-remove { min-height: 33px; padding: 0 9px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text); font-size: 11px; }
      .watchlist-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 9px; padding-top: 15px; border-top: 1px solid var(--line); }
      .watchlist-actions form { margin: 0; }
      .preference-row { display: flex; justify-content: space-between; gap: 18px; padding: 17px 0; border-top: 1px solid var(--line); }
      .preference-row strong { color: var(--text); font-size: 13px; }
      .preference-row p { max-width: 390px; margin: 4px 0 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
      .preference-state { flex: 0 0 auto; color: var(--accent); font-size: 11px; font-weight: 750; }
      .consent-banner { position: fixed; right: 16px; bottom: 16px; left: 16px; z-index: 90; display: flex; align-items: center; justify-content: space-between; gap: 22px; max-width: 1040px; margin: 0 auto; padding: 16px 18px; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--surface) 96%, transparent); box-shadow: var(--shadow-md); backdrop-filter: blur(14px); }
      .consent-banner[hidden] { display: none !important; }
      .consent-banner h2 { margin: 0 0 4px; color: var(--text); font-size: 13px; }
      .consent-banner p { max-width: 610px; margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
      .consent-actions { display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
      .consent-banner .consent-actions { margin: 0; }
      .toast { position: fixed; right: 18px; bottom: 18px; z-index: 120; max-width: min(420px, calc(100vw - 36px)); padding: 12px 15px; border: 1px solid var(--line); border-radius: 10px; background: var(--text); color: var(--bg); font-size: 12px; opacity: 0; pointer-events: none; transform: translateY(5px); transition: opacity .16s ease, transform .16s ease; }
      .toast.is-visible { opacity: 1; transform: translateY(0); }
      .back-to-top { position: fixed; right: 22px; bottom: 22px; z-index: 70; display: inline-flex; align-items: center; gap: 9px; min-height: 45px; padding: 7px 13px 7px 7px; overflow: hidden; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--text); box-shadow: var(--shadow-md); opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity .18s ease, transform .18s ease, border-color .18s ease; }
      .back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
      .back-to-top::before { position: absolute; top: 0; bottom: 0; left: -70%; width: 55%; content: ''; background: linear-gradient(105deg, transparent, color-mix(in srgb, var(--accent) 15%, transparent), transparent); transform: skewX(-18deg); transition: left .45s ease; }
      .back-to-top:hover::before { left: 130%; }
      .back-to-top:hover { border-color: var(--accent); }
      .back-to-top-icon { position: relative; display: grid; width: 29px; height: 29px; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; }
      .back-to-top-icon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .back-to-top-label { position: relative; font-size: 11px; font-weight: 750; }
      .back-to-top-drip { position: absolute; right: 25px; bottom: -5px; width: 8px; height: 8px; border-radius: 50% 50% 50% 0; background: var(--warm); opacity: 0; transform: translateY(-5px) rotate(-45deg) scale(.4); }
      .back-to-top:hover .back-to-top-drip { animation: mf-drip .45s cubic-bezier(.2,.8,.2,1) forwards; }
      @keyframes mf-drip { 0% { opacity: 0; transform: translateY(-5px) rotate(-45deg) scale(.4); } 45% { opacity: 1; transform: translateY(0) rotate(-45deg) scale(1); } 100% { opacity: .2; transform: translateY(7px) rotate(-45deg) scale(.65); } }

      /* Dark theme is token-driven so all pages and controls stay consistent. */
      html[data-theme="dark"] .brand-mark-film { fill: #f7faf7; }
