---
const pageTitle = 'MovieFlex | Search films and check streaming availability';
const pageDescription = 'Search the TMDB film catalogue, choose your country, and check available streaming, rental, and purchase providers.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f8f5" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/movieflex-icon.svg" />
    <script is:inline>
      (() => { try { const saved = localStorage.getItem("movieflex-theme"); if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved; } catch {} })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
      <header class="site-header">
        <div class="header-start">
          <a class="portfolio-back-link" href="/" aria-label="Back to portfolio home">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" /></svg>
            <span>Back to Portfolio</span>
          </a>
          <a class="brand" href="#top" aria-label="MovieFlex home">
            <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <rect class="brand-mark-shell" x="1" y="1" width="38" height="38" rx="11" />
              <rect class="brand-mark-film" x="8" y="7" width="24" height="26" rx="4" />
              <rect class="brand-mark-sprocket" x="10.5" y="9.3" width="4" height="2.6" rx=".7" />
              <rect class="brand-mark-sprocket" x="18" y="9.3" width="4" height="2.6" rx=".7" />
              <rect class="brand-mark-sprocket" x="25.5" y="9.3" width="4" height="2.6" rx=".7" />
              <rect class="brand-mark-sprocket" x="10.5" y="28.1" width="4" height="2.6" rx=".7" />
              <rect class="brand-mark-sprocket" x="18" y="28.1" width="4" height="2.6" rx=".7" />
              <rect class="brand-mark-sprocket" x="25.5" y="28.1" width="4" height="2.6" rx=".7" />
              <path class="brand-mark-play" d="M16.1 15.2a1.1 1.1 0 0 0-1.6 1v7.6a1.1 1.1 0 0 0 1.6 1l7.4-3.8a1.1 1.1 0 0 0 0-2z" />
            </svg>
            <span>MovieFlex</span>
          </a>
        </div>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#discover">Discover</a>
          <a href="#discover">Where to watch</a>
        </nav>
        <div class="header-actions">
          <button class="button button-secondary theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Switch theme">
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.7 14.2A8.7 8.7 0 0 1 9.8 3.3 8.8 8.8 0 1 0 20.7 14.2Z"/></svg>
            <span data-theme-label>Dark mode</span>
          </button>
          <button class="button button-quiet search-trigger" type="button" data-focus-search>Search</button>
          <button class="button button-secondary watchlist-trigger" type="button" data-open-watchlist>Watchlist <span class="count" data-watch-count>0</span></button>
          <button class="mobile-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" data-mobile-menu>
            <span></span><span></span>
          </button>
        </div>
      </header>

      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
        <a class="mobile-portfolio-link" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" /></svg>
          Back to Portfolio
        </a>
        <a href="#discover">Discover films</a>
        <a href="#discover">Where to watch</a>
        <button type="button" data-open-watchlist>My watchlist <span class="count" data-watch-count>0</span></button>
        <button type="button" data-focus-search>Search movies</button>
      </nav>

      <main id="main-content">
        <section class="hero" id="top" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> Film discovery, made simple</p>
            <h1 id="hero-title">Find your next <span>great watch.</span></h1>
            <p class="hero-description">Search a title. Compare where to watch it.</p>
            <form class="search-form" data-search-form role="search">
              <label for="movie-search">Search movies</label>
              <div class="search-controls">
                <input id="movie-search" name="q" type="search" autocomplete="off" minlength="1" maxlength="120" placeholder="Enter a movie title, e.g. Dune" aria-describedby="search-hint" data-search-input required />
                <button class="button button-primary" type="submit">
                  <span>Search</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m15.5 15.5 4.2 4.2"/></svg>
                </button>
              </div>
              <p class="search-hint" id="search-hint">Press Enter to search.</p>
            </form>
            <p class="status-line" aria-live="polite"><span class="status-dot" data-status-dot></span><span data-data-status>Connecting to the movie catalogue...</span></p>
          </div>
        </section>

        <section class="discovery-section" id="discover" aria-labelledby="discover-title">
          <header class="section-heading">
            <p class="eyebrow">Discover something worth watching</p>
            <h2 id="discover-title">Explore movies</h2>
          </header>

          <div class="discovery-toolbar">
            <div class="filter-tabs" aria-label="Choose a movie list">
              <button class="filter-tab is-active" type="button" aria-pressed="true" data-mode="trending">Trending</button>
              <button class="filter-tab" type="button" aria-pressed="false" data-mode="popular">Popular</button>
              <button class="filter-tab" type="button" aria-pressed="false" data-mode="top_rated">Top rated</button>
              <button class="filter-tab" type="button" aria-pressed="false" data-mode="upcoming">Upcoming</button>
            </div>
            <div class="rail-controls">
              <p class="results-label" data-results-label>Trending films</p>
              <div class="rail-buttons" aria-label="Scroll movie results">
                <button class="rail-scroll-button" type="button" data-movie-scroll="-1" aria-label="Scroll films left" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
                </button>
                <button class="rail-scroll-button" type="button" data-movie-scroll="1" aria-label="Scroll films right" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="genre-area">
            <label for="genre-select">Genre</label>
            <select id="genre-select" data-genre-select>
              <option value="all">All genres</option>
            </select>
          </div>

          <div class="notice" data-api-notice role="status" hidden>
            <div><strong data-notice-title>Live movie data is unavailable.</strong><p data-notice-text>Check the API connection and try again.</p></div>
            <button class="button button-secondary" type="button" data-retry>Try again</button>
          </div>

          <p class="search-summary" data-search-summary aria-live="polite" hidden></p>
          <div class="movie-grid" data-movie-grid aria-live="polite" aria-busy="true">
            <div class="loading-state">Loading films from TMDB...</div>
          </div>
          <div class="load-more-wrap"><button class="button button-secondary" type="button" data-load-more hidden>Load more results</button></div>
        </section>


      </main>

      <footer class="site-footer">
        <div class="footer-brand-block">
          <a class="brand" href="#top" aria-label="MovieFlex home"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <rect class="brand-mark-shell" x="1" y="1" width="38" height="38" rx="11" />
            <rect class="brand-mark-film" x="8" y="7" width="24" height="26" rx="4" />
            <rect class="brand-mark-sprocket" x="10.5" y="9.3" width="4" height="2.6" rx=".7" />
            <rect class="brand-mark-sprocket" x="18" y="9.3" width="4" height="2.6" rx=".7" />
            <rect class="brand-mark-sprocket" x="25.5" y="9.3" width="4" height="2.6" rx=".7" />
            <rect class="brand-mark-sprocket" x="10.5" y="28.1" width="4" height="2.6" rx=".7" />
            <rect class="brand-mark-sprocket" x="18" y="28.1" width="4" height="2.6" rx=".7" />
            <rect class="brand-mark-sprocket" x="25.5" y="28.1" width="4" height="2.6" rx=".7" />
            <path class="brand-mark-play" d="M16.1 15.2a1.1 1.1 0 0 0-1.6 1v7.6a1.1 1.1 0 0 0 1.6 1l7.4-3.8a1.1 1.1 0 0 0 0-2z" />
          </svg><span>MovieFlex</span></a>
          <p>Movie data by TMDB. Streaming data by JustWatch.</p>
          <div class="attribution">
            <img src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_square_2-d537fb228cf3ded904ef09b136fe3fec72548ebc1fea3fbbd1ad9e36364db38b.svg" alt="The Movie Database logo" width="28" height="28" loading="lazy" />
            <p>This product uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB. Streaming availability data is powered by JustWatch.</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="Legal and privacy links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/cookies">Cookies</a>
          <a href="/privacy-settings">Privacy settings</a>
          <a href="/copyright">Copyright</a>
          <a href="/sources">Data sources</a>
          <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">TMDB</a>
          <a href="https://www.justwatch.com/" target="_blank" rel="noopener noreferrer">JustWatch</a>
        </nav>
      </footer>
    </div>

    <dialog class="detail-dialog" id="detail-dialog" aria-labelledby="detail-title">
      <form method="dialog"><button class="dialog-close" aria-label="Close movie details">Close</button></form>
      <div class="detail-layout">
        <div class="detail-poster" data-detail-poster><p>Poster unavailable</p></div>
        <div class="detail-content">
          <p class="eyebrow">Movie details from TMDB</p>
          <p class="detail-rating" data-detail-rating></p>
          <h2 id="detail-title" data-detail-title>Movie details</h2>
          <p class="detail-meta" data-detail-meta></p>
          <p class="detail-overview" data-detail-overview></p>
          <div class="detail-genres" data-detail-genres></div>
          <div class="detail-actions">
            <button class="button button-primary" type="button" data-detail-save>Add to watchlist</button>
            <a class="button button-secondary" href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" data-tmdb-link>Movie page on TMDB</a>
          </div>
        </div>
      </div>
      <section class="provider-section" aria-labelledby="providers-title">
        <div class="provider-heading">
          <div><p class="eyebrow">Streaming, rental and purchase</p><h3 id="providers-title">Where to watch</h3></div>
          <div class="country-control"><label for="provider-country">Country or region</label><select id="provider-country" data-provider-country><option value="IN">India</option></select></div>
        </div>
        <p class="subtle-copy">Choose your country to see reported options. Check the provider for current price and availability.</p>
        <div class="provider-results" data-provider-results aria-live="polite">Loading provider listings...</div>
        <p class="provider-credit">Streaming availability is powered by JustWatch. Links are supplied through TMDB.</p>
      </section>
      <section class="reviews-section" aria-labelledby="reviews-title">
        <p class="eyebrow">Community feedback</p>
        <h3 id="reviews-title">Reviews from TMDB</h3>
        <p class="subtle-copy">Reviews are provided by TMDB users.</p>
        <div class="review-list" data-review-list aria-live="polite">Loading reviews...</div>
      </section>
    </dialog>

    <dialog class="watchlist-dialog" id="watchlist-dialog" aria-labelledby="watchlist-dialog-title">
      <form method="dialog"><button class="dialog-close" aria-label="Close watchlist">Close</button></form>
      <p class="eyebrow">Stored in this browser</p>
      <h2 id="watchlist-dialog-title">My watchlist</h2>
      <p class="subtle-copy">Saved on this device.</p>
      <div class="watchlist-items" data-watchlist-items></div>
      <div class="watchlist-actions"><button class="button button-secondary" type="button" data-clear-watchlist>Clear saved titles</button><form method="dialog"><button class="button button-primary">Done</button></form></div>
    </dialog>

    <section class="consent-banner" data-consent-banner role="region" aria-labelledby="consent-title" hidden>
      <div><h2 id="consent-title">Privacy and browser storage</h2><p>MovieFlex uses browser storage for your watchlist and to remember this choice. This version does not load analytics or advertising trackers.</p></div>
      <div class="consent-actions"><button class="button button-primary" type="button" data-consent-essential>Use essential storage only</button><button class="button button-secondary" type="button" data-open-consent>Review settings</button></div>
    </section>

    <dialog class="consent-dialog" id="consent-dialog" aria-labelledby="consent-dialog-title">
      <form method="dialog"><button class="dialog-close" aria-label="Close privacy settings">Close</button></form>
      <p class="eyebrow">Privacy settings</p>
      <h2 id="consent-dialog-title">Control browser storage</h2>
      <div class="preference-row"><div><strong>Essential storage</strong><p>Required for the watchlist and saving your privacy choice. It cannot be switched off inside the app.</p></div><span class="preference-state">Always on</span></div>
      <div class="preference-row"><div><strong>Analytics and advertising</strong><p>Not installed. MovieFlex does not load analytics or advertising cookies.</p></div><span class="preference-state">Off</span></div>
      <p class="subtle-copy">Poster images are loaded from TMDB. Streaming availability is retrieved through TMDB using JustWatch data. External sites may apply their own privacy practices after you open a link.</p>
      <div class="consent-actions"><button class="button button-primary" type="button" data-consent-save>Save essential-only choice</button><a class="button button-secondary" href="/privacy">Read privacy policy</a></div>
    </dialog>

    <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top" title="Back to top">
      <span class="back-to-top-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 14 6-6 6 6"/><path d="M12 8v11"/></svg></span>
      <span class="back-to-top-label">Back to top</span>
      <span class="back-to-top-drip" aria-hidden="true"></span>
    </button>

    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script>
      // @ts-nocheck
      (() => {
        const apiUrl = '/api/movieflex';
        const $ = (selector, root = document) => root.querySelector(selector);
        const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
        const grid = $('[data-movie-grid]');
        const notice = $('[data-api-notice]');
        const noticeTitle = $('[data-notice-title]');
        const noticeText = $('[data-notice-text]');
        const statusText = $('[data-data-status]');
        const statusDot = $('[data-status-dot]');
        const resultsLabel = $('[data-results-label]');
        const railControls = $$('[data-movie-scroll]');
        const genreSelect = $('[data-genre-select]');
        const loadMoreButton = $('[data-load-more]');
        const searchForm = $('[data-search-form]');
        const searchInput = $('[data-search-input]');
        const searchSummary = $('[data-search-summary]');
        const detailDialog = $('#detail-dialog');
        const watchlistDialog = $('#watchlist-dialog');
        const consentDialog = $('#consent-dialog');
        const toast = $('[data-toast]');
        const mobileMenuButton = $('[data-mobile-menu]');
        const mobileNav = $('#mobile-nav');
        const themeToggleButtons = $$('[data-theme-toggle]');
        const backToTopButton = $('[data-back-to-top]');
        const countrySelect = $('[data-provider-country]');
        const providerResults = $('[data-provider-results]');
        const reviewList = $('[data-review-list]');
        const watchlistItems = $('[data-watchlist-items]');
        const detailPoster = $('[data-detail-poster]');
        const state = { mode: 'trending', page: 1, query: '', genre: 'all', totalPages: 1, movies: [], activeMovie: null, selectedRegion: 'IN', memoryWatchlist: [], toastTimer: null, lastTrigger: null };
        const genreNames = new Map();
        const posterBase = 'https://image.tmdb.org/t/p/w500';
        const backdropBase = 'https://image.tmdb.org/t/p/w1280';
        const defaultRegions = [{ iso_3166_1: 'IN', english_name: 'India' }, { iso_3166_1: 'US', english_name: 'United States' }, { iso_3166_1: 'GB', english_name: 'United Kingdom' }, { iso_3166_1: 'CA', english_name: 'Canada' }, { iso_3166_1: 'AU', english_name: 'Australia' }];

        function applyTheme(theme, persist = true) {
          const selectedTheme = theme === 'dark' ? 'dark' : 'light';
          document.documentElement.dataset.theme = selectedTheme;
          const themeColorMeta = $('meta[name="theme-color"]');
          if (themeColorMeta) themeColorMeta.setAttribute('content', selectedTheme === 'dark' ? '#111815' : '#f7f8f5');
          themeToggleButtons.forEach((button) => {
            const isDark = selectedTheme === 'dark';
            button.setAttribute('aria-pressed', String(isDark));
            button.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
            button.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
            const label = $('[data-theme-label]', button);
            if (label) label.textContent = isDark ? 'Light mode' : 'Dark mode';
          });
          if (persist) {
            try { localStorage.setItem('movieflex-theme', selectedTheme); } catch { /* Theme still applies for this visit. */ }
          }
        }

        themeToggleButtons.forEach((button) => button.addEventListener('click', () => {
          applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
        }));
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light', false);

        function updateBackToTop() {
          if (!backToTopButton) return;
          backToTopButton.classList.toggle('is-visible', window.scrollY > 520);
        }
        backToTopButton?.addEventListener('click', () => {
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
        });
        window.addEventListener('scroll', updateBackToTop, { passive: true });
        updateBackToTop();

        function escapeHtml(value) {
          const entities = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
          return String(value ?? '').replace(/[&<>"']/g, (character) => entities[character]);
        }

        function titleOf(movie) {
          return movie?.title || movie?.original_title || movie?.name || 'Untitled film';
        }

        function yearOf(movie) {
          const date = movie?.release_date || movie?.first_air_date || '';
          return /^\d{4}/.test(date) ? date.slice(0, 4) : 'Release date unavailable';
        }

        function imageUrl(path, size = 'w500') {
          return path ? `https://image.tmdb.org/t/p/${size}${path}` : '';
        }

        function safeExternalUrl(value) {
          try {
            const url = new URL(value);
            return url.protocol === 'https:' ? url.href : 'https://www.themoviedb.org/';
          } catch {
            return 'https://www.themoviedb.org/';
          }
        }

        function ratingText(value) {
          return typeof value === 'number' && Number.isFinite(value) && value > 0 ? `${value.toFixed(1)} / 10 on TMDB` : 'No TMDB rating';
        }

        function readWatchlist() {
          try {
            const saved = JSON.parse(localStorage.getItem('movieflex-watchlist-v2') || '[]');
            if (Array.isArray(saved)) {
              state.memoryWatchlist = saved.filter((movie) => movie && Number.isInteger(movie.id) && typeof movie.title === 'string');
            }
          } catch {
            // Keep the in-memory list usable when browser storage is unavailable.
          }
          return state.memoryWatchlist;
        }

        function writeWatchlist(movies) {
          state.memoryWatchlist = movies;
          try {
            localStorage.setItem('movieflex-watchlist-v2', JSON.stringify(movies));
          } catch {
            showToast('Browser storage is blocked. Saved titles will last only for this visit.');
          }
          updateWatchCounts();
        }

        function updateWatchCounts() {
          const count = readWatchlist().length;
          $$('[data-watch-count]').forEach((node) => { node.textContent = String(count); });
        }

        function isSaved(id) {
          return readWatchlist().some((movie) => movie.id === id);
        }

        function showToast(message) {
          if (!toast) return;
          toast.textContent = message;
          toast.classList.add('is-visible');
          if (state.toastTimer) window.clearTimeout(state.toastTimer);
          state.toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2800);
        }

        function setStatus(message, online = false) {
          if (statusText) statusText.textContent = message;
          if (statusDot) statusDot.classList.toggle('is-online', online);
        }

        function showNotice(title, message) {
          if (!notice) return;
          notice.hidden = false;
          if (noticeTitle) noticeTitle.textContent = title;
          if (noticeText) noticeText.textContent = message;
        }

        function hideNotice() {
          if (notice) notice.hidden = true;
        }

        function updateRailControls() {
          if (!grid) return;
          const canScroll = grid.scrollWidth > grid.clientWidth + 4;
          railControls.forEach((button) => {
            const direction = Number(button.getAttribute('data-movie-scroll'));
            button.hidden = !canScroll;
            button.disabled = direction < 0
              ? grid.scrollLeft <= 2
              : grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 2;
          });
        }

        function emptyState(title, description, allowClear = false) {
          if (!grid) return;
          grid.innerHTML = `<div class="empty-state"><h3>${escapeHtml(title)}</h3><p>${escapeHtml(description)}</p>${allowClear ? '<button class="button button-secondary" type="button" data-clear-search>Clear search and filters</button>' : ''}</div>`;
          if (loadMoreButton) loadMoreButton.hidden = true;
          window.requestAnimationFrame(updateRailControls);
        }

        function setLoading(isLoading) {
          if (grid) grid.setAttribute('aria-busy', String(isLoading));
          if (isLoading && grid && !$('.movie-card', grid)) {
            grid.innerHTML = '<div class="loading-state">Loading results from TMDB...</div>';
          }
        }

        function renderMovies(movies, append = false) {
          if (!grid) return;
          if (!movies.length && !append) {
            emptyState(state.query ? 'No matching films were returned.' : 'No films were returned.', 'Try another title or change the selected list or genre.', true);
            return;
          }
          const markup = movies.map((movie) => {
            const title = escapeHtml(titleOf(movie));
            const image = imageUrl(movie.poster_path);
            const genreNamesForMovie = (movie.genre_ids || []).slice(0, 2).map((id) => genreNames.get(id)).filter(Boolean).join(', ');
            const saved = isSaved(movie.id);
            const poster = image
              ? `<img src="${escapeHtml(image)}" alt="Poster for ${escapeHtml(titleOf(movie))}" loading="lazy" decoding="async" />`
              : '<div class="poster-missing" role="img" aria-label="Poster unavailable">Poster unavailable</div>';
            return `<article class="movie-card" data-movie-id="${Number(movie.id)}">
              <div class="poster-frame"><button class="poster-button" type="button" data-open-movie="${Number(movie.id)}" aria-label="View details for ${title}">${poster}</button>
                <button class="save-button" type="button" data-save-movie="${Number(movie.id)}" aria-label="${saved ? 'Remove from' : 'Add to'} watchlist: ${title}" aria-pressed="${saved}">${saved ? 'Saved' : 'Save'}</button>
              </div>
              <div class="movie-card-copy"><p class="movie-card-meta"><span>${escapeHtml(yearOf(movie))}</span><span>${escapeHtml(ratingText(movie.vote_average))}</span></p>
                <button class="movie-title-button" type="button" data-open-movie="${Number(movie.id)}">${title}</button>
                <p class="movie-genre">${escapeHtml(genreNamesForMovie || 'Genre details in movie view')}</p>
              </div>
            </article>`;
          }).join('');
          if (append) grid.insertAdjacentHTML('beforeend', markup); else grid.innerHTML = markup;
          grid.setAttribute('aria-busy', 'false');
          if (loadMoreButton) loadMoreButton.hidden = !state.totalPages || state.page >= state.totalPages || !movies.length;
          window.requestAnimationFrame(updateRailControls);
        }

        async function apiRequest(params) {
          const url = `${apiUrl}?${new URLSearchParams(params).toString()}`;
          const response = await fetch(url, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15000) });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || `Movie data request failed (${response.status}).`);
          if (data.error) throw new Error(data.error);
          return data;
        }

        async function requestMovies({ append = false } = {}) {
          const params = { mode: state.query ? 'search' : state.genre !== 'all' ? 'genre' : state.mode, page: String(state.page) };
          if (state.query) params.q = state.query;
          if (state.genre !== 'all' && !state.query) params.id = state.genre;
          setLoading(true);
          hideNotice();
          if (resultsLabel) resultsLabel.textContent = state.query ? `Search results for "${state.query}"` : state.genre !== 'all' ? `Genre: ${genreNames.get(Number(state.genre)) || 'Selected genre'}` : state.mode.replace('_', ' ');
          setStatus('Requesting live movie data...', false);
          try {
            const payload = await apiRequest(params);
            const movies = Array.isArray(payload.results) ? payload.results : [];
            state.totalPages = Math.max(1, Number(payload.total_pages) || 1);
            state.movies = append ? [...state.movies, ...movies] : movies;
            if (resultsLabel) resultsLabel.textContent = state.query ? `${Number(payload.total_results) || movies.length} search results` : `${Number(payload.total_results) || movies.length} catalogue results`;
            if (searchSummary) {
              searchSummary.hidden = !state.query;
              searchSummary.textContent = state.query ? `${Number(payload.total_results) || movies.length} matches returned by TMDB for "${state.query}".` : '';
            }
            renderMovies(movies, append);
            hideNotice();
            setStatus('Live data from TMDB', true);
          } catch (error) {
            state.movies = [];
            state.totalPages = 1;
            setLoading(false);
            emptyState('Live movie data could not be loaded.', 'MovieFlex does not replace failed requests with sample titles. Check the local API endpoint, token, and internet connection, then retry.');
            const errorMessage = error instanceof Error ? error.message : 'The movie request failed. Check the local API endpoint and try again.';
            const authFailure = /invalid api key|authentication failed|unauthori[sz]ed|suspended api key|status\s*401|\b401\b/i.test(errorMessage);
            showNotice(authFailure ? 'TMDB authentication needs attention.' : 'Movie data could not be loaded.', authFailure ? 'Check the TMDB credential configured for the server API route. Regenerate it only if it is revoked, invalid, or exposed; then update your environment file and restart the dev server.' : errorMessage);
            setStatus('Live data unavailable', false);
            if (searchSummary) searchSummary.hidden = true;
          } finally {
            if (grid) grid.setAttribute('aria-busy', 'false');
          }
        }

        async function requestGenres() {
          if (!genreSelect) return;
          try {
            const payload = await apiRequest({ mode: 'genres' });
            const genres = Array.isArray(payload.genres) ? payload.genres : [];
            genreNames.clear();
            genres.forEach((genre) => genreNames.set(Number(genre.id), genre.name));
            genreSelect.innerHTML = '<option value="all">All genres</option>' + genres.map((genre) => `<option value="${Number(genre.id)}">${escapeHtml(genre.name)}</option>`).join('');
          } catch {
            genreSelect.innerHTML = '<option value="all">All genres</option>';
            showNotice('Genres could not be loaded.', 'The live genre list is unavailable. You can still search by title or browse the main lists.');
          }
        }

        async function requestRegions() {
          if (!countrySelect) return;
          try {
            const payload = await apiRequest({ mode: 'regions' });
            const regions = Array.isArray(payload.results) ? payload.results : [];
            if (!regions.length) throw new Error('No provider regions were returned.');
            const current = countrySelect.value || 'IN';
            countrySelect.innerHTML = regions
              .filter((region) => /^[A-Z]{2}$/.test(region.iso_3166_1 || ''))
              .sort((a, b) => a.english_name.localeCompare(b.english_name))
              .map((region) => `<option value="${region.iso_3166_1}">${escapeHtml(region.english_name)}</option>`)
              .join('');
            countrySelect.value = regions.some((region) => region.iso_3166_1 === current) ? current : 'IN';
            state.selectedRegion = countrySelect.value || 'IN';
          } catch {
            countrySelect.innerHTML = defaultRegions.map((region) => `<option value="${region.iso_3166_1}">${region.english_name}</option>`).join('');
            countrySelect.value = 'IN';
            state.selectedRegion = 'IN';
          }
        }

        function showDialog(dialog, trigger) {
          if (!dialog) return;
          state.lastTrigger = trigger || document.activeElement;
          if (!dialog.open) dialog.showModal();
          document.body.classList.add('dialog-open');
        }

        function closeDialog(dialog) {
          if (dialog?.open) dialog.close();
          if (![detailDialog, watchlistDialog, consentDialog].some((item) => item?.open)) document.body.classList.remove('dialog-open');
          if (state.lastTrigger && typeof state.lastTrigger.focus === 'function') state.lastTrigger.focus();
        }

        function renderProviders(data) {
          if (!providerResults) return;
          if (!data || !data.availability) {
            providerResults.innerHTML = '<p class="empty-inline">No streaming, rental, or purchase listings were returned for this title in the selected country. This does not mean the title is unavailable everywhere.</p>';
            return;
          }
          const listing = data.availability;
          const groups = [
            ['flatrate', 'Stream'],
            ['free', 'Free'],
            ['ads', 'With ads'],
            ['rent', 'Rent'],
            ['buy', 'Buy']
          ];
          const available = groups.map(([key, label]) => {
            const providers = Array.isArray(listing[key]) ? listing[key] : [];
            if (!providers.length) return '';
            const items = providers.map((provider) => {
              const logo = imageUrl(provider.logo_path, 'w92');
              const img = logo ? `<img src="${escapeHtml(logo)}" alt="${escapeHtml(provider.provider_name)} logo" loading="lazy" decoding="async" />` : '';
              return `<li>${img}<span>${escapeHtml(provider.provider_name)}</span></li>`;
            }).join('');
            return `<section class="provider-group"><h4>${label}</h4><ul>${items}</ul></section>`;
          }).join('');
          const link = safeExternalUrl(listing.link || 'https://www.themoviedb.org/');
          providerResults.innerHTML = available
            ? `${available}<p class="provider-link-wrap"><a class="button button-secondary" href="${link}" target="_blank" rel="noopener noreferrer">Check provider listings</a></p>`
            : '<p class="empty-inline">No provider options were returned for this title and country.</p>';
        }

        function renderReviews(payload) {
          if (!reviewList) return;
          const reviews = Array.isArray(payload.results) ? payload.results : [];
          if (!reviews.length) {
            reviewList.innerHTML = '<p class="empty-inline">TMDB has no community reviews listed for this title yet.</p>';
            return;
          }
          reviewList.innerHTML = reviews.slice(0, 3).map((review) => {
            const author = escapeHtml(review.author || 'TMDB contributor');
            const rating = review.author_details?.rating;
            const ratingLabel = typeof rating === 'number' ? `<span class="review-rating">User rating: ${rating}/10</span>` : '';
            const text = escapeHtml(String(review.content || '').replace(/\r/g, '').slice(0, 900));
            const url = safeExternalUrl(review.url || 'https://www.themoviedb.org/');
            return `<article class="review-card"><div class="review-meta"><strong>${author}</strong>${ratingLabel}</div><p>${text || 'This TMDB review has no text.'}</p><a href="${url}" target="_blank" rel="noopener noreferrer">Read review on TMDB</a></article>`;
          }).join('');
        }

        async function openMovie(id, trigger) {
          const movie = state.movies.find((item) => Number(item.id) === Number(id)) || readWatchlist().find((item) => Number(item.id) === Number(id));
          if (!movie) {
            showToast('Select a title from the current results or watchlist.');
            return;
          }
          state.activeMovie = movie;
          showDialog(detailDialog, trigger);
          const title = titleOf(movie);
          $('[data-detail-title]').textContent = title;
          $('[data-detail-rating]').textContent = ratingText(movie.vote_average);
          $('[data-detail-meta]').textContent = `${yearOf(movie)}${movie.original_language ? ` | Original language: ${movie.original_language.toUpperCase()}` : ''}`;
          $('[data-detail-overview]').textContent = movie.overview || 'No overview has been provided by TMDB for this title.';
          $('[data-detail-genres]').textContent = Array.isArray(movie.genres) ? movie.genres.map((genre) => genre.name).join(', ') : (movie.genre_ids || []).map((id) => genreNames.get(id)).filter(Boolean).join(', ');
          $('[data-detail-save]').textContent = isSaved(movie.id) ? 'Remove from watchlist' : 'Add to watchlist';
          const backdrop = imageUrl(movie.backdrop_path, 'w1280') || imageUrl(movie.poster_path, 'w500');
          detailPoster.innerHTML = backdrop ? `<img src="${escapeHtml(backdrop)}" alt="Artwork for ${escapeHtml(title)}" decoding="async" />` : '<p>Artwork unavailable</p>';
          $('[data-tmdb-link]').href = `https://www.themoviedb.org/movie/${Number(movie.id)}`;
          if (providerResults) providerResults.textContent = 'Loading country availability...';
          if (reviewList) reviewList.textContent = 'Loading TMDB reviews...';
          const type = movie.media_type === 'tv' ? 'tv' : 'movie';
          const region = countrySelect?.value || state.selectedRegion || 'IN';
          const results = await Promise.allSettled([
            apiRequest({ mode: 'details', id: String(movie.id), type }),
            apiRequest({ mode: 'providers', id: String(movie.id), type, region }),
            type === 'movie' ? apiRequest({ mode: 'reviews', id: String(movie.id), page: '1' }) : Promise.resolve({ results: [] })
          ]);
          if (results[0].status === 'fulfilled') {
            const details = results[0].value;
            state.activeMovie = { ...movie, ...details };
            $('[data-detail-title]').textContent = titleOf(details);
            $('[data-detail-rating]').textContent = ratingText(details.vote_average);
            $('[data-detail-meta]').textContent = `${yearOf(details)}${details.runtime ? ` | ${details.runtime} minutes` : ''}${details.original_language ? ` | Original language: ${details.original_language.toUpperCase()}` : ''}`;
            $('[data-detail-overview]').textContent = details.overview || 'No overview has been provided by TMDB for this title.';
            $('[data-detail-genres]').textContent = Array.isArray(details.genres) ? details.genres.map((genre) => genre.name).join(', ') : '';
          }
          if (results[1].status === 'fulfilled') renderProviders(results[1].value);
          else if (providerResults) providerResults.innerHTML = `<p class="empty-inline">${escapeHtml(results[1].reason?.message || 'Provider availability could not be loaded. Try again.')}</p>`;
          if (results[2].status === 'fulfilled') renderReviews(results[2].value);
          else if (reviewList) reviewList.innerHTML = `<p class="empty-inline">${escapeHtml(results[2].reason?.message || 'Reviews could not be loaded.')}</p>`;
        }

        function toggleSaved(id) {
          const movie = state.movies.find((item) => Number(item.id) === Number(id)) || readWatchlist().find((item) => Number(item.id) === Number(id)) || state.activeMovie;
          if (!movie) return;
          const watchlist = readWatchlist();
          const exists = watchlist.some((item) => Number(item.id) === Number(id));
          const next = exists ? watchlist.filter((item) => Number(item.id) !== Number(id)) : [...watchlist, {
            id: Number(movie.id), title: titleOf(movie), poster_path: movie.poster_path || null,
            backdrop_path: movie.backdrop_path || null, release_date: movie.release_date || '',
            vote_average: typeof movie.vote_average === 'number' ? movie.vote_average : null,
            genre_ids: Array.isArray(movie.genre_ids) ? movie.genre_ids.slice(0, 8) : [],
            original_language: movie.original_language || ''
          }];
          writeWatchlist(next);
          const card = $(`[data-movie-id="${Number(id)}"]`);
          const saveButton = $('[data-save-movie]', card);
          if (saveButton) {
            const saved = isSaved(Number(id));
            saveButton.textContent = saved ? 'Saved' : 'Save';
            saveButton.setAttribute('aria-pressed', String(saved));
            saveButton.setAttribute('aria-label', `${saved ? 'Remove from' : 'Add to'} watchlist: ${titleOf(movie)}`);
          }
          if (detailDialog?.open && Number(state.activeMovie?.id) === Number(id)) $('[data-detail-save]').textContent = isSaved(Number(id)) ? 'Remove from watchlist' : 'Add to watchlist';
          renderWatchlist();
          showToast(exists ? 'Removed from your watchlist.' : 'Added to your watchlist.');
        }

        function renderWatchlist() {
          if (!watchlistItems) return;
          const movies = readWatchlist();
          if (!movies.length) {
            watchlistItems.innerHTML = '<p class="empty-inline">Your watchlist is empty. Save a film from the search results to keep it here.</p>';
            return;
          }
          watchlistItems.innerHTML = movies.map((movie) => {
            const poster = imageUrl(movie.poster_path);
            return `<article class="watch-item" data-watch-item="${Number(movie.id)}">${poster ? `<img src="${poster}" alt="Poster for ${escapeHtml(movie.title)}" loading="lazy" />` : '<div class="watch-poster-missing">Poster unavailable</div>'}<div class="watch-item-copy"><strong>${escapeHtml(movie.title)}</strong><span>${escapeHtml(yearOf(movie))}</span><button type="button" data-watch-details="${Number(movie.id)}">Details and availability</button></div><button class="watch-item-remove" type="button" data-remove-saved="${Number(movie.id)}" aria-label="Remove ${escapeHtml(movie.title)} from watchlist">Remove</button></article>`;
          }).join('');
        }

        function resetBrowse() {
          state.query = '';
          state.genre = 'all';
          state.page = 1;
          if (searchInput) searchInput.value = '';
          if (genreSelect) genreSelect.value = 'all';
          if (searchSummary) searchSummary.hidden = true;
          requestMovies();
        }

        async function requestAvailabilityForRegion() {
          if (!state.activeMovie) return;
          state.selectedRegion = countrySelect?.value || 'IN';
          if (providerResults) providerResults.textContent = 'Loading country availability...';
          try {
            const data = await apiRequest({ mode: 'providers', id: String(state.activeMovie.id), type: state.activeMovie.media_type === 'tv' ? 'tv' : 'movie', region: state.selectedRegion });
            renderProviders(data);
          } catch (error) {
            if (providerResults) providerResults.innerHTML = `<p class="empty-inline">${escapeHtml(error instanceof Error ? error.message : 'Provider availability could not be loaded.')}</p>`;
          }
        }

        function getConsent() {
          try { return localStorage.getItem('movieflex-storage-choice-v1'); }
          catch { return null; }
        }

        function storeEssentialChoice() {
          try { localStorage.setItem('movieflex-storage-choice-v1', 'essential-only'); }
          catch { /* The choice remains valid for this tab if storage is blocked. */ }
          const banner = $('[data-consent-banner]');
          if (banner) banner.hidden = true;
          closeDialog(consentDialog);
        }

        searchForm?.addEventListener('submit', (event) => {
          event.preventDefault();
          const query = searchInput?.value.trim() || '';
          if (!query) {
            showToast('Type a movie title to start searching.');
            searchInput?.focus();
            return;
          }
          state.query = query;
          state.genre = 'all';
          state.page = 1;
          if (genreSelect) genreSelect.value = 'all';
          requestMovies();
          $('#discover')?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        });

        $$('[data-mode]').forEach((button) => button.addEventListener('click', () => {
          state.mode = button.dataset.mode || 'trending';
          state.query = '';
          state.genre = 'all';
          state.page = 1;
          if (searchInput) searchInput.value = '';
          if (genreSelect) genreSelect.value = 'all';
          $$('[data-mode]').forEach((tab) => {
            const active = tab === button;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-pressed', String(active));
          });
          requestMovies();
        }));

        genreSelect?.addEventListener('change', () => {
          state.genre = genreSelect.value || 'all';
          state.query = '';
          state.page = 1;
          if (searchInput) searchInput.value = '';
          requestMovies();
        });

        loadMoreButton?.addEventListener('click', () => {
          if (state.page >= state.totalPages) return;
          state.page += 1;
          requestMovies({ append: true });
        });

        grid?.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const detailsButton = target?.closest('[data-open-movie]');
          const saveButton = target?.closest('[data-save-movie]');
          const clearButton = target?.closest('[data-clear-search]');
          if (detailsButton) openMovie(Number(detailsButton.getAttribute('data-open-movie')), detailsButton);
          if (saveButton) toggleSaved(Number(saveButton.getAttribute('data-save-movie')));
          if (clearButton) resetBrowse();
        });

        $$('[data-focus-search]').forEach((button) => button.addEventListener('click', () => {
          searchInput?.focus();
          $('.search-form')?.scrollIntoView({ behavior: 'auto', block: 'center' });
        }));

        $$('[data-open-watchlist]').forEach((button) => button.addEventListener('click', () => {
          renderWatchlist();
          showDialog(watchlistDialog, button);
          if (mobileNav && !mobileNav.hidden) mobileNav.hidden = true;
          mobileMenuButton?.setAttribute('aria-expanded', 'false');
        }));

        $$('[data-close-modal]').forEach((button) => button.addEventListener('click', () => closeDialog(detailDialog)));
        detailDialog?.addEventListener('close', () => {
          if (![watchlistDialog, consentDialog].some((item) => item?.open)) document.body.classList.remove('dialog-open');
        });
        watchlistDialog?.addEventListener('close', () => {
          if (![detailDialog, consentDialog].some((item) => item?.open)) document.body.classList.remove('dialog-open');
        });
        consentDialog?.addEventListener('close', () => {
          if (![detailDialog, watchlistDialog].some((item) => item?.open)) document.body.classList.remove('dialog-open');
        });

        $('[data-detail-save]')?.addEventListener('click', () => {
          if (state.activeMovie) toggleSaved(Number(state.activeMovie.id));
        });
        countrySelect?.addEventListener('change', requestAvailabilityForRegion);
        $('[data-retry]')?.addEventListener('click', () => { requestMovies(); requestGenres(); requestRegions(); });

        watchlistItems?.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const remove = target?.closest('[data-remove-saved]');
          const details = target?.closest('[data-watch-details]');
          if (remove) {
            toggleSaved(Number(remove.getAttribute('data-remove-saved')));
            renderWatchlist();
          } else if (details) {
            openMovie(Number(details.getAttribute('data-watch-details')), details);
          }
        });

        $('[data-clear-watchlist]')?.addEventListener('click', () => {
          if (!readWatchlist().length) return;
          if (!window.confirm('Clear all saved titles from this device?')) return;
          writeWatchlist([]);
          renderWatchlist();
          showToast('Watchlist cleared from this device.');
        });

        mobileMenuButton?.addEventListener('click', () => {
          const opening = mobileMenuButton.getAttribute('aria-expanded') !== 'true';
          mobileMenuButton.setAttribute('aria-expanded', String(opening));
          mobileMenuButton.setAttribute('aria-label', opening ? 'Close navigation' : 'Open navigation');
          if (mobileNav) mobileNav.hidden = !opening;
        });
        $$('.mobile-nav a').forEach((link) => link.addEventListener('click', () => {
          if (mobileNav) mobileNav.hidden = true;
          mobileMenuButton?.setAttribute('aria-expanded', 'false');
          mobileMenuButton?.setAttribute('aria-label', 'Open navigation');
        }));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            if (mobileNav && !mobileNav.hidden) mobileNav.hidden = true;
            mobileMenuButton?.setAttribute('aria-expanded', 'false');
          }
        });

        $$('[data-open-consent]').forEach((button) => button.addEventListener('click', () => showDialog(consentDialog, button)));
        $$('[data-consent-essential], [data-consent-save]').forEach((button) => button.addEventListener('click', storeEssentialChoice));

        const consentBanner = $('[data-consent-banner]');
        if (consentBanner && !getConsent()) consentBanner.hidden = false;

        railControls.forEach((button) => button.addEventListener('click', () => {
          if (!grid) return;
          const direction = Number(button.getAttribute('data-movie-scroll')) || 1;
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          grid.scrollBy({ left: direction * grid.clientWidth * 0.78, behavior: reducedMotion ? 'auto' : 'smooth' });
        }));
        grid?.addEventListener('scroll', updateRailControls, { passive: true });
        window.addEventListener('resize', updateRailControls);
        window.requestAnimationFrame(updateRailControls);

        updateWatchCounts();
        requestMovies();
        requestGenres();
        requestRegions();
      })();
    </script>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f7f8f5;
