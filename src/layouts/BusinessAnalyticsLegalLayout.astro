---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}
const { title, description, eyebrow = 'POLICY & TERMS' } = Astro.props;
const pageTitle = `${title} | Metricline`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f5" />
    <link rel="icon" type="image/svg+xml" href="/business-analytics.svg?v=2" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('metricline-theme-v1') === 'dark') document.documentElement.classList.add('theme-dark');
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#legal-content">Skip to content</a>
    <header class="legal-topbar">
      <a class="legal-brand" href="/projects/ai-business-intelligence/" aria-label="Metricline dashboard">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 36 36"><path d="M5 27.5 13.8 8h5.6l-8.8 19.5H5Z"/><path d="M16.5 27.5 25.3 8h5.6l-8.8 19.5h-5.6Z"/><circle cx="28.8" cy="27" r="2.2"/></svg></span>
        <span><strong>Metricline</strong><small>BUSINESS ANALYTICS</small></span>
      </a>
      <nav class="legal-nav" aria-label="Policy navigation">
        <a href="/projects/ai-business-intelligence/">Dashboard</a>
        <a href="/business-analytics/privacy">Privacy</a>
        <a href="/business-analytics/terms">Terms</a>
      </nav>
      <div class="legal-actions">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark theme"><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.7 8.7 0 0 1 9.8 3.5 8.8 8.8 0 1 0 20.5 14.2Z"/></svg><span data-theme-label>Toggle theme</span></button>
        <a class="back-link" href="/projects/ai-business-intelligence/">← Dashboard</a>
      </div>
    </header>
    <main id="legal-content" class="legal-main">
      <section class="legal-heading">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </section>
      <article class="legal-paper"><slot /></article>
      <nav class="legal-related" aria-label="Related policy pages">
        <a href="/business-analytics/privacy">Privacy policy</a>
        <a href="/business-analytics/terms">Terms & conditions</a>
        <a href="/business-analytics/cookies">Cookie policy</a>
        <a href="/business-analytics/privacy-settings">Privacy settings</a>
        <a href="/business-analytics/user-agreement">User agreement</a>
      </nav>
    </main>
    <footer class="legal-footer"><a href="/projects/ai-business-intelligence/">Metricline</a><span>Business analytics interface preview</span><span>Policies for this project demo</span></footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const label = document.querySelector('[data-theme-label]');
        const sync = () => {
          const dark = root.classList.contains('theme-dark');
          if (label) label.textContent = dark ? 'Light mode' : 'Dark mode';
          if (button) button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          const themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute('content', dark ? '#111916' : '#f5f7f5');
        };
        button?.addEventListener('click', () => {
          const dark = !root.classList.contains('theme-dark');
          root.classList.toggle('theme-dark', dark);
          try { localStorage.setItem('metricline-theme-v1', dark ? 'dark' : 'light'); } catch {}
          sync();
        });
        sync();
      })();
    </script>
    <style is:global>
      :root { color-scheme:light; --page:#f5f7f5; --surface:#fff; --surface-muted:#f8faf8; --ink:#182b27; --muted:#667570; --faint:#89958f; --line:#e0e7e2; --accent:#17786e; --accent-wash:#e9f4ef; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:var(--page); color:var(--ink); }
      :root.theme-dark { color-scheme:dark; --page:#111916; --surface:#17211d; --surface-muted:#1b2722; --ink:#edf4ef; --muted:#b0beb6; --faint:#84978d; --line:#304139; --accent:#5bc3a6; --accent-wash:#1e3930; }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; min-width:320px; background:var(--page); color:var(--ink); font-size:15px; line-height:1.7; } a { color:inherit; text-underline-offset:4px; } button { font:inherit; cursor:pointer; } a:focus-visible,button:focus-visible,input:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
      .skip-link { position:absolute; left:12px; top:-60px; z-index:100; padding:8px 12px; background:var(--ink); color:var(--surface); border-radius:8px; }.skip-link:focus { top:12px; }
      .legal-topbar { position:sticky; top:0; z-index:10; display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:75px; padding:12px clamp(16px,4vw,60px); border-bottom:1px solid var(--line); background:color-mix(in srgb,var(--surface) 93%,transparent); backdrop-filter:blur(14px); }
      .legal-brand { display:flex; align-items:center; gap:10px; text-decoration:none; flex:0 0 auto; }.brand-mark { display:grid; width:35px; height:35px; place-items:center; border-radius:10px; background:var(--accent); }.brand-mark svg { width:25px; height:25px; fill:#fff; }.brand-mark circle { fill:#ffc4a8; }.legal-brand span:last-child { display:grid; gap:0; }.legal-brand strong { font-size:15px; font-weight:780; letter-spacing:-.04em; line-height:1.3; }.legal-brand small { color:var(--muted); font-size:8px; font-weight:800; letter-spacing:.12em; }
      .legal-nav { display:flex; align-items:center; gap:clamp(12px,2.5vw,32px); }.legal-nav a { color:var(--muted); font-size:12px; font-weight:650; text-decoration:none; }.legal-nav a:hover,.legal-related a:hover { color:var(--accent); }
      .legal-actions { display:flex; align-items:center; gap:9px; }.theme-toggle,.back-link { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px; padding:0 11px; border:1px solid var(--line); border-radius:9px; background:var(--surface); color:var(--ink); font-size:11px; font-weight:700; text-decoration:none; white-space:nowrap; }.theme-toggle svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }.theme-moon { display:none; }.theme-dark .theme-sun { display:none; }.theme-dark .theme-moon { display:block; }.theme-toggle:hover,.back-link:hover { border-color:var(--accent); background:var(--accent-wash); }
      .legal-main { width:min(920px,calc(100% - 40px)); margin:0 auto; padding:clamp(38px,7vw,80px) 0 60px; }.legal-heading { margin:0 auto 28px; max-width:760px; text-align:center; }.eyebrow { margin:0 0 10px; color:var(--accent); font-size:10px; font-weight:800; letter-spacing:.15em; }.legal-heading h1 { margin:0; font-size:clamp(34px,5vw,52px); font-weight:760; letter-spacing:-.055em; line-height:1.12; }.legal-heading > p:last-child { max-width:620px; margin:16px auto 0; color:var(--muted); font-size:15px; }
      .legal-paper { padding:clamp(22px,4vw,42px); border:1px solid var(--line); border-radius:18px; background:var(--surface); box-shadow:0 10px 30px rgba(18,46,37,.04); }.legal-paper h2 { margin:28px 0 8px; font-size:20px; font-weight:750; letter-spacing:-.025em; line-height:1.35; }.legal-paper h2:first-child { margin-top:0; }.legal-paper h3 { margin:22px 0 7px; font-size:15px; font-weight:730; }.legal-paper p,.legal-paper li { color:var(--muted); font-size:13px; line-height:1.85; }.legal-paper p { margin:8px 0 14px; }.legal-paper ul,.legal-paper ol { padding-left:22px; }.legal-paper li { padding-left:4px; margin:5px 0; }.legal-paper strong { color:var(--ink); }.legal-paper a { color:var(--accent); }.legal-note { margin:18px 0; padding:14px 16px; border:1px solid var(--line); border-left:3px solid var(--accent); border-radius:8px; background:var(--surface-muted); color:var(--muted); font-size:12px; line-height:1.7; }
      .legal-related { display:flex; justify-content:center; flex-wrap:wrap; gap:12px 22px; margin-top:28px; }.legal-related a { color:var(--muted); font-size:11px; font-weight:680; text-decoration:none; }.legal-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px 18px; padding:19px clamp(16px,4vw,60px) 24px; border-top:1px solid var(--line); color:var(--faint); font-size:10px; }.legal-footer a { color:var(--ink); font-weight:750; text-decoration:none; }
      .settings-choice { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 0; border-top:1px solid var(--line); }.settings-choice strong { display:block; color:var(--ink); font-size:13px; }.settings-choice p { margin:4px 0 0; color:var(--muted); font-size:11px; }.choice-state { flex:0 0 auto; color:var(--muted); font-size:10px; font-weight:750; }.settings-buttons { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }.settings-buttons button { min-height:39px; padding:0 13px; border:1px solid var(--line); border-radius:9px; background:var(--surface); color:var(--ink); font-size:11px; font-weight:730; }.settings-buttons .primary { border-color:var(--accent); background:var(--accent); color:white; }.settings-buttons button:hover { border-color:var(--accent); }
      @media(max-width:760px) { .legal-topbar { min-height:64px; padding:10px 12px; gap:10px; flex-wrap:wrap; }.legal-nav { order:3; width:100%; justify-content:center; gap:22px; padding:5px 0 1px; }.legal-brand strong { font-size:14px; }.legal-actions { gap:6px; margin-left:auto; }.theme-toggle,.back-link { min-height:33px; padding:0 8px; font-size:10px; }.legal-main { width:calc(100% - 24px); padding:38px 0 40px; }.legal-heading h1 { font-size:35px; }.legal-heading > p:last-child { font-size:13px; }.legal-paper { padding:22px 18px; border-radius:14px; }.legal-paper h2 { font-size:18px; }.legal-paper p,.legal-paper li { font-size:12px; }.legal-footer { padding-inline:14px; }.legal-related { gap:12px 16px; } }
      @media(max-width:390px) { .legal-brand small { font-size:7px; }.legal-actions .theme-toggle span { display:none; }.legal-actions .theme-toggle { width:34px; padding:0; }.legal-nav { justify-content:space-between; gap:9px; }.legal-nav a { font-size:11px; } }
      @media(prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition-duration:.01ms!important; animation-duration:.01ms!important; animation-iteration-count:1!important; } }
    </style>
  </body>
</html>
